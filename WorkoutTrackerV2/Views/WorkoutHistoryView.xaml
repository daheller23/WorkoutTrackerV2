<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutHistoryView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:WorkoutHistoryViewModel"
             xmlns:model="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <converters:DaysToColorConverter x:Key="DaysToColorConverter"/>
        <converters:DaysToTextColorConverter x:Key="DaysToTextColorConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="24,16,24,24" Spacing="8">
            <Label Text="📋 Workout History"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.5"/>
            <Label Text="Review your progress"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <!-- Time Period Pills -->
        <StackLayout Grid.Row="1" Padding="20,0,20,20" Spacing="8">
            <Label Text="TIME PERIOD"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#999999"
                   CharacterSpacing="1"/>
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0"
                        BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=7}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="7"/>
                    </Border.GestureRecognizers>
                    <Label Text="7d" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=7}"
                           HorizontalOptions="Center" Padding="0,8"/>
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=14}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="14"/>
                    </Border.GestureRecognizers>
                    <Label Text="14d" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=14}"
                           HorizontalOptions="Center" Padding="0,8"/>
                </Border>
                <Border Grid.Column="2"
                        BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=30}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="30"/>
                    </Border.GestureRecognizers>
                    <Label Text="30d" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=30}"
                           HorizontalOptions="Center" Padding="0,8"/>
                </Border>
                <Border Grid.Column="3"
                        BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=60}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="60"/>
                    </Border.GestureRecognizers>
                    <Label Text="60d" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=60}"
                           HorizontalOptions="Center" Padding="0,8"/>
                </Border>
                <Border Grid.Column="4"
                        BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=90}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="90"/>
                    </Border.GestureRecognizers>
                    <Label Text="90d" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=90}"
                           HorizontalOptions="Center" Padding="0,8"/>
                </Border>
            </Grid>
        </StackLayout>

        <!-- Sessions List -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadSessionsCommand}"
                     RefreshColor="#1F77F0">
            <CollectionView ItemsSource="{Binding Sessions}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📋" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="No workouts yet"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#999999"
                               HorizontalOptions="Center"/>
                        <Label Text="Start logging workouts to see your history"
                               FontSize="12"
                               TextColor="#D0D0D0"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:WorkoutSessionDetail">
                        <StackLayout Padding="20,0,20,12">
                            <StackLayout Padding="16"
                                         BackgroundColor="#FFFFFF"
                                         Spacing="0">
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewWorkoutCommand}"
                                        CommandParameter="{Binding .}"/>
                                </StackLayout.GestureRecognizers>

                                <!-- Header Row -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,0,0,12">
                                    <StackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="{Binding Session.DayName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1F77F0"/>
                                        <Label Text="{Binding Session.Date, StringFormat='{0:MMM d, yyyy}'}"
                                               FontSize="12"
                                               TextColor="#999999"/>
                                    </StackLayout>
                                    <Button Grid.Column="1"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteSessionCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FF6B6B"
                                            TextColor="#FFFFFF"
                                            Padding="8"
                                            CornerRadius="6"
                                            BorderWidth="0"
                                            FontSize="14"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Start"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,0,0,12"/>

                                <!-- Stats Row -->
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <StackLayout Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding SetCount}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                                        <Label Text="sets" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding TotalReps}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center"/>
                                        <Label Text="reps" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding TotalWeight, StringFormat='{0:F0}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center"/>
                                        <Label Text="volume" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="#FF6B6B" HorizontalOptions="Center"/>
                                        <Label Text="duration" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                                    </StackLayout>
                                </Grid>

                            </StackLayout>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>