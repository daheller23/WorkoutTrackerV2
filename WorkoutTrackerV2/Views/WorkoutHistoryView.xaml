<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutHistoryView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:WorkoutHistoryViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>
        <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="24">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Workout History"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.5"/>
                    <Label Text="Review your progress" FontSize="14" TextColor="#737373"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="TIME PERIOD" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding SessionCountLabel}" FontSize="12" FontAttributes="Bold" TextColor="#1F77F0" VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="#F4F5F7" StrokeThickness="0" Padding="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimePeriodPillViewModel">
                                    <Border StrokeThickness="0" Padding="0" FlexLayout.Grow="1" Margin="2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                <Setter Property="Shadow">
                                                    <Setter.Value>
                                                        <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=SetTimePeriodCommand}" CommandParameter="{Binding DaysString}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#1A1A1A"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#A3A3A3"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadSessionsCommand}"
                     RefreshColor="#1F77F0">

            <CollectionView ItemsSource="{Binding GroupedSessions}" SelectionMode="None" VerticalScrollBarVisibility="Never">

                <CollectionView.Header>
                    <Grid HeightRequest="12" BackgroundColor="Transparent"/>
                </CollectionView.Header>
                <CollectionView.Footer>
                    <Grid HeightRequest="40" BackgroundColor="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📋" FontSize="56" HorizontalOptions="Center"/>
                        <Label Text="No workouts yet" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                        <Label Text="Start logging workouts to see your history" FontSize="14" TextColor="#A3A3A3" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutSessionGroup">
                        <VerticalStackLayout Padding="20,16,20,8" Spacing="12">

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="4,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=ToggleGroupCommand}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Subtitle}" FontSize="12" FontAttributes="Bold" TextColor="#D1D1D1" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <Label Grid.Column="2" FontSize="14" TextColor="#A3A3A3" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="▼"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="▶"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="16">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutSessionDetail">
                                        <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14"/>
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=ViewWorkoutCommand}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>

                                            <Grid RowDefinitions="Auto,1,Auto" RowSpacing="0">

                                                <Grid Grid.Row="0" ColumnDefinitions="6,*,Auto" ColumnSpacing="0">
                                                    <BoxView Grid.Column="0" BackgroundColor="{Binding MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding Session.DayName}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                                        <Label Text="{Binding Session.Date, Converter={StaticResource RelativeDateConverter}}" FontSize="13" FontAttributes="Bold" TextColor="#1F77F0"/>
                                                        <Label Text="{Binding Session.Notes}" FontSize="12" TextColor="#A3A3A3" LineBreakMode="TailTruncation" MaxLines="1" Margin="0,4,0,0" IsVisible="{Binding Session.Notes, Converter={StaticResource IsNotEmptyConverter}}"/>
                                                    </VerticalStackLayout>

                                                    <Button Grid.Column="2" Text="✕"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=DeleteSessionCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#FFEBEE" TextColor="#E53935"
                                                            FontSize="14" FontAttributes="Bold"
                                                            WidthRequest="34" HeightRequest="34" CornerRadius="8" Padding="0" VerticalOptions="Start" Margin="0,16,16,0"/>
                                                </Grid>

                                                <BoxView Grid.Row="1" HeightRequest="1" Color="#F4F5F7" Margin="16,0"/>

                                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Padding="16,16,16,20">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <Label Text="{Binding SetCount}" FontSize="16" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                                                        <Label Text="sets" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                        <Label Text="{Binding TotalReps}" FontSize="16" FontAttributes="Bold" TextColor="#388E3C" HorizontalOptions="Center"/>
                                                        <Label Text="reps" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                        <Label Text="{Binding TotalWeight, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" TextColor="#F57C00" HorizontalOptions="Center"/>
                                                        <Label Text="volume" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="3" Spacing="2">
                                                        <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}" FontSize="16" FontAttributes="Bold" TextColor="#E53935" HorizontalOptions="Center"/>
                                                        <Label Text="time" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>