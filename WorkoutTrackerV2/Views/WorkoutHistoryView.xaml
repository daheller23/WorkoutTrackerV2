<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutHistoryView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:WorkoutHistoryViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <ContentPage.Resources>
        <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="24">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Workout History"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                    <Label Text="Review your progress" FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                </VerticalStackLayout>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="44" Margin="0,-8,0,-4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <SearchBar Text="{Binding SearchQuery}"
                               Placeholder="Search name, notes, or muscle..."
                               BackgroundColor="Transparent"
                               CancelButtonColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"
                               VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="TIME PERIOD" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding SessionCountLabel}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" Padding="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimePeriodPillViewModel">

                                    <Grid FlexLayout.Grow="1" Margin="2">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=SetTimePeriodCommand}" CommandParameter="{Binding DaysString}"/>
                                        </Grid.GestureRecognizers>

                                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" Padding="0" IsVisible="{Binding IsSelected}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                            </Border.Shadow>
                                            <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                        </Border>

                                        <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="0" IsVisible="{Binding IsSelected, Converter={StaticResource InverseBoolConverter}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                        </Border>
                                    </Grid>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadSessionsCommand}"
                     RefreshColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}">

            <CollectionView ItemsSource="{Binding GroupedSessions}" SelectionMode="None" VerticalScrollBarVisibility="Never">

                <CollectionView.Header>
                    <Grid HeightRequest="12" BackgroundColor="Transparent"/>
                </CollectionView.Header>
                <CollectionView.Footer>
                    <Grid HeightRequest="40" BackgroundColor="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📋" FontSize="56" HorizontalOptions="Center"/>
                        <Label Text="No workouts found" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" HorizontalOptions="Center"/>
                        <Label Text="Start logging workouts or change your search filter." FontSize="14" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkoutSessionGroup">
                        <VerticalStackLayout Padding="20,16,20,8" Spacing="12">

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="4,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=ToggleGroupCommand}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Subtitle}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#666666}" VerticalOptions="Center" Margin="0,0,8,0"/>
                                <Label Grid.Column="2" FontSize="14" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="▼"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="▶"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="16">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutSessionDetail">

                                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14"/>
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=ViewWorkoutCommand}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>

                                            <Grid RowDefinitions="Auto,1,Auto" RowSpacing="0">

                                                <Grid Grid.Row="0" ColumnDefinitions="6,*,Auto" ColumnSpacing="0">
                                                    <BoxView Grid.Column="0" BackgroundColor="{Binding MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                                                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding Session.DayName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                        <Label Text="{Binding Session.Date, Converter={StaticResource RelativeDateConverter}}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"/>
                                                        <Label Text="{Binding Session.Notes}" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" LineBreakMode="TailTruncation" MaxLines="1" Margin="0,4,0,0" IsVisible="{Binding Session.Notes, Converter={StaticResource IsNotEmptyConverter}}"/>
                                                    </VerticalStackLayout>

                                                    <Button Grid.Column="2" Text="✕"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WorkoutHistoryViewModel}}, Path=DeleteSessionCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A1A1A}" TextColor="{AppThemeBinding Light=#E53935, Dark=#FF8A8A}"
                                                            FontSize="14" FontAttributes="Bold"
                                                            WidthRequest="34" HeightRequest="34" CornerRadius="8" Padding="0" VerticalOptions="Start" Margin="0,16,16,0"/>
                                                </Grid>

                                                <BoxView Grid.Row="1" HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}" Margin="16,0"/>

                                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Padding="16,16,16,20">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <Label Text="{Binding SetCount}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                                        <Label Text="sets" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                        <Label Text="{Binding TotalReps}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" HorizontalOptions="Center"/>
                                                        <Label Text="reps" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                        <Label Text="{Binding TotalWeight, StringFormat='{0:F0}'}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}" HorizontalOptions="Center"/>
                                                        <Label Text="volume" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="3" Spacing="2">
                                                        <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#E53935, Dark=#EF5350}" HorizontalOptions="Center"/>
                                                        <Label Text="time" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                </Grid>

                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>