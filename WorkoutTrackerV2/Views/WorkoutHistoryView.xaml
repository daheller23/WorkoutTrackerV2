<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutHistoryView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             Title="Workout History"
             BackgroundColor="#FAFAFA">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="24,16,24,24" Spacing="8">
            <Label Text="📋 Workout History" 
                   FontSize="36" 
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.5"/>
            <Label Text="Review your progress"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <!-- Filter Controls -->
        <StackLayout Grid.Row="1" Padding="20,0,20,20" Spacing="12">
            <Label Text="Time Period"
                   FontSize="12"
                   TextColor="#999999"
                   FontAttributes="Bold"
                   CharacterSpacing="0.3"/>
            <Picker SelectedItem="{Binding SelectedDays}"
                    BackgroundColor="#FFFFFF"
                    TextColor="#000000">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:Int32}">
                        <x:Int32>7</x:Int32>
                        <x:Int32>14</x:Int32>
                        <x:Int32>30</x:Int32>
                        <x:Int32>60</x:Int32>
                        <x:Int32>90</x:Int32>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </StackLayout>

        <!-- Sessions List -->
        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#1F77F0">
            <CollectionView ItemsSource="{Binding Sessions}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📋"
                               FontSize="48"
                               HorizontalOptions="Center"/>
                        <Label Text="No workouts yet"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#999999"
                               HorizontalOptions="Center"/>
                        <Label Text="Start logging workouts to see your history"
                               FontSize="12"
                               TextColor="#D0D0D0"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="20,0,20,12">
                            <StackLayout Padding="16"
                                         BackgroundColor="#FFFFFF"
                                         Spacing="0">

                                <!-- Header Row -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12"
                                      Padding="0,0,0,12">
                                    <StackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="{Binding Session.DayName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1F77F0"/>
                                        <Label Text="{Binding Session.Date, StringFormat='{0:MMM d, yyyy}'}"
                                               FontSize="12"
                                               TextColor="#999999"/>
                                    </StackLayout>
                                    <Button Grid.Column="1"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteSessionCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FF6B6B"
                                            TextColor="#FFFFFF"
                                            Padding="8"
                                            CornerRadius="6"
                                            BorderWidth="0"
                                            FontSize="14"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Start"/>
                                </Grid>

                                <!-- Divider -->
                                <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,0,0,12"/>

                                <!-- Stats Row -->
                                <Grid ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="12"
                                      Padding="0">

                                    <!-- Sets -->
                                    <StackLayout Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding SetCount}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1F77F0"
                                               HorizontalOptions="Center"/>
                                        <Label Text="sets"
                                               FontSize="10"
                                               TextColor="#999999"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>

                                    <!-- Reps -->
                                    <StackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding TotalReps}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#4CAF50"
                                               HorizontalOptions="Center"/>
                                        <Label Text="reps"
                                               FontSize="10"
                                               TextColor="#999999"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>

                                    <!-- Volume -->
                                    <StackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding TotalWeight, StringFormat='{0:F0}'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#FF9800"
                                               HorizontalOptions="Center"/>
                                        <Label Text="volume"
                                               FontSize="10"
                                               TextColor="#999999"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>

                                    <!-- Duration -->
                                    <StackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                                        <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#FF6B6B"
                                               HorizontalOptions="Center"/>
                                        <Label Text="duration"
                                               FontSize="10"
                                               TextColor="#999999"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>

                                </Grid>

                            </StackLayout>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>