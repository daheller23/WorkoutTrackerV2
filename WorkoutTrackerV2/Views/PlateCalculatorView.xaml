<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.PlateCalculatorView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:PlateCalculatorViewModel"
             BackgroundColor="#F8F9FA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.06" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,20,24,24" Spacing="24">

                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="#1F77F0"
                        FontSize="15" FontAttributes="Bold" Padding="0" 
                        HorizontalOptions="Start" HeightRequest="30"/>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Plate Calculator"
                           FontSize="34" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.2"/>
                    <Label Text="Calculate exactly how to load your bar"
                           FontSize="15" TextColor="#737373"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="BAR WEIGHT" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1.5"/>
                    <Border BackgroundColor="#F1F3F5" StrokeThickness="0" Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <FlexLayout BindableLayout.ItemsSource="{Binding BarChips}" JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarChipViewModel">
                                    <Border StrokeThickness="0" Padding="0,12" Margin="2" FlexLayout.Grow="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=SetBarCommand}" CommandParameter="{Binding Weight}"/>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                <Setter Property="Shadow">
                                                    <Setter.Value>
                                                        <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.08"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding Label}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#1F77F0"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#868E96"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=WeightUnit}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#74A4F7"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#ADB5BD"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,50" Spacing="28">

                <VerticalStackLayout Spacing="12">
                    <Label Text="TARGET WEIGHT" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1.5" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.05" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,24" Spacing="20">

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                <Border Grid.Column="0" BackgroundColor="#F8F9FA" StrokeThickness="1" Stroke="#E9ECEF" HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding TargetWeightText}"
                                           Keyboard="Numeric"
                                           FontSize="40" FontAttributes="Bold" TextColor="#1A1A1A"
                                           BackgroundColor="Transparent" Placeholder="0" PlaceholderColor="#CED4DA"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding CalculateCommand}" Margin="8,0"/>
                                </Border>

                                <Label Grid.Column="1" Text="{Binding WeightUnit}" FontSize="20" FontAttributes="Bold" TextColor="#ADB5BD" VerticalOptions="Center"/>

                                <Button Grid.Column="2" Text="✕"
                                        Command="{Binding ClearCommand}"
                                        BackgroundColor="#FFF5F5" TextColor="#FA5252"
                                        FontSize="16" FontAttributes="Bold" WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        Padding="0" BorderWidth="0" VerticalOptions="Center"/>
                            </Grid>

                            <Button Text="Calculate Plates"
                                    Command="{Binding CalculateCommand}"
                                    BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                                    FontAttributes="Bold" FontSize="16" CharacterSpacing="0.5"
                                    HeightRequest="56" CornerRadius="16" BorderWidth="0">
                                <Button.Shadow>
                                    <Shadow Brush="#1F77F0" Offset="0,6" Radius="12" Opacity="0.25"/>
                                </Button.Shadow>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFF5F5" StrokeThickness="1" Stroke="#FFE3E3" Margin="0,-8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Padding="16" Spacing="16">
                        <Label Text="⚠️" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Calculation Warning" FontSize="14" FontAttributes="Bold" TextColor="#E03131"/>
                            <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#F03E3E" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="12">
                    <Label Text="HOW TO LOAD THE BAR" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1.5" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="16" Opacity="0.06" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="24,28,24,24" Spacing="0">

                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="{Binding ResultMessage}" FontSize="42" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                    <Label Text="{Binding TotalPerSide, StringFormat='{0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                    <Label Text="{Binding WeightUnit}" FontSize="16" TextColor="#737373"/>
                                    <Label Text="per side" FontSize="16" TextColor="#737373"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F1F3F5" Margin="0,28,0,20"/>

                            <Label Text="ADD THESE PLATES TO EACH SIDE" FontSize="11" FontAttributes="Bold" TextColor="#ADB5BD" CharacterSpacing="1" Margin="0,0,0,16" HorizontalOptions="Center"/>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlatesPerSide}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlateViewModel">
                                        <Border BackgroundColor="#F8F9FA" StrokeThickness="0" Padding="20,16">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                                                    <Border BackgroundColor="#F0F7FF" WidthRequest="32" HeightRequest="32" StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding Count}" FontSize="14" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                    <Label Text="×" FontSize="16" FontAttributes="Bold" TextColor="#ADB5BD" VerticalOptions="Center"/>
                                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding Label}" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                                        <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=WeightUnit}" FontSize="14" TextColor="#737373" VerticalOptions="End" Margin="0,0,0,2"/>
                                                    </HorizontalStackLayout>
                                                </HorizontalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding SubtotalPerSide, StringFormat='{0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="#CED4DA" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
                        <Label Grid.Column="0" Text="AVAILABLE PLATES" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1.5" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Tap to toggle" FontSize="12" TextColor="#ADB5BD" VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,20,8,8">
                            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding AvailablePlates}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlateViewModel">
                                        <Border StrokeThickness="0" WidthRequest="64" HeightRequest="64" Margin="0,0,12,12">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="32"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=TogglePlateCommand}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="#F1F3F5"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Label}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="TextColor" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="TextColor" Value="#ADB5BD"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>