<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.PlateCalculatorView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:PlateCalculatorViewModel"
             BackgroundColor="#F4F5F7">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">
                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="#1F77F0"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Plate Calculator"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.5"/>
                    <Label Text="How to load the bar for any weight"
                           FontSize="14" TextColor="#737373"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="BAR WEIGHT" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                    <Border BackgroundColor="#F4F5F7" StrokeThickness="0" Padding="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <FlexLayout BindableLayout.ItemsSource="{Binding BarChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarChipViewModel">
                                    <Border StrokeThickness="0" Padding="0,10" Margin="2" FlexLayout.Grow="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=SetBarCommand}" CommandParameter="{Binding Weight}"/>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                <Setter Property="Shadow">
                                                    <Setter.Value>
                                                        <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding Label}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#1A1A1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#A3A3A3"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=WeightUnit}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#737373"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#C0C0C0"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <VerticalStackLayout Spacing="10">
                    <Label Text="TARGET WEIGHT" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="16,20" Spacing="16">

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="#F4F5F7" StrokeThickness="0" HeightRequest="56">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding TargetWeightText}"
                                           Keyboard="Numeric"
                                           FontSize="24" FontAttributes="Bold" TextColor="#1F77F0"
                                           BackgroundColor="Transparent" Placeholder="0" PlaceholderColor="#B0B0B0"
                                           HorizontalTextAlignment="Center" ReturnType="Done"
                                           ReturnCommand="{Binding CalculateCommand}" Margin="8,0"/>
                                </Border>

                                <Label Grid.Column="1" Text="{Binding WeightUnit}" FontSize="16" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>

                                <Button Grid.Column="2" Text="✕"
                                        Command="{Binding ClearCommand}"
                                        BackgroundColor="#F4F5F7" TextColor="#A3A3A3"
                                        FontSize="15" FontAttributes="Bold" WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                        Padding="0" BorderWidth="0" VerticalOptions="Center"/>
                            </Grid>

                            <Button Text="Calculate"
                                    Command="{Binding CalculateCommand}"
                                    BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                                    FontAttributes="Bold" FontSize="15"
                                    Padding="0,16" CornerRadius="12" BorderWidth="0">
                                <Button.Shadow>
                                    <Shadow Brush="#1F77F0" Offset="0,4" Radius="10" Opacity="0.25"/>
                                </Button.Shadow>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
                        <Label Grid.Column="0" Text="AVAILABLE PLATES" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Tap to toggle" FontSize="12" TextColor="#A3A3A3" VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="16,16,8,8">
                            <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding AvailablePlates}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlateViewModel">
                                        <Border StrokeThickness="0" Padding="18,10" Margin="0,0,8,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}, Path=TogglePlateCommand}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="#F4F5F7"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="TextColor" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="TextColor" Value="#A3A3A3"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFF4E5" StrokeThickness="0" Margin="0,-4,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Padding="16" Spacing="16">
                        <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Calculation Warning" FontSize="14" FontAttributes="Bold" TextColor="#E65100"/>
                            <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#D84315" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="10">
                    <Label Text="RESULT" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,24,20,16" Spacing="0">

                            <Label Text="{Binding ResultMessage}" FontSize="32" FontAttributes="Bold" TextColor="#1A1A1A"/>
                            <Label Margin="0,4,0,0" FontSize="14" FontAttributes="Bold" TextColor="#A3A3A3">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:F2} {1} per side">
                                        <Binding Path="TotalPerSide"/>
                                        <Binding Path="WeightUnit"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <BoxView HeightRequest="1" Color="#F4F5F7" Margin="0,20,0,16"/>

                            <Label Text="PLATES PER SIDE" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="0,0,0,12"/>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlatesPerSide}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlateViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                                            <Label Grid.Column="0" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} × {1} {2}">
                                                        <Binding Path="Count"/>
                                                        <Binding Path="Label"/>
                                                        <Binding Source="{RelativeSource AncestorType={x:Type vm:PlateCalculatorViewModel}}" Path="WeightUnit"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding SubtotalPerSide, StringFormat='{0:F2}'}" FontSize="15" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>