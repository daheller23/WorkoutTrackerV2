<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.BodyWeightView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="vm:BodyWeightViewModel"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             BackgroundColor="#F8F9FA">
    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:IsNotEmptyConverter  x:Key="IsNotEmptyConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="#F8F9FA" Padding="20,16,20,16" Spacing="20" ZIndex="1">

            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent" TextColor="#8E8E93"
                    FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <Label Text="Body Weight" FontSize="32" FontAttributes="Bold" TextColor="#1C1C1E" CharacterSpacing="-0.5"/>
                    <Label Text="Track your progress over time" FontSize="14" TextColor="#8E8E93"/>
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="+ Log" Command="{Binding ShowAddEntryCommand}"
                        BackgroundColor="#007AFF" TextColor="#FFFFFF"
                        FontSize="15" FontAttributes="Bold"
                        Padding="24,0" HeightRequest="44" CornerRadius="22" BorderWidth="0"
                        VerticalOptions="Center"/>
            </Grid>

            <Border BackgroundColor="#E5E5EA" StrokeThickness="0" Padding="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimePeriodPillViewModel">
                            <Border StrokeThickness="0" Padding="0" FlexLayout.Grow="1" Margin="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                        <Setter Property="Shadow">
                                            <Setter.Value>
                                                <Shadow Brush="#000000" Offset="0,1" Radius="2" Opacity="0.05"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BodyWeightViewModel}}, Path=SetTimePeriodCommand}" CommandParameter="{Binding DaysString}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,8">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#1C1C1E"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="#8E8E93"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,8,20,40" Spacing="24">

                <Border IsVisible="{Binding IsAddingEntry}" BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.03" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="20" Spacing="16">
                        <Label Text="NEW ENTRY" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" CharacterSpacing="1"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0" BackgroundColor="#F8F9FA" StrokeThickness="0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding NewWeight}" Placeholder="e.g. 175.5" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="#1C1C1E" FontAttributes="Bold" FontSize="16" Margin="12,0"/>
                            </Border>
                            <Label Grid.Column="1" Text="{Binding WeightUnitLabel}" FontSize="16" FontAttributes="Bold" TextColor="#8E8E93" VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#F8F9FA" StrokeThickness="0" HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding NewNotes}" Placeholder="Optional note (e.g. morning)" BackgroundColor="Transparent" TextColor="#1C1C1E" FontSize="15" Margin="12,0"/>
                        </Border>

                        <Border BackgroundColor="#F8F9FA" StrokeThickness="0" HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding NewDate}" BackgroundColor="Transparent" TextColor="#1C1C1E" Format="MMM dd, yyyy" MaximumDate="{x:Static sys:DateTime.Today}" Margin="12,0"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                            <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelAddEntryCommand}" BackgroundColor="#F8F9FA" TextColor="#FF3B30" FontAttributes="Bold" FontSize="15" Padding="0,14" CornerRadius="10"/>
                            <Button Grid.Column="1" Text="Save" Command="{Binding SaveEntryCommand}" BackgroundColor="#007AFF" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="15" Padding="0,14" CornerRadius="10"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasData, Converter={x:StaticResource InverseBoolConverter}}" Padding="20,60" Spacing="12" HorizontalOptions="Center">
                    <Label Text="No weight data yet" FontSize="20" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center"/>
                    <Label Text="Log your first weigh-in to start tracking your progress." FontSize="15" TextColor="#8E8E93" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasChart}" BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.02" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="16,20" Spacing="16">
                        <Label Text="TREND" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" CharacterSpacing="1"/>
                        <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="200"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="12">
                    <Label Text="METRICS" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.02" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*,1,*,1,*" RowDefinitions="Auto,1,Auto" RowSpacing="0" ColumnSpacing="0">

                            <BoxView Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Color="#E5E5EA" WidthRequest="1"/>
                            <BoxView Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" Color="#E5E5EA" WidthRequest="1"/>
                            <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Color="#E5E5EA" HeightRequest="1"/>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="0,16" Spacing="4" HorizontalOptions="Center">
                                <Label Text="CURRENT" FontSize="10" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                                <Label Text="{Binding CurrentWeightLabel}" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="2" Padding="0,16" Spacing="4" HorizontalOptions="Center">
                                <Label Text="STARTING" FontSize="10" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                                <Label Text="{Binding StartingWeightLabel}" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="4" Padding="0,16" Spacing="4" HorizontalOptions="Center">
                                <Label Text="CHANGE" FontSize="10" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                                <Label Text="{Binding ChangeLabel}" FontSize="18" FontAttributes="Bold" TextColor="{Binding ChangeColor}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Padding="0,16" Spacing="4" HorizontalOptions="Center">
                                <Label Text="7-DAY AVG" FontSize="10" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                                <Label Text="{Binding WeeklyAverageLabel}" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="2" Padding="0,16" Spacing="4" HorizontalOptions="Center">
                                <Label Text="LOWEST" FontSize="10" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                                <Label Text="{Binding PersonalLowLabel}" FontSize="18" FontAttributes="Bold" TextColor="#34C759" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="4" Padding="0,16" Spacing="4" HorizontalOptions="Center">
                                <Label Text="HIGHEST" FontSize="10" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center"/>
                                <Label Text="{Binding PersonalHighLabel}" FontSize="18" FontAttributes="Bold" TextColor="#FF9500" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasBmi}" BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.02" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="20,16" Spacing="4">
                        <Label Text="BODY MASS INDEX" FontSize="11" TextColor="#8E8E93" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="{Binding BmiLabel}" FontSize="32" FontAttributes="Bold" TextColor="#1C1C1E" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="16,0,0,0">
                                <Label Text="{Binding BmiCategory}" FontSize="15" FontAttributes="Bold" TextColor="#007AFF"/>
                                <Label Text="Set your height in Settings for BMI" FontSize="12" TextColor="#8E8E93" IsVisible="{Binding HasBmi, Converter={x:StaticResource InverseBoolConverter}}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="12">
                    <Label Text="HISTORY" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.02" />
                        </Border.Shadow>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:BodyWeightEntry">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="20,16">

                                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}" FontSize="15" FontAttributes="Bold" TextColor="#1C1C1E"/>
                                                <Label Text="{Binding Notes}" FontSize="13" TextColor="#8E8E93" IsVisible="{Binding Notes, Converter={x:StaticResource IsNotEmptyConverter}}"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1" FontSize="16" FontAttributes="Bold" TextColor="#1C1C1E" VerticalOptions="Center">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:F1} {1}">
                                                        <Binding Path="Weight"/>
                                                        <Binding Path="Unit"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>

                                            <Label Grid.Column="2" Text="Remove" TextColor="#FF3B30" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BodyWeightViewModel}}, Path=DeleteEntryCommand}" CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F2F2F7" Margin="20,0,0,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>