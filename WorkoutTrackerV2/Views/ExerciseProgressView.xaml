<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.ExerciseProgressView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:ExerciseProgressViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <ContentPage.Resources>
        <converters:BoolToTrendConverter x:Key="BoolToTrendConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <Grid ColumnDefinitions="8,*">

                <BoxView Grid.Column="0" BackgroundColor="{Binding MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                <VerticalStackLayout Grid.Column="1" Padding="20,16,24,20" Spacing="16">
                    <Button Text="← Back" Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent" TextColor="{Binding MuscleGroupColor}"
                            FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Exercise.ExerciseName}" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding Exercise.MuscleGroup}" FontSize="14" TextColor="{Binding MuscleGroupColor}" FontAttributes="Bold"/>
                            <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="{AppThemeBinding Light=#D1D1D1, Dark=#666666}" VerticalOptions="Center"/>
                            <Label Text="Exercise Analytics" FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="28">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4">
                            <Label Text="🏆" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding Exercise.MaxWeight, StringFormat='{0:F0}'}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                            <Label Text="Max Weight" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#19381D}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4">
                            <Label Text="📈" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding Exercise.AverageWeight, StringFormat='{0:F0}'}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" HorizontalOptions="Center"/>
                            <Label Text="Avg Weight" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#332400}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4">
                            <Label Text="🔢" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding Exercise.TotalReps}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}" HorizontalOptions="Center"/>
                            <Label Text="Total Reps" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="{AppThemeBinding Light=#FFF4F4, Dark=#3A1212}" IsVisible="{Binding IsPlateaued}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *" Padding="16" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="⚠️" FontSize="24" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="PLATEAU DETECTED" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#C62828, Dark=#FF8A8A}" CharacterSpacing="1"/>
                            <Label Text="{Binding CoachAdvice}" FontSize="13" TextColor="{AppThemeBinding Light=#C62828, Dark=#FF8A8A}" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="PERFORMANCE TREND" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20" Spacing="16">
                            <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="220"/>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}" Margin="0,8,0,0"/>
                            <Label Text="Visualizing progression of your heaviest sets." FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="STRENGTH STATUS" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1.5" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20" Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding StrengthLevel}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                    <Label Text="{Binding CurrentRatioText}" FontSize="12" TextColor="{Binding MuscleGroupColor}" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="🎖️" FontSize="32" VerticalOptions="Center"/>
                            </Grid>

                            <ProgressBar Progress="{Binding StrengthPercentage}" ProgressColor="{Binding MuscleGroupColor}" ScaleY="5" VerticalOptions="Center"/>

                            <Label Text="{Binding WeightToNextLevel}" FontSize="11" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}" HorizontalOptions="Center" FontAttributes="Italic"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="TRAINING PERCENTAGES" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1.5" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <FlexLayout BindableLayout.ItemsSource="{Binding Percentages}" Wrap="Wrap" JustifyContent="SpaceEvenly" Padding="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:WeightPercentage">
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" Margin="4" Padding="8" HeightRequest="64" WidthRequest="95" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Label}" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#ADB5BD, Dark=#999999}" HorizontalOptions="Center"/>
                                            <Label Text="{Binding Weight}" FontSize="16" FontAttributes="Bold" TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:ExerciseProgressViewModel}}, Path=MuscleGroupColor}" HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasOneRepMax}">
                    <Label Text="POWER POTENTIAL" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{Binding MuscleGroupColor}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{Binding MuscleGroupColor}" Offset="0,4" Radius="12" Opacity="0.15"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" Padding="24">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Estimated 1-Rep Max" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" Opacity="0.8" CharacterSpacing="1"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding EstimatedOneRepMax}" FontSize="44" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                    <Label Text="{Binding WeightUnitLabel}" FontSize="18" TextColor="#FFFFFF" Opacity="0.7" VerticalOptions="End" Margin="0,0,0,8"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="🔥" FontSize="56" VerticalOptions="Center" Opacity="0.3"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="RECENT LOGS" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding GroupedSets}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkoutHistoryGroup">
                                <VerticalStackLayout Spacing="8" Margin="0,0,0,16">
                                    <Label Text="{Binding DisplayDate}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" Margin="4,0,0,4"/>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:WorkoutSet">
                                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" Margin="0,0,0,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                    </Border.StrokeShape>
                                                    <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                                            <Label Text="{Binding Weight}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                            <Label Text="{Binding WeightUnit}" FontSize="12" TextColor="{AppThemeBinding Light=#ADB5BD, Dark=#999999}" VerticalOptions="End" Margin="0,0,0,1"/>
                                                        </HorizontalStackLayout>

                                                        <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E9ECEF, Dark=#333333}" Padding="12,4">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="12"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding Reps, StringFormat='{0} reps'}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:ExerciseProgressViewModel}}, Path=MuscleGroupColor}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>