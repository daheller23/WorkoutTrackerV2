<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.ExerciseProgressView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="vm:ExerciseProgressViewModel"
             BackgroundColor="#F8F9FB">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,2" Radius="10" Opacity="0.05" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,12,24,20" Spacing="16">
                <Button Text="← Back" Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="#1F77F0"
                        FontSize="15" FontAttributes="Bold" HorizontalOptions="Start" HeightRequest="36"/>

                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Exercise.ExerciseName}" FontSize="30" FontAttributes="Bold" TextColor="#1A1A1A" CharacterSpacing="-0.5"/>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding Exercise.MuscleGroup}" FontSize="13" TextColor="#737373" FontAttributes="Bold"/>
                        <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="#D1D1D1" VerticalOptions="Center"/>
                        <Label Text="Global Progress" FontSize="13" TextColor="#A3A3A3"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="28">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="MAX" FontSize="10" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" HorizontalOptions="Center"/>
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding Exercise.MaxWeight, StringFormat='{0:F0}'}" FontSize="22" FontAttributes="Bold" TextColor="#1F77F0"/>
                                <Label Text="↑" IsVisible="{Binding Exercise.IsTrending}" TextColor="#388E3C" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding WeightUnitLabel}" FontSize="10" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="AVG" FontSize="10" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" HorizontalOptions="Center"/>
                            <Label Text="{Binding Exercise.AverageWeight, StringFormat='{0:F0}'}" FontSize="22" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                            <Label Text="{Binding WeightUnitLabel}" FontSize="10" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="REPS" FontSize="10" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" HorizontalOptions="Center"/>
                            <Label Text="{Binding Exercise.TotalReps}" FontSize="22" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                            <Label Text="total" FontSize="10" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="12">
                    <Label Text="PROGRESS OVER TIME" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.03" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="16,24">
                            <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="220"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="TRAINING PERCENTAGES" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1.5" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
                        </Border.Shadow>

                        <CollectionView ItemsSource="{Binding Percentages}" HeightRequest="220" Margin="12">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeightPercentage">
                                    <Border BackgroundColor="#F8F9FA" StrokeThickness="0" HeightRequest="60">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Label}" FontSize="11" FontAttributes="Bold" TextColor="#ADB5BD" HorizontalOptions="Center"/>
                                            <Label Text="{Binding Weight}" FontSize="17" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasOneRepMax}">
                    <Label Text="STRENGTH INSIGHT" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#1F77F0" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#1F77F0" Offset="0,8" Radius="15" Opacity="0.2"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" Padding="24">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Estimated 1RM" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" Opacity="0.8" CharacterSpacing="1"/>
                                <Label Text="{Binding EstimatedOneRepMax}" FontSize="48" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label FontSize="11" TextColor="#FFFFFF" Opacity="0.7">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}Based on {0:F0} {1} × {2} reps">
                                            <Binding Path="Exercise.MaxWeight"/>
                                            <Binding Path="WeightUnitLabel"/>
                                            <Binding Path="Exercise.RepsAtMaxWeight"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="🏆" FontSize="56" VerticalOptions="Center" Opacity="0.3"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="RECENT HISTORY" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="0,8">
                            <CollectionView ItemsSource="{Binding Exercise.Sets}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutSet">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="20,16" ColumnSpacing="16">
                                            <Label Grid.Column="0" Text="{Binding CreatedDate, StringFormat='{0:MMMM d, yyyy}'}" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                            <Border Grid.Column="1" BackgroundColor="#F0F7FF" StrokeThickness="0" Padding="12,6" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Reps, StringFormat='{0} reps'}" FontSize="12" FontAttributes="Bold" TextColor="#1F77F0"/>
                                            </Border>
                                            <Label Grid.Column="2" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center" HorizontalTextAlignment="End">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Weight"/>
                                                        <Binding Path="WeightUnit"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>