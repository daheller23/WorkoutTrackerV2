<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.ExerciseProgressView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="vm:ExerciseProgressViewModel"
             BackgroundColor="#FAFAFA">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent" TextColor="#1F77F0"
                    FontSize="14" Padding="0" HorizontalOptions="Start"/>
            <Label Text="{Binding Exercise.ExerciseName}"
                   FontSize="32" FontAttributes="Bold"
                   TextColor="#1F77F0" CharacterSpacing="0.5"/>
            <Label Text="{Binding Exercise.MuscleGroup}"
                   FontSize="13" TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- ── Stats Row ──────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackLayout BackgroundColor="#F0F7FF" Padding="16,20" Spacing="6">
                        <Label Text="MAX" FontSize="10" TextColor="#1F77F0"
                               FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center"/>
                        <Label Text="{Binding Exercise.MaxWeight, StringFormat='{0:F0}'}"
                               FontSize="26" FontAttributes="Bold" TextColor="#1F77F0"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding WeightUnitLabel}" FontSize="10" TextColor="#1F77F0" HorizontalOptions="Center"/>
                    </StackLayout>
                    <StackLayout Grid.Column="1" BackgroundColor="#F1F8F1" Padding="16,20" Spacing="6">
                        <Label Text="AVG" FontSize="10" TextColor="#4CAF50"
                               FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center"/>
                        <Label Text="{Binding Exercise.AverageWeight, StringFormat='{0:F0}'}"
                               FontSize="26" FontAttributes="Bold" TextColor="#4CAF50"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding WeightUnitLabel}" FontSize="10" TextColor="#4CAF50" HorizontalOptions="Center"/>
                    </StackLayout>
                    <StackLayout Grid.Column="2" BackgroundColor="#FFF8E1" Padding="16,20" Spacing="6">
                        <Label Text="REPS" FontSize="10" TextColor="#FF9800"
                               FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center"/>
                        <Label Text="{Binding Exercise.TotalReps}"
                               FontSize="26" FontAttributes="Bold" TextColor="#FF9800"
                               HorizontalOptions="Center"/>
                        <Label Text="total" FontSize="10" TextColor="#FF9800" HorizontalOptions="Center"/>
                    </StackLayout>
                </Grid>

                <!-- ── Chart ──────────────────────────────────────────────── -->
                <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">
                    <Label Text="WEIGHT OVER TIME"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="260"/>
                </StackLayout>

                <!-- ── Estimated 1RM ─────────────────────────────────────── -->
                <StackLayout IsVisible="{Binding HasOneRepMax}"
                             BackgroundColor="#FFFFFF" Padding="16" Spacing="8">
                    <Label Text="ESTIMATED 1 REP MAX"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding EstimatedOneRepMax}"
                                   FontSize="32" FontAttributes="Bold"
                                   TextColor="#1F77F0"/>
                            <Label FontSize="11" TextColor="#999999">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}Based on {0:F0} {1} × {2} reps ({3} formula)">
                                        <Binding Path="Exercise.MaxWeight"/>
                                        <Binding Path="WeightUnitLabel"/>
                                        <Binding Path="Exercise.RepsAtMaxWeight"/>
                                        <Binding Path="FormulaLabel"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </StackLayout>
                        <Label Grid.Column="1"
                               Text="🏋️"
                               FontSize="36"
                               VerticalOptions="Center"
                               Opacity="0.3"/>
                    </Grid>
                    <Label Text="⚠️ Estimate only — always warm up properly before attempting a true max."
                           FontSize="10" TextColor="#AAAAAA" LineBreakMode="WordWrap"/>
                </StackLayout>

                <!-- ── Set History ────────────────────────────────────────── -->
                <StackLayout Spacing="12">
                    <Label Text="SET HISTORY"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <CollectionView ItemsSource="{Binding Exercise.Sets}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No sets recorded"
                                   FontSize="13" TextColor="#D0D0D0"
                                   HorizontalOptions="Center" Margin="0,20"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkoutSet">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="16"
                                      Padding="16,12"
                                      BackgroundColor="#FFFFFF"
                                      Margin="0,0,0,2">
                                    <Label Grid.Column="0"
                                           Text="{Binding CreatedDate, StringFormat='{0:MMM d, yyyy}'}"
                                           FontSize="13" TextColor="#000000" VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Reps, StringFormat='{0} reps'}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#1F77F0" VerticalOptions="Center"/>
                                    <Label Grid.Column="2"
                                           FontSize="13" TextColor="#999999" VerticalOptions="Center">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Weight"/>
                                                <Binding Path="WeightUnit"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
