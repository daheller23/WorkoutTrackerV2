<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.TemplatePickerView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             x:DataType="vm:TemplatePickerViewModel"
             x:Name="RootPage"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>

            <VerticalStackLayout Padding="24,16,24,0" Spacing="20">
                <Button Text="← Back"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Templates"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                        <Label Text="Select a template to load"
                               FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="44" Margin="0,0,0,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center"/>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search templates or folders..."
                               PlaceholderColor="{AppThemeBinding Light=#A3A3A3, Dark=#666666}" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               BackgroundColor="Transparent" FontSize="14" FontAttributes="Bold"
                               VerticalOptions="Center" ReturnType="Search"/>
                        <Button Grid.Column="2" Text="✕"
                                Command="{Binding ClearSearchCommand}"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"
                                FontSize="12" FontAttributes="Bold"
                                WidthRequest="24" HeightRequest="24" CornerRadius="12" Padding="0"
                                VerticalOptions="Center" IsVisible="{Binding HasSearchText}"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding GroupedTemplates}" IsGrouped="True" SelectionMode="None">

            <CollectionView.Header>
                <BoxView HeightRequest="12" BackgroundColor="Transparent"/>
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView HeightRequest="40" BackgroundColor="Transparent"/>
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="📋" FontSize="56" HorizontalOptions="Center"/>
                    <Label Text="No templates found" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" HorizontalOptions="Center"/>
                    <Label Text="Try adjusting your search or save a new routine from the active workout screen."
                           FontSize="14" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:TemplateFolderGroup">
                    <Grid Padding="24,16,24,12" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ToggleFolderCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="End">
                            <Label Text="▼" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                        <Setter Property="Rotation" Value="-90" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <Label Text="📁" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding FolderName}" 
                                   FontSize="12" FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" 
                                   CharacterSpacing="1" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkoutTemplate">
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" Margin="20,0,20,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.15" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="20,16" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TemplatePickerViewModel}}, Path=SelectTemplateCommand}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">
                                <Label Grid.Row="0"
                                       Text="{Binding Name}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                <Label Grid.Row="1"
                                       Text="{Binding CreatedDate, StringFormat='Created {0:MMM d, yyyy}'}"
                                       FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                            </Grid>

                            <Button Grid.Column="1" Text="📁"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TemplatePickerViewModel}}, Path=MoveTemplateCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                                    FontSize="14" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                    Padding="0" BorderWidth="0" VerticalOptions="Center"/>

                            <Button Grid.Column="2" Text="✕"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TemplatePickerViewModel}}, Path=DeleteTemplateCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A1A1A}" TextColor="{AppThemeBinding Light=#E53935, Dark=#FF8A8A}"
                                    FontSize="14" FontAttributes="Bold"
                                    WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                    Padding="0" BorderWidth="0" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>