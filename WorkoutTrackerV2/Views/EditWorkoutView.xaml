<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.EditWorkoutView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:EditWorkoutViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToChevronConverter x:Key="BoolToChevronConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">

                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Edit Workout"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                    <Label Text="Update your sets and details"
                           FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="16,20" Spacing="20">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="WORKOUT NAME" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding WorkoutName}"
                                       Placeholder="e.g. Push Day, Leg Day..."
                                       PlaceholderColor="{AppThemeBinding Light=#B0B0B0, Dark=#666666}"
                                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                       BackgroundColor="Transparent"
                                       FontSize="15" FontAttributes="Bold"
                                       Margin="12,0"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="DATE &amp; TIME" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>

                            <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="48">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <DatePicker Date="{Binding SelectedDate}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" Format="MMM dd, yyyy" Margin="12,0"/>
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="48">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout VerticalOptions="Center" Margin="12,0">
                                        <Label Text="Start" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center" Margin="0,0,8,0"/>
                                        <TimePicker Time="{Binding StartTime}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="48">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout VerticalOptions="Center" Margin="12,0">
                                        <Label Text="End" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center" Margin="0,0,8,0"/>
                                        <TimePicker Time="{Binding EndTime}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Label Text="{Binding DayName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center" Margin="0,8,0,0"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="EXERCISES" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <CollectionView ItemsSource="{Binding ExerciseGroups}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="0,20" Spacing="8" HorizontalOptions="Center">
                                <Label Text="No exercises added yet" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseGroup">

                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                                    </Border.Shadow>

                                    <VerticalStackLayout Padding="0,0,0,16" Spacing="0">

                                        <Grid ColumnDefinitions="6,*,48,Auto,Auto" ColumnSpacing="10" Padding="0,0,0,12">
                                            <BoxView Grid.Column="0" BackgroundColor="{Binding Exercise.MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,16,0,0">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                                </VerticalStackLayout.GestureRecognizers>
                                                <Label Text="{Binding Exercise.Name}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                <Label Text="{Binding Exercise.MuscleGroup}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Exercise.MuscleGroupColor}"/>
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                    Command="{Binding ToggleExpandedCommand}"
                                                    FontSize="16"
                                                    TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    Padding="0"
                                                    VerticalOptions="Center"
                                                    Margin="0,16,0,0" />

                                            <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" StrokeThickness="0" VerticalOptions="Center" Padding="10,6" Margin="0,16,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SetCountLabel}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"/>
                                            </Border>

                                            <Button Grid.Column="4" Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditWorkoutViewModel}}, Path=RemoveExerciseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{AppThemeBinding Light=#FFEAEA, Dark=#4A1A1A}" TextColor="{AppThemeBinding Light=#FF6B6B, Dark=#FF8A8A}"
                                                    FontSize="14" FontAttributes="Bold" WidthRequest="36" HeightRequest="36"
                                                    Padding="0" CornerRadius="10" BorderWidth="0"
                                                    VerticalOptions="Center" Margin="0,16,16,0"/>
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="16">

                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark=#333333}" Margin="16,0"/>

                                            <Grid ColumnDefinitions="36,*,*,70,36" ColumnSpacing="8" Margin="16,0" IsVisible="{Binding HasSets}">
                                                <Label Grid.Column="0" Text="Set"    FontSize="11" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Grid.Column="1" Text="Reps"   FontSize="11" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Grid.Column="2" Text="Weight" FontSize="11" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Grid.Column="3" Text="Unit"   FontSize="11" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Grid.Column="4" Text=""/>
                                            </Grid>

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="8" Margin="16,0">
                                                <BindableLayout.EmptyView>
                                                    <Label Text="No sets yet — tap + Add Set to get started" FontSize="13" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#666666}" HorizontalOptions="Center" Margin="0,8,0,8"/>
                                                </BindableLayout.EmptyView>
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:WorkoutSet">
                                                        <Grid ColumnDefinitions="36,*,*,70,36" ColumnSpacing="8">

                                                            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" WidthRequest="30" HeightRequest="30" VerticalOptions="Center" StrokeThickness="0">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="8"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding SetNumber}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                            </Border>

                                                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="36">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="8"/>
                                                                </Border.StrokeShape>
                                                                <Entry Text="{Binding Reps}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center"/>
                                                            </Border>

                                                            <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="36">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="8"/>
                                                                </Border.StrokeShape>
                                                                <Entry Text="{Binding Weight}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="Center"/>
                                                            </Border>

                                                            <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="36">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="8"/>
                                                                </Border.StrokeShape>
                                                                <Picker SelectedItem="{Binding WeightUnit}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" FontAttributes="Bold" FontSize="13" HorizontalTextAlignment="Center">
                                                                    <Picker.ItemsSource>
                                                                        <x:Array Type="{x:Type x:String}">
                                                                            <x:String>lbs</x:String>
                                                                            <x:String>kg</x:String>
                                                                        </x:Array>
                                                                    </Picker.ItemsSource>
                                                                </Picker>
                                                            </Border>

                                                            <Button Grid.Column="4" Text="✕" Command="{Binding DeleteCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" FontSize="15" FontAttributes="Bold" Padding="0" WidthRequest="36" HeightRequest="36" BorderWidth="0" VerticalOptions="Center"/>

                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="16,0,16,0">
                                                <Button Grid.Column="0" Text="+ Add Set"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditWorkoutViewModel}}, Path=AddSetCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                                                        FontAttributes="Bold" FontSize="14"
                                                        Padding="0,12" CornerRadius="10" BorderWidth="0"/>

                                                <Grid Grid.Column="1">
                                                    <Button Text="Copy Last"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditWorkoutViewModel}}, Path=CopyLastSetCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                                                            FontAttributes="Bold" FontSize="14"
                                                            Padding="0,12" CornerRadius="10" BorderWidth="0"
                                                            IsVisible="{Binding HasSets}"/>
                                                    <Button Text="Copy Last"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditWorkoutViewModel}}, Path=CopyLastSetCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#212121}" TextColor="{AppThemeBinding Light=#D1D5DB, Dark=#666666}"
                                                            FontAttributes="Bold" FontSize="14"
                                                            Padding="0,12" CornerRadius="10" BorderWidth="0"
                                                            IsVisible="{Binding HasSets, Converter={StaticResource InverseBoolConverter}}"/>
                                                </Grid>
                                            </Grid>

                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="+ Add Exercise"
                            Command="{Binding OpenExercisePickerCommand}"
                            BackgroundColor="{AppThemeBinding Light=#1F77F0, Dark=#1F77F0}" TextColor="#FFFFFF"
                            FontAttributes="Bold" FontSize="15"
                            Padding="0,16" CornerRadius="12" BorderWidth="0"
                            Margin="0,8,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#1F77F0" Offset="0,4" Radius="10" Opacity="0.15"/>
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>

                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Padding="16" Spacing="8">
                        <Label Text="WORKOUT NOTES" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                        <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Editor Text="{Binding Notes}"
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                    HeightRequest="100" MaxLength="500"
                                    Placeholder="How did you feel? Any notes about this session..."
                                    PlaceholderColor="{AppThemeBinding Light=#B0B0B0, Dark=#666666}"
                                    Margin="12,8"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" Padding="24,16,24,0" ColumnSpacing="16">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                        <Label Text="{Binding TotalSets}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" VerticalOptions="Center"/>
                        <Label Text="sets" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                        <Label Text="{Binding TotalVolume, StringFormat='{0:F0}'}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}" VerticalOptions="Center"/>
                        <Label Text="{Binding WeightUnitLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Padding="20">
                    <Button Grid.Column="0" Text="Cancel"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#FF6B6B, Dark=#FF8A8A}"
                            FontAttributes="Bold" FontSize="15"
                            Padding="0,14" CornerRadius="10" BorderWidth="1" BorderColor="{AppThemeBinding Light=#FFEAEA, Dark=#4A1A1A}"/>
                    <Button Grid.Column="1" Text="Save Changes"
                            Command="{Binding SaveWorkoutCommand}"
                            BackgroundColor="{AppThemeBinding Light=#1F77F0, Dark=#1F77F0}" TextColor="#FFFFFF"
                            FontAttributes="Bold" FontSize="15"
                            Padding="0,14" CornerRadius="10" BorderWidth="0">
                        <Button.Shadow>
                            <Shadow Brush="#1F77F0" Offset="0,4" Radius="8" Opacity="0.15"/>
                        </Button.Shadow>
                    </Button>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>