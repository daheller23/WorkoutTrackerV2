<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.AddWorkoutView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             x:DataType="vm:AddWorkoutViewModel"
             BackgroundColor="#FAFAFA">

    <!--
        FIX 7: MuscleGroupColorConverter removed — item template now binds to
        Exercise.MuscleGroupColor (pre-computed property from Exercise.Display.cs).
        FIX 8: CopyLastButtonColorConverter and CopyLastButtonTextColorConverter
        removed — replaced with DataTriggers on HasSets in the item template.
        No converter resources needed on this page.
    -->

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="0">

        <ScrollView Grid.Row="0">
            <StackLayout Padding="20,24" Spacing="24">

                <!-- ── Header ──────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Log Your Workout"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               CharacterSpacing="0.5"/>
                        <Label Text="Track your sets and progress"
                               FontSize="13"
                               TextColor="#999999"/>
                    </StackLayout>
                    <Button Grid.Column="1"
                            Text="⚙️"
                            Command="{Binding ViewSettingsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#1F77F0"
                            FontSize="22"
                            Padding="8"
                            VerticalOptions="Start"/>
                </Grid>

                <!-- ── Workout Name ─────────────────────────────────────────── -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Name"
                           FontSize="12" TextColor="#999999"
                           FontAttributes="Bold" CharacterSpacing="0.3"/>
                    <Entry Text="{Binding WorkoutName}"
                           BackgroundColor="#F5F5F5"
                           TextColor="#000000"
                           Placeholder="e.g. Push Day, Leg Day..."
                           PlaceholderColor="#D0D0D0"
                           FontSize="14"/>
                </StackLayout>

                <!-- ── Date & Time ──────────────────────────────────────────── -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Date &amp; Time"
                           FontSize="12" TextColor="#999999"
                           FontAttributes="Bold" CharacterSpacing="0.3"/>
                    <DatePicker Date="{Binding SelectedDate}"
                                BackgroundColor="#F5F5F5"
                                TextColor="#000000"
                                Format="MMM dd, yyyy"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Start" FontSize="11" TextColor="#999999"/>
                            <TimePicker Time="{Binding StartTime}"
                                        BackgroundColor="#F5F5F5"
                                        TextColor="#000000"/>
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="End" FontSize="11" TextColor="#999999"/>
                            <TimePicker Time="{Binding EndTime}"
                                        BackgroundColor="#F5F5F5"
                                        TextColor="#000000"/>
                        </StackLayout>
                    </Grid>
                    <Label Text="{Binding DayName}"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#1F77F0" HorizontalOptions="Center"/>
                </StackLayout>

                <!-- ── Exercise Groups ──────────────────────────────────────── -->
                <StackLayout Spacing="12">
                    <Label Text="EXERCISES"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>

                    <CollectionView ItemsSource="{Binding ExerciseGroups}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No exercises added yet"
                                   FontSize="12" TextColor="#D0D0D0"
                                   HorizontalOptions="Center" Margin="0,20"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseGroup">
                                <StackLayout Margin="0,0,0,12">
                                    <StackLayout BackgroundColor="#FFFFFF" Padding="0,0,0,12" Spacing="12">

                                        <!-- Exercise Header -->
                                        <Grid ColumnDefinitions="6,*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <BoxView Grid.Column="0"
                                                     BackgroundColor="{Binding Exercise.MuscleGroupColor}"
                                                     HorizontalOptions="Fill"
                                                     VerticalOptions="Fill"/>
                                            <StackLayout Grid.Column="1" Spacing="2"
                                                         VerticalOptions="Center" Padding="0,12,0,0">
                                                <Label Text="{Binding Exercise.Name}"
                                                       FontSize="15" FontAttributes="Bold" TextColor="#000000"/>
                                                <Label Text="{Binding Exercise.MuscleGroup}"
                                                       FontSize="11"
                                                       TextColor="{Binding Exercise.MuscleGroupColor}"/>
                                            </StackLayout>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="#F0F7FF"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center"
                                                    Padding="8,4"
                                                    Margin="0,12,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SetCountLabel}"
                                                       FontSize="11" FontAttributes="Bold" TextColor="#1F77F0"/>
                                            </Border>
                                            <!-- Unit picker — one per exercise, not per set row.
                                                 Applies WeightUnit to all sets via the first set's
                                                 binding; changing it here is rare so it lives here
                                                 instead of duplicating across every row.            -->
                                            <Picker Grid.Column="3"
                                                    SelectedItem="{Binding Sets[0].WeightUnit, FallbackValue='lbs'}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#999999"
                                                    FontSize="11"
                                                    WidthRequest="56"
                                                    VerticalOptions="Center"
                                                    Margin="0,12,0,0">
                                                <Picker.ItemsSource>
                                                    <x:Array Type="{x:Type x:String}">
                                                        <x:String>lbs</x:String>
                                                        <x:String>kg</x:String>
                                                    </x:Array>
                                                </Picker.ItemsSource>
                                            </Picker>
                                            <Button Grid.Column="4"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=RemoveExerciseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FF6B6B"
                                                    TextColor="#FFFFFF"
                                                    FontSize="13"
                                                    WidthRequest="36" HeightRequest="36"
                                                    Padding="0" CornerRadius="6" BorderWidth="0"
                                                    VerticalOptions="Center" Margin="0,12,8,0"/>
                                        </Grid>

                                        <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="16,0"/>

                                        <!-- Last Session Row — fetched async after exercise is added.
                                             Hidden until HasLastSession becomes true.
                                             Sits above the table header so the column labels
                                             remain directly above their input fields.          -->
                                        <StackLayout IsVisible="{Binding HasLastSession}"
                                                     Margin="16,0,16,4"
                                                     Spacing="4">
                                            <Label Text="{Binding LastSessionSummary}"
                                                   FontSize="10" FontAttributes="Bold"
                                                   TextColor="#999999" CharacterSpacing="0.5"/>
                                            <FlexLayout Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Center"
                                                        BindableLayout.ItemsSource="{Binding LastSessionChips}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border BackgroundColor="#F0F7FF"
                                                                StrokeThickness="0"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding .}"
                                                                   FontSize="11"
                                                                   TextColor="#1F77F0"
                                                                   FontAttributes="Bold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                        </StackLayout>

                                        <!-- Set completion progress bar -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="16,4,16,0"
                                              IsVisible="{Binding HasSets}">
                                            <ProgressBar Grid.Column="0"
                                                         Progress="{Binding CompletionProgress}"
                                                         ProgressColor="#4CAF50"
                                                         VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   FontSize="11" TextColor="#999999"
                                                   Margin="6,0,0,0" VerticalOptions="Center">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}">
                                                        <Binding Path="CompletedSets"/>
                                                        <Binding Path="TotalSetCount"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Grid>

                                        <!-- Table Header — 5 columns: ✓ | Set | Reps | Weight | actions -->
                                        <Grid ColumnDefinitions="36,28,*,*,72" ColumnSpacing="8"
                                              Margin="16,4,16,0" IsVisible="{Binding HasSets}">
                                            <Label Grid.Column="0" Text=""       FontSize="11"/>
                                            <Label Grid.Column="1" Text="Set"    FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="Reps"   FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="3" Text="Weight" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="4" Text=""       FontSize="11"/>
                                        </Grid>

                                        <!-- Set Rows
                                             Layout: ✓ checkbox | Set# badge | Reps | Weight+unit
                                             Tapping ✓ = IsCompleted flip + auto-start rest timer.
                                             Completed rows tint green; badge turns solid green.
                                             Unit Picker lives below Weight entry — compact, rarely used.
                                             Delete via swipe or DeleteCommand (long-hold).            -->
                                        <StackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                                     Spacing="4" Margin="16,0">
                                            <BindableLayout.EmptyView>
                                                <Label Text="No sets yet — tap + Add Set to get started"
                                                       FontSize="11" TextColor="#D0D0D0"
                                                       HorizontalOptions="Center" Margin="0,4,0,4"/>
                                            </BindableLayout.EmptyView>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:WorkoutSet">
                                                    <Grid ColumnDefinitions="36,28,*,*,72" ColumnSpacing="8"
                                                          BackgroundColor="{Binding RowBackground}"
                                                          Padding="0,4">

                                                        <!-- ✓ Checkbox — tap to complete + auto-start rest timer -->
                                                        <Border Grid.Column="0"
                                                                WidthRequest="32" HeightRequest="32"
                                                                VerticalOptions="Center"
                                                                StrokeThickness="1.5">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8"/>
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding ToggleCompletedCommand}"
                                                                    CommandParameter="{Binding ParentGroup.Exercise.MuscleGroup}"/>
                                                            </Border.GestureRecognizers>
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="#4CAF50"/>
                                                                    <Setter Property="Stroke" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Border"
                                                                             Binding="{Binding IsCompleted}" Value="False">
                                                                    <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                                    <Setter Property="Stroke" Value="#D0D0D0"/>
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Label Text="{Binding CheckmarkText}"
                                                                   FontSize="16" FontAttributes="Bold"
                                                                   TextColor="#FFFFFF"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Set number badge — turns green when completed -->
                                                        <Border Grid.Column="1"
                                                                BackgroundColor="{Binding NumberBackground}"
                                                                WidthRequest="28" HeightRequest="28"
                                                                VerticalOptions="Center" StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding SetNumber}"
                                                                   FontSize="12" FontAttributes="Bold"
                                                                   TextColor="{Binding NumberColor}"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Reps entry -->
                                                        <Entry Grid.Column="2"
                                                               Text="{Binding Reps}"
                                                               Keyboard="Numeric"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#1F77F0"
                                                               FontSize="14"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalOptions="Center"/>

                                                        <!-- Weight entry — unit is set once at exercise header -->
                                                        <Entry Grid.Column="3"
                                                               Text="{Binding Weight}"
                                                               Keyboard="Numeric"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#1F77F0"
                                                               FontSize="14"
                                                               HorizontalTextAlignment="Center"
                                                               Placeholder="{Binding SuggestedWeightPlaceholder}"
                                                               PlaceholderColor="#BBBBBB"
                                                               VerticalOptions="Center"/>

                                                        <!-- ⏱ rest timer + ✕ delete — manual timer, no auto-fire -->
                                                        <StackLayout Grid.Column="4" Orientation="Horizontal"
                                                                     Spacing="2" VerticalOptions="Center">
                                                            <Button Text="⏱"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=StartRestTimerCommand}"
                                                                    CommandParameter="{Binding Exercise.MuscleGroup}"
                                                                    BackgroundColor="#F0F7FF"
                                                                    TextColor="#1F77F0"
                                                                    FontSize="14" Padding="0"
                                                                    WidthRequest="34" HeightRequest="34"
                                                                    BorderWidth="0" VerticalOptions="Center"/>
                                                            <Button Text="✕"
                                                                    Command="{Binding DeleteCommand}"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="#FF6B6B"
                                                                    FontSize="14" Padding="4,0"
                                                                    WidthRequest="36" HeightRequest="44"
                                                                    BorderWidth="0" VerticalOptions="Center"/>
                                                        </StackLayout>

                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>

                                        <!-- Add Set / Copy Last Set
                                             FIX 8: CopyLastButtonColorConverter and
                                             CopyLastButtonTextColorConverter replaced with
                                             DataTriggers on HasSets — zero converter calls
                                             per render of this button pair.               -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="16,0">
                                            <Button Grid.Column="0"
                                                    Text="+ Add Set"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=AddSetCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F0F7FF"
                                                    TextColor="#1F77F0"
                                                    FontAttributes="Bold" FontSize="13"
                                                    Padding="0,10" CornerRadius="8" BorderWidth="0"/>
                                            <Button Grid.Column="1"
                                                    Text="Copy Last"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=CopyLastSetCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontAttributes="Bold" FontSize="13"
                                                    Padding="0,10" CornerRadius="8" BorderWidth="0">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding HasSets}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#F0F7FF"/>
                                                        <Setter Property="TextColor"       Value="#1F77F0"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding HasSets}" Value="False">
                                                        <Setter Property="BackgroundColor" Value="#F5F5F5"/>
                                                        <Setter Property="TextColor"       Value="#CCCCCC"/>
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>

                                    </StackLayout>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="+ Add Exercise"
                            Command="{Binding ViewExercisePickerCommand}"
                            BackgroundColor="#1F77F0"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold" FontSize="14"
                            Padding="0,14" CornerRadius="10" BorderWidth="0"/>
                </StackLayout>

                <!-- ── Notes ───────────────────────────────────────────────── -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Notes"
                           FontSize="12" TextColor="#999999"
                           FontAttributes="Bold" CharacterSpacing="0.3"/>
                    <Editor Text="{Binding Notes}"
                            BackgroundColor="#F5F5F5"
                            TextColor="#000000"
                            HeightRequest="80"
                            MaxLength="500"
                            Placeholder="How did you feel? Any notes about this session..."
                            PlaceholderColor="#D0D0D0"/>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════════════════════════════
             DOCKED PANEL — everything below this line is fixed to the bottom.
             The strong top border + slightly darker background (#F2F4F7) makes
             it read as a separate surface the page scrolls behind.
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Hairline above timer bar — only visible when timer is active -->
        <BoxView Grid.Row="1"
                 HeightRequest="1"
                 Color="#000000"
                 Opacity="0.06"
                 IsVisible="{Binding TimerViewModel.IsVisible}"/>

        <!-- ── Rest Timer Bar (active state only) ────────────────────────── -->
        <StackLayout Grid.Row="2"
                     IsVisible="{Binding TimerViewModel.IsVisible}"
                     BackgroundColor="#EEF4FF"
                     Padding="20,10,20,10"
                     Spacing="8">

            <!-- Countdown + progress + controls -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="{Binding TimerViewModel.RemainingLabel}"
                       FontSize="26" FontAttributes="Bold"
                       MinimumWidthRequest="64"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding TimerViewModel.IsFinished}" Value="True">
                            <Setter Property="TextColor" Value="#4CAF50"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding TimerViewModel.IsFinished}" Value="False">
                            <Setter Property="TextColor" Value="#1F77F0"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <ProgressBar Grid.Column="1"
                             Progress="{Binding TimerViewModel.Progress}"
                             ProgressColor="#1F77F0"
                             VerticalOptions="Center"
                             Margin="0,0,4,0"/>
                <Button Grid.Column="2"
                        Text="+30"
                        Command="{Binding TimerViewModel.AddThirtyCommand}"
                        BackgroundColor="#FFFFFF" TextColor="#1F77F0"
                        FontSize="12" FontAttributes="Bold"
                        WidthRequest="52" HeightRequest="36"
                        Padding="0" CornerRadius="8" BorderWidth="0"
                        VerticalOptions="Center"/>
                <Button Grid.Column="3"
                        Text="✕"
                        Command="{Binding TimerViewModel.StopCommand}"
                        BackgroundColor="Transparent" TextColor="#FF6B6B"
                        FontSize="16"
                        WidthRequest="36" HeightRequest="36"
                        Padding="0" BorderWidth="0"
                        VerticalOptions="Center"/>
            </Grid>

            <!-- Quick preset chips -->
            <StackLayout Orientation="Horizontal" Spacing="8">
                <Label Text="Quick:"
                       FontSize="11" TextColor="#5A8FCC"
                       VerticalOptions="Center"/>
                <Button Text="1 min"
                        Command="{Binding TimerViewModel.StartPresetCommand}"
                        CommandParameter="60"
                        BackgroundColor="#FFFFFF" TextColor="#1F77F0"
                        FontSize="11" Padding="12,4"
                        CornerRadius="12" BorderWidth="0"/>
                <Button Text="90s"
                        Command="{Binding TimerViewModel.StartPresetCommand}"
                        CommandParameter="90"
                        BackgroundColor="#FFFFFF" TextColor="#1F77F0"
                        FontSize="11" Padding="12,4"
                        CornerRadius="12" BorderWidth="0"/>
                <Button Text="2 min"
                        Command="{Binding TimerViewModel.StartPresetCommand}"
                        CommandParameter="120"
                        BackgroundColor="#FFFFFF" TextColor="#1F77F0"
                        FontSize="11" Padding="12,4"
                        CornerRadius="12" BorderWidth="0"/>
                <Button Text="3 min"
                        Command="{Binding TimerViewModel.StartPresetCommand}"
                        CommandParameter="180"
                        BackgroundColor="#FFFFFF" TextColor="#1F77F0"
                        FontSize="11" Padding="12,4"
                        CornerRadius="12" BorderWidth="0"/>
            </StackLayout>

        </StackLayout>

        <!-- ── Action Buttons ──────────────────────────────────────────────── -->
        <Grid Grid.Row="3"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="0"
              BackgroundColor="#F4F5F7">

            <!-- Hairline separator — subtle elevation cue, not a hard border -->
            <BoxView Grid.Row="0"
                     HeightRequest="1"
                     Color="#000000"
                     Opacity="0.06"/>

            <!-- Sets / Volume counter -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*"
                  Padding="20,14,20,10" ColumnSpacing="12">
                <StackLayout Grid.Column="0"
                             Orientation="Horizontal" Spacing="6"
                             HorizontalOptions="Center">
                    <Label Text="{Binding TotalSets}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#1F77F0" VerticalOptions="Center"/>
                    <Label Text="sets"
                           FontSize="12" TextColor="#888888"
                           VerticalOptions="Center"/>
                </StackLayout>
                <StackLayout Grid.Column="1"
                             Orientation="Horizontal" Spacing="6"
                             HorizontalOptions="Center">
                    <Label Text="{Binding TotalVolume, StringFormat='{0:F0}'}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#4CAF50" VerticalOptions="Center"/>
                    <Label Text="{Binding WeightUnitLabel}"
                           FontSize="12" TextColor="#888888"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Grid>

            <!-- Template Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*"
                  ColumnSpacing="12" Padding="20,0,20,10">
                <Button Grid.Column="0"
                        Text="📋 Load Template"
                        Command="{Binding OpenTemplatePickerCommand}"
                        BackgroundColor="#FFFFFF" TextColor="#1F77F0"
                        FontAttributes="Bold" FontSize="13"
                        Padding="0,10" CornerRadius="8" BorderWidth="0"/>
                <Button Grid.Column="1"
                        Text="💾 Save as Template"
                        Command="{Binding SaveAsTemplateCommand}"
                        BackgroundColor="#FFFFFF" TextColor="#4CAF50"
                        FontAttributes="Bold" FontSize="13"
                        Padding="0,10" CornerRadius="8" BorderWidth="0"/>
            </Grid>

            <!-- Save / Clear -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*"
                  ColumnSpacing="16" Padding="20,0,20,20">
                <Button Grid.Column="0"
                        Text="Clear"
                        Command="{Binding ClearCommand}"
                        BackgroundColor="Transparent" TextColor="#FF6B6B"
                        FontAttributes="Bold" FontSize="14"
                        Padding="0,14" CornerRadius="10"
                        BorderWidth="1" BorderColor="#FF6B6B"/>
                <Button Grid.Column="1"
                        Text="Save Workout"
                        Command="{Binding SaveWorkoutCommand}"
                        BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                        FontAttributes="Bold" FontSize="14"
                        Padding="0,14" CornerRadius="10" BorderWidth="0"/>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>
