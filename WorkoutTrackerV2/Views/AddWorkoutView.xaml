<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.AddWorkoutView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:AddWorkoutViewModel"
             BackgroundColor="#FAFAFA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <ContentPage.Resources>
        <converters:MuscleGroupColorConverter x:Key="MuscleGroupColorConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" RowSpacing="0">

        <ScrollView Grid.Row="0">
            <StackLayout Padding="20,24" Spacing="24">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Log Your Workout"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               CharacterSpacing="0.5"/>
                        <Label Text="Track your sets and progress"
                               FontSize="13"
                               TextColor="#999999"/>
                    </StackLayout>
                    <Button Grid.Column="1"
                            Text="⚙️"
                            Command="{Binding ViewSettingsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#1F77F0"
                            FontSize="22"
                            Padding="8"
                            VerticalOptions="Start"/>
                </Grid>

                <!-- Workout Name -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Name"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <Entry Text="{Binding WorkoutName}"
                           BackgroundColor="#F5F5F5"
                           TextColor="#000000"
                           Placeholder="e.g. Push Day, Leg Day..."
                           PlaceholderColor="#D0D0D0"
                           FontSize="14"/>
                </StackLayout>

                <!-- Date & Time -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Date &amp; Time"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <DatePicker Date="{Binding SelectedDate}"
                                BackgroundColor="#F5F5F5"
                                TextColor="#000000"
                                Format="MMM dd, yyyy"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Start" FontSize="11" TextColor="#999999"/>
                            <TimePicker Time="{Binding StartTime}"
                                        BackgroundColor="#F5F5F5"
                                        TextColor="#000000"/>
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="End" FontSize="11" TextColor="#999999"/>
                            <TimePicker Time="{Binding EndTime}"
                                        BackgroundColor="#F5F5F5"
                                        TextColor="#000000"/>
                        </StackLayout>
                    </Grid>
                    <Label Text="{Binding DayName}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F77F0"
                           HorizontalOptions="Center"/>
                </StackLayout>

                <!-- Exercise Groups -->
                <StackLayout Spacing="12">
                    <Label Text="EXERCISES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>

                    <CollectionView ItemsSource="{Binding ExerciseGroups}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No exercises added yet"
                                   FontSize="12"
                                   TextColor="#D0D0D0"
                                   HorizontalOptions="Center"
                                   Margin="0,20"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseGroup">
                                <StackLayout Margin="0,0,0,12">
                                    <StackLayout BackgroundColor="#FFFFFF" Padding="0,0,0,12" Spacing="12">

                                        <!-- Muscle Group Color Bar + Exercise Header -->
                                        <Grid ColumnDefinitions="6,*,Auto,Auto" ColumnSpacing="12">
                                            <!-- Color Bar -->
                                            <BoxView Grid.Column="0"
                                                     BackgroundColor="{Binding Exercise.MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"
                                                     HorizontalOptions="Fill"
                                                     VerticalOptions="Fill"/>
                                            <!-- Exercise Info -->
                                            <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,12,0,0">
                                                <Label Text="{Binding Exercise.Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#000000"/>
                                                <Label Text="{Binding Exercise.MuscleGroup}"
                                                       FontSize="11"
                                                       TextColor="{Binding Exercise.MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"/>
                                            </StackLayout>
                                            <!-- Set Count Badge -->
                                            <Border Grid.Column="2"
                                                    BackgroundColor="#F0F7FF"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center"
                                                    Padding="8,4"
                                                    Margin="0,12,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SetCountLabel}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F77F0"/>
                                            </Border>
                                            <!-- Remove Button -->
                                            <Button Grid.Column="3"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=RemoveExerciseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FF6B6B"
                                                    TextColor="#FFFFFF"
                                                    FontSize="13"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    CornerRadius="6"
                                                    BorderWidth="0"
                                                    VerticalOptions="Center"
                                                    Margin="0,12,12,0"/>
                                        </Grid>

                                        <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="16,0"/>

                                        <!-- Table Header -->
                                        <Grid ColumnDefinitions="30,*,*,80,36" ColumnSpacing="8" Margin="16,0">
                                            <Label Grid.Column="0" Text="Set" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Reps" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="Weight" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="3" Text="Unit" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="4" Text=""/>
                                        </Grid>

                                        <!-- Sets Rows -->
                                        <StackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6" Margin="16,0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:WorkoutSet">
                                                    <Grid ColumnDefinitions="30,*,*,80,36" ColumnSpacing="8">
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="#F0F7FF"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                VerticalOptions="Center"
                                                                StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding SetNumber}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1F77F0"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>
                                                        <Entry Grid.Column="1"
                                                               Text="{Binding Reps}"
                                                               Keyboard="Numeric"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#1F77F0"
                                                               FontSize="13"
                                                               HorizontalTextAlignment="Center"/>
                                                        <Entry Grid.Column="2"
                                                               Text="{Binding Weight}"
                                                               Keyboard="Numeric"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#1F77F0"
                                                               FontSize="13"
                                                               HorizontalTextAlignment="Center"/>
                                                        <Picker Grid.Column="3"
                                                                SelectedItem="{Binding WeightUnit}"
                                                                BackgroundColor="#F5F5F5"
                                                                TextColor="#1F77F0"
                                                                FontSize="13">
                                                            <Picker.ItemsSource>
                                                                <x:Array Type="{x:Type x:String}">
                                                                    <x:String>lbs</x:String>
                                                                    <x:String>kg</x:String>
                                                                </x:Array>
                                                            </Picker.ItemsSource>
                                                        </Picker>
                                                        <Button Grid.Column="4"
                                                                Text="✕"
                                                                Command="{Binding DeleteCommand}"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#FF6B6B"
                                                                FontSize="14"
                                                                Padding="0"
                                                                WidthRequest="36"
                                                                HeightRequest="36"
                                                                BorderWidth="0"
                                                                VerticalOptions="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>

                                        <!-- Add Set Button -->
                                        <Button Text="+ Add Set"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=AddSetCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F0F7FF"
                                                TextColor="#1F77F0"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Padding="0,10"
                                                CornerRadius="8"
                                                BorderWidth="0"
                                                Margin="16,0"/>

                                    </StackLayout>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add Exercise Button -->
                    <Button Text="+ Add Exercise"
                            Command="{Binding ViewExercisePickerCommand}"
                            BackgroundColor="#1F77F0"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="14"
                            Padding="0,14"
                            CornerRadius="10"
                            BorderWidth="0"/>
                </StackLayout>

                <!-- Notes -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Notes"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <Editor Text="{Binding Notes}"
                            BackgroundColor="#F5F5F5"
                            TextColor="#000000"
                            HeightRequest="80"
                            Placeholder="How did you feel? Any notes about this session..."
                            PlaceholderColor="#D0D0D0"/>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="0" BackgroundColor="#FFFFFF">

            <!-- Live Volume Counter -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" Padding="20,12,20,0" ColumnSpacing="12">
                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalOptions="Center">
                    <Label Text="{Binding TotalSets}"
                           FontSize="16" FontAttributes="Bold" TextColor="#1F77F0" VerticalOptions="Center"/>
                    <Label Text="sets" FontSize="12" TextColor="#999999" VerticalOptions="Center"/>
                </StackLayout>
                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalOptions="Center">
                    <Label Text="{Binding TotalVolume, StringFormat='{0:F0}'}"
                           FontSize="16" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center"/>
                    <Label Text="lbs total" FontSize="12" TextColor="#999999" VerticalOptions="Center"/>
                </StackLayout>
            </Grid>

            <!-- Template Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="20,8,20,0">
                <Button Grid.Column="0"
                        Text="📋 Load Template"
                        Command="{Binding OpenTemplatePickerCommand}"
                        BackgroundColor="#F0F7FF"
                        TextColor="#1F77F0"
                        FontAttributes="Bold"
                        FontSize="13"
                        Padding="0,10"
                        CornerRadius="8"
                        BorderWidth="0"/>
                <Button Grid.Column="1"
                        Text="💾 Save as Template"
                        Command="{Binding SaveAsTemplateCommand}"
                        BackgroundColor="#F1F8F1"
                        TextColor="#4CAF50"
                        FontAttributes="Bold"
                        FontSize="13"
                        Padding="0,10"
                        CornerRadius="8"
                        BorderWidth="0"/>
            </Grid>

            <!-- Save / Clear -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16" Padding="20" RowSpacing="0">
                <Button Grid.Column="0"
                        Text="Clear"
                        Command="{Binding ClearCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#FF6B6B"
                        FontAttributes="Bold"
                        FontSize="14"
                        Padding="0,14"
                        CornerRadius="10"
                        BorderWidth="1"
                        BorderColor="#FF6B6B"/>
                <Button Grid.Column="1"
                        Text="Save Workout"
                        Command="{Binding SaveWorkoutCommand}"
                        BackgroundColor="#1F77F0"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        Padding="0,14"
                        CornerRadius="10"
                        BorderWidth="0"/>
            </Grid>

        </Grid>

    </Grid>
</ContentPage>