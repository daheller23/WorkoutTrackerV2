<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.AddWorkoutView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             x:DataType="vm:AddWorkoutViewModel"
             BackgroundColor="#FAFAFA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="*,Auto" RowSpacing="0">

        <ScrollView Grid.Row="0">
            <StackLayout Padding="20,24" Spacing="24">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Log Your Workout"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               CharacterSpacing="0.5"/>
                        <Label Text="Track your sets and progress"
                               FontSize="13"
                               TextColor="#999999"/>
                    </StackLayout>
                    <Button Grid.Column="1"
                            Text="⚙️"
                            Command="{Binding OpenSettingsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#1F77F0"
                            FontSize="22"
                            Padding="0"
                            VerticalOptions="Start"/>
                </Grid>

                <!-- Workout Name -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Name"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <Entry Text="{Binding WorkoutName}"
                           BackgroundColor="#F5F5F5"
                           TextColor="#000000"
                           Placeholder="e.g. Push Day, Leg Day..."
                           PlaceholderColor="#D0D0D0"
                           FontSize="14"/>
                </StackLayout>

                <!-- Date & Day Selection -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Date"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <DatePicker Date="{Binding SelectedDate}"
                                BackgroundColor="#F5F5F5"
                                TextColor="#000000"
                                Format="MMM dd, yyyy"/>
                    <Label Text="{Binding DayName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F77F0"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </StackLayout>

                <!-- Time Selection -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                        <Label Text="Start Time" FontSize="12" TextColor="#999999" FontAttributes="Bold" CharacterSpacing="0.3"/>
                        <TimePicker Time="{Binding StartTime}" BackgroundColor="#F5F5F5" TextColor="#000000"/>
                    </StackLayout>
                    <StackLayout Grid.Column="1" Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                        <Label Text="End Time" FontSize="12" TextColor="#999999" FontAttributes="Bold" CharacterSpacing="0.3"/>
                        <TimePicker Time="{Binding EndTime}" BackgroundColor="#F5F5F5" TextColor="#000000"/>
                    </StackLayout>
                </Grid>

                <!-- Notes -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Workout Notes"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <Editor Text="{Binding Notes}"
                            BackgroundColor="#F5F5F5"
                            TextColor="#000000"
                            HeightRequest="80"/>
                </StackLayout>

                <!-- Exercise Groups -->
                <StackLayout Spacing="12">
                    <Label Text="EXERCISES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>

                    <CollectionView ItemsSource="{Binding ExerciseGroups}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No exercises added yet"
                                   FontSize="12"
                                   TextColor="#D0D0D0"
                                   HorizontalOptions="Center"
                                   Margin="0,20"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseGroup">
                                <StackLayout Margin="0,0,0,12">
                                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">

                                        <!-- Exercise Header -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Exercise.Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#000000"/>
                                                <Label Text="{Binding Exercise.MuscleGroup}"
                                                       FontSize="11"
                                                       TextColor="#999999"/>
                                            </StackLayout>
                                            <Button Grid.Column="1"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=RemoveExerciseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FF6B6B"
                                                    TextColor="#FFFFFF"
                                                    FontSize="13"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    CornerRadius="6"
                                                    BorderWidth="0"
                                                    VerticalOptions="Center"/>
                                        </Grid>

                                        <BoxView HeightRequest="0.5" Color="#F0F0F0"/>

                                        <!-- Table Header -->
                                        <Grid ColumnDefinitions="30,*,*,80,36" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="Set" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Reps" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="Weight" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="3" Text="Unit" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="4" Text="" FontSize="11" TextColor="#999999"/>
                                        </Grid>

                                        <!-- Sets Rows -->
                                        <StackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:WorkoutSet">
                                                    <Grid ColumnDefinitions="30,*,*,80,36" ColumnSpacing="8" RowSpacing="0">

                                                        <!-- Set Number -->
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="#F0F7FF"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                VerticalOptions="Center"
                                                                StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding SetNumber}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1F77F0"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Reps -->
                                                        <Entry Grid.Column="1"
                                                               Text="{Binding Reps}"
                                                               Keyboard="Numeric"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#1F77F0"
                                                               FontSize="13"
                                                               HorizontalTextAlignment="Center"/>

                                                        <!-- Weight -->
                                                        <Entry Grid.Column="2"
                                                               Text="{Binding Weight}"
                                                               Keyboard="Numeric"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#1F77F0"
                                                               FontSize="13"
                                                               HorizontalTextAlignment="Center"/>

                                                        <!-- Unit Picker -->
                                                        <Picker Grid.Column="3"
                                                                SelectedItem="{Binding WeightUnit}"
                                                                BackgroundColor="#F5F5F5"
                                                                TextColor="#1F77F0"
                                                                FontSize="13">
                                                            <Picker.ItemsSource>
                                                                <x:Array Type="{x:Type x:String}">
                                                                    <x:String>lbs</x:String>
                                                                    <x:String>kg</x:String>
                                                                </x:Array>
                                                            </Picker.ItemsSource>
                                                        </Picker>

                                                        <!-- Delete Set -->
                                                        <Button Grid.Column="4"
                                                            Text="✕"
                                                            Command="{Binding DeleteCommand}"
                                                            BackgroundColor="Transparent"
                                                            TextColor="#FF6B6B"
                                                            FontSize="14"
                                                            Padding="0"
                                                            WidthRequest="36"
                                                            HeightRequest="36"
                                                            BorderWidth="0"
                                                            VerticalOptions="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>

                                        <!-- Add Set Button -->
                                        <Button Text="+ Add Set"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddWorkoutViewModel}}, Path=AddSetCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F0F7FF"
                                                TextColor="#1F77F0"
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                Padding="0,10"
                                                CornerRadius="8"
                                                BorderWidth="0"/>

                                    </StackLayout>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Add Exercise Button -->
                    <Button Text="+ Add Exercise"
                            Command="{Binding ViewExercisePickerCommand}"
                            BackgroundColor="#1F77F0"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="14"
                            Padding="0,14"
                            CornerRadius="10"
                            BorderWidth="0"/>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" Padding="20" RowSpacing="0" BackgroundColor="#FFFFFF">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#FF6B6B"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="0,14"
                    CornerRadius="10"
                    BorderWidth="1"
                    BorderColor="#FF6B6B"/>
            <Button Grid.Column="1"
                    Text="Save Workout"
                    Command="{Binding SaveWorkoutCommand}"
                    BackgroundColor="#1F77F0"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="0,14"
                    CornerRadius="10"
                    BorderWidth="0"/>
        </Grid>

    </Grid>
</ContentPage>