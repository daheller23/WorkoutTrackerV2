<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.OneRepMaxCalculatorView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:OneRepMaxCalculatorViewModel"
             BackgroundColor="#FAFAFA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── Header ───────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF"
                     Padding="24,16,24,24" Spacing="4">
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent" TextColor="#1F77F0"
                    FontSize="14" Padding="0" HorizontalOptions="Start"/>
            <Label Text="🏆 1RM Calculator"
                   FontSize="32" FontAttributes="Bold"
                   TextColor="#1F77F0" CharacterSpacing="0.5"/>
            <Label Text="Estimate your one-rep max"
                   FontSize="13" TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- ── Inputs ────────────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="YOUR SET"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="14">

                        <!-- Weight row -->
                        <StackLayout Spacing="6">
                            <Label Text="Weight lifted"
                                   FontSize="12" TextColor="#999999"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0"
                                       Text="{Binding WeightText}"
                                       Keyboard="Numeric"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="#1F77F0"
                                       BackgroundColor="#F5F5F5"
                                       Placeholder="0"
                                       PlaceholderColor="#DDDDDD"
                                       HorizontalTextAlignment="Center"
                                       ReturnType="Next"/>
                                <Label Grid.Column="1"
                                       Text="{Binding WeightUnit}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="#BBBBBB"
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="2"
                                        Text="✕"
                                        Command="{Binding ClearCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#CCCCCC"
                                        FontSize="16" Padding="16,0"
                                        BorderWidth="0"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </StackLayout>

                        <!-- Reps row -->
                        <StackLayout Spacing="6">
                            <Label Text="Reps completed"
                                   FontSize="12" TextColor="#999999"/>
                            <Entry Text="{Binding RepsText}"
                                   Keyboard="Numeric"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="#1F77F0"
                                   BackgroundColor="#F5F5F5"
                                   Placeholder="0"
                                   PlaceholderColor="#DDDDDD"
                                   HorizontalTextAlignment="Center"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding CalculateCommand}"/>
                        </StackLayout>

                        <Button Text="Calculate"
                                Command="{Binding CalculateCommand}"
                                BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,14" CornerRadius="10" BorderWidth="0"/>
                    </StackLayout>
                </StackLayout>

                <!-- ── Formula selector ──────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="FORMULA"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <Border BackgroundColor="#F5F5F5" StrokeThickness="0" Padding="4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <StackLayout Orientation="Horizontal" Spacing="4"
                                     BindableLayout.ItemsSource="{Binding FormulaChips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:FormulaChipViewModel">
                                    <Border StrokeThickness="0"
                                            Padding="0,10"
                                            HorizontalOptions="FillAndExpand">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OneRepMaxCalculatorViewModel}}, Path=SetFormulaCommand}"
                                                CommandParameter="{Binding Key}"/>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <StackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Label}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#111111"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#AAAAAA"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="10"
                                                   HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#999999"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#CCCCCC"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </Border>
                </StackLayout>

                <!-- ── Result ────────────────────────────────────────────── -->
                <StackLayout IsVisible="{Binding HasResult}" Spacing="10">

                    <Label Text="RESULT"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>

                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="0">

                        <!-- 1RM headline -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="3">
                                <Label FontSize="28" FontAttributes="Bold" TextColor="#1F77F0">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:F1} {1}">
                                            <Binding Path="OneRepMax"/>
                                            <Binding Path="WeightUnit"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label FontSize="12" TextColor="#999999">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Est. 1RM via {0} formula">
                                            <Binding Path="FormulaLabel"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </StackLayout>
                            <Label Grid.Column="1"
                                   Text="🏆" FontSize="32"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="0,16"/>

                        <!-- Rep percentage table header -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,0,0,8">
                            <Label Grid.Column="0"
                                   Text="%"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#BBBBBB" CharacterSpacing="1"
                                   WidthRequest="48"/>
                            <Label Grid.Column="1"
                                   Text="WEIGHT"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#BBBBBB" CharacterSpacing="1"/>
                            <Label Grid.Column="2"
                                   Text="REPS"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#BBBBBB" CharacterSpacing="1"/>
                        </Grid>

                        <!-- Rep percentage rows -->
                        <StackLayout BindableLayout.ItemsSource="{Binding RepTable}"
                                     Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RepPercentageRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,11">
                                        <!-- Percentage — bold blue on 100% row -->
                                        <Label Grid.Column="0"
                                               Text="{Binding PercentageLabel}"
                                               WidthRequest="48"
                                               FontSize="14" FontAttributes="Bold"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsMax}" Value="True">
                                                    <Setter Property="TextColor" Value="#1F77F0"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsMax}" Value="False">
                                                    <Setter Property="TextColor" Value="#111111"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <!-- Weight -->
                                        <Label Grid.Column="1"
                                               Text="{Binding WeightLabel}"
                                               FontSize="14"
                                               TextColor="#111111"
                                               VerticalOptions="Center"/>
                                        <!-- Estimated reps -->
                                        <Label Grid.Column="2"
                                               Text="{Binding RepsLabel}"
                                               FontSize="13" TextColor="#999999"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                    </StackLayout>

                    <!-- Note about accuracy -->
                    <Label Text="Results are estimates. Accuracy is best at 3–6 reps and decreases above 10."
                           FontSize="11" TextColor="#BBBBBB"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"/>

                </StackLayout>

                <Label Text=" " Margin="0,8"/>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
