<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.OneRepMaxCalculatorView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:OneRepMaxCalculatorViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">
                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>
                <VerticalStackLayout Spacing="2">
                    <Label Text="1RM Calculator"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                    <Label Text="Estimate your one-rep max"
                           FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <VerticalStackLayout Spacing="10">
                    <Label Text="YOUR SET" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="16,20" Spacing="20">

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Weight lifted" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="48">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding WeightText}"
                                               Keyboard="Numeric"
                                               FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                               BackgroundColor="Transparent" Placeholder="0" PlaceholderColor="{AppThemeBinding Light=#B0B0B0, Dark=#666666}"
                                               HorizontalTextAlignment="Center" ReturnType="Next" Margin="8,0"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding WeightUnit}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center"/>
                                    <Button Grid.Column="2" Text="✕"
                                            Command="{Binding ClearCommand}"
                                            BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#333333}" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"
                                            FontSize="14" FontAttributes="Bold"
                                            WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                            Padding="0" BorderWidth="0" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Reps completed" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="48">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding RepsText}"
                                           Keyboard="Numeric"
                                           FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                           BackgroundColor="Transparent" Placeholder="0" PlaceholderColor="{AppThemeBinding Light=#B0B0B0, Dark=#666666}"
                                           HorizontalTextAlignment="Center" ReturnType="Done"
                                           ReturnCommand="{Binding CalculateCommand}" Margin="8,0"/>
                                </Border>
                            </VerticalStackLayout>

                            <Button Text="Calculate"
                                    Command="{Binding CalculateCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#1F77F0, Dark=#1F77F0}" TextColor="#FFFFFF"
                                    FontAttributes="Bold" FontSize="15"
                                    Padding="0,16" CornerRadius="12" BorderWidth="0" Margin="0,4,0,0">
                                <Button.Shadow>
                                    <Shadow Brush="#1F77F0" Offset="0,4" Radius="10" Opacity="0.15"/>
                                </Button.Shadow>
                            </Button>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="FORMULA" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="16">

                            <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" Padding="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <FlexLayout BindableLayout.ItemsSource="{Binding FormulaChips}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FormulaChipViewModel">

                                            <Grid FlexLayout.Grow="1" Margin="2">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OneRepMaxCalculatorViewModel}}, Path=SetFormulaCommand}" CommandParameter="{Binding Key}"/>
                                                </Grid.GestureRecognizers>

                                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" Padding="0,10" IsVisible="{Binding IsSelected}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <Border.Shadow>
                                                        <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                                    </Border.Shadow>
                                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                        <Label Text="{Binding Subtitle}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="0,10" IsVisible="{Binding IsSelected, Converter={StaticResource InverseBoolConverter}}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                                        <Label Text="{Binding Subtitle}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#C0C0C0, Dark=#666666}"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>

                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="10">
                    <Label Text="RESULT" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,24,20,16" Spacing="0">

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label FontSize="36" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0:F1} {1}">
                                                <Binding Path="OneRepMax"/>
                                                <Binding Path="WeightUnit"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="Est. 1RM via {0} formula">
                                                <Binding Path="FormulaLabel"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="🏆" FontSize="42" VerticalOptions="Center" Opacity="0.2"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}" Margin="0,0,0,16"/>

                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,0,0,12">
                                <Label Grid.Column="0" Text="%" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" WidthRequest="48"/>
                                <Label Grid.Column="1" Text="WEIGHT" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                                <Label Grid.Column="2" Text="REPS" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding RepTable}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RepPercentageRow">
                                        <Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,12" IsVisible="{Binding IsMax}">
                                                <Label Grid.Column="0" Text="{Binding PercentageLabel}" WidthRequest="48" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"/>
                                                <Label Grid.Column="1" Text="{Binding WeightLabel}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding RepsLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}" VerticalOptions="Center"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,12" IsVisible="{Binding IsMax, Converter={StaticResource InverseBoolConverter}}">
                                                <Label Grid.Column="0" Text="{Binding PercentageLabel}" WidthRequest="48" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                <Label Grid.Column="1" Text="{Binding WeightLabel}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding RepsLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}" VerticalOptions="Center"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Results are estimates. Accuracy is best at 3–6 reps and decreases significantly above 10."
                           FontSize="11" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,12,0,0"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>