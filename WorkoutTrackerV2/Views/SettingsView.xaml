<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.SettingsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">
                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Settings"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                    <Label Text="Customize your experience"
                           FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <VerticalStackLayout Spacing="10">
                    <Label Text="PREFERENCES" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="Default Weight Unit" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" Padding="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,*">

                                        <Grid Grid.Column="0" Margin="2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetWeightUnitCommand}" CommandParameter="lbs"/>
                                            </Grid.GestureRecognizers>

                                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" IsVisible="{Binding IsLbsSelected}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                                </Border.Shadow>
                                                <Label Text="lbs" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" Padding="0,10"/>
                                            </Border>

                                            <Border BackgroundColor="Transparent" StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsLbsSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="lbs" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" Padding="0,10"/>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetWeightUnitCommand}" CommandParameter="kg"/>
                                            </Grid.GestureRecognizers>

                                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" IsVisible="{Binding IsKgSelected}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                                </Border.Shadow>
                                                <Label Text="kg" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" Padding="0,10"/>
                                            </Border>

                                            <Border BackgroundColor="Transparent" StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsKgSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="kg" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" Padding="0,10"/>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}"/>

                            <Grid ColumnDefinitions="*,Auto" Padding="20,16">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Dark Mode" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                    <Label Text="Switch between light and dark theme" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#B3B3B3}"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode}" OnColor="#1F77F0" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}"/>

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="1RM Formula" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" Padding="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,*">

                                        <Grid Grid.Column="0" Margin="2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetRmFormulaCommand}" CommandParameter="Epley"/>
                                            </Grid.GestureRecognizers>

                                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" IsVisible="{Binding IsEpleySelected}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                                </Border.Shadow>
                                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                                    <Label Text="Epley" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                    <Label Text="w × (1 + r/30)" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border BackgroundColor="Transparent" StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsEpleySelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                                    <Label Text="Epley" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                                    <Label Text="w × (1 + r/30)" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="2">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetRmFormulaCommand}" CommandParameter="Brzycki"/>
                                            </Grid.GestureRecognizers>

                                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" IsVisible="{Binding IsBrzyckiSelected}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                                </Border.Shadow>
                                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                                    <Label Text="Brzycki" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                    <Label Text="w × 36/(37−r)" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border BackgroundColor="Transparent" StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,8">
                                                    <Label Text="Brzycki" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                                    <Label Text="w × 36/(37−r)" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}"/>

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="Height" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="44">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding HeightCm}"
                                               Placeholder="e.g. 178" Keyboard="Numeric"
                                               BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                               FontSize="15" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="cm" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#B3B3B3}" VerticalOptions="Center"/>
                                    <Button Grid.Column="2" Text="Save"
                                            Command="{Binding SaveHeightCommand}"
                                            BackgroundColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}"
                                            FontAttributes="Bold" FontSize="13" WidthRequest="70"
                                            Padding="0" CornerRadius="10" BorderWidth="0"/>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="Bodyweight" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" HeightRequest="44">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding BodyWeight}"
                                               Placeholder="e.g. 185" Keyboard="Numeric"
                                               BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                               FontSize="15" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding WeightUnit}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#B3B3B3}" VerticalOptions="Center"/>
                                    <Button Grid.Column="2" Text="Save"
                                            Command="{Binding SaveBodyWeightCommand}"
                                            BackgroundColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}"
                                            FontAttributes="Bold" FontSize="13" WidthRequest="70"
                                            Padding="0" CornerRadius="10" BorderWidth="0"/>
                                </Grid>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="NOTIFICATIONS" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,16" Spacing="12">
                            <Label Text="Rest Timer Background Alerts" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                            <Label Text="Android battery optimization may block rest timer alerts when your screen is off. Disable it to ensure timers always sound."
                                   FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}" LineBreakMode="WordWrap"/>
                            <Button Text="Fix Timer Alerts"
                                    Command="{Binding RequestBatteryExemptionCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                                    FontAttributes="Bold" FontSize="14"
                                    Padding="0,12" CornerRadius="10" BorderWidth="0" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="ABOUT" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" Padding="20,16">
                            <Label Grid.Column="0" Text="App Version" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding AppVersion}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="DANGER ZONE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#E53935, Dark=#EF5350}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,16" Spacing="12">
                            <Label Text="Clear All Data" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#E53935, Dark=#EF5350}"/>
                            <Label Text="Permanently delete all workouts, sets, and history. This action cannot be undone."
                                   FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}" LineBreakMode="WordWrap"/>
                            <Button Text="Erase Everything"
                                    Command="{Binding ClearAllDataCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A1A1A}" TextColor="{AppThemeBinding Light=#E53935, Dark=#FF8A8A}"
                                    FontAttributes="Bold" FontSize="14"
                                    Padding="0,12" CornerRadius="10" BorderWidth="0" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>