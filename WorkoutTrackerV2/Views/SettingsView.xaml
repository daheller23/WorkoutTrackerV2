<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.SettingsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="#FAFAFA">

    <!--
        FIX 5: WeightUnitColorConverter and WeightUnitTextColorConverter removed —
                replaced with DataTriggers on IsLbsSelected / IsKgSelected.
        FIX 7: Shell.NavBarIsVisible=False added — without this the page shows
                both the Shell back button AND the custom ← Back button in the
                header, which every other page in the app already hides.
        No converter resources needed on this page.
    -->

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent" TextColor="#1F77F0"
                    FontSize="14" Padding="0" HorizontalOptions="Start"/>
            <Label Text="⚙️ Settings"
                   FontSize="32" FontAttributes="Bold"
                   TextColor="#1F77F0" CharacterSpacing="0.5"/>
            <Label Text="Customize your experience"
                   FontSize="13" TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="24">

                <!-- ── Preferences ────────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="PREFERENCES"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>

                    <!-- Weight Unit
                         FIX 5: DataTriggers on IsLbsSelected / IsKgSelected replace
                         WeightUnitColorConverter and WeightUnitTextColorConverter.
                         4 converter calls per tap → 0.                            -->
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">
                        <Label Text="Default Weight Unit"
                               FontSize="12" TextColor="#999999"
                               FontAttributes="Bold" CharacterSpacing="0.3"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsLbsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsLbsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeightUnitCommand}" CommandParameter="lbs"/>
                                </Border.GestureRecognizers>
                                <Label Text="lbs"
                                       FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" Padding="0,12">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsLbsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#FFFFFF"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsLbsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="#666666"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsKgSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsKgSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetWeightUnitCommand}" CommandParameter="kg"/>
                                </Border.GestureRecognizers>
                                <Label Text="kg"
                                       FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" Padding="0,12">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsKgSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#FFFFFF"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsKgSelected}" Value="False">
                                            <Setter Property="TextColor" Value="#666666"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </StackLayout>

                    <!-- Dark Mode -->
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label Text="Dark Mode"
                                       FontSize="15" FontAttributes="Bold" TextColor="#000000"/>
                                <Label Text="Switch between light and dark theme"
                                       FontSize="11" TextColor="#999999"/>
                            </StackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsDarkMode}"
                                    OnColor="#1F77F0"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </StackLayout>
                    <!-- 1RM Formula -->
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">
                        <Label Text="1RM Formula"
                               FontSize="12" TextColor="#999999"
                               FontAttributes="Bold" CharacterSpacing="0.3"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEpleySelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsEpleySelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetRmFormulaCommand}" CommandParameter="Epley"/>
                                </Border.GestureRecognizers>
                                <StackLayout Padding="12,10" Spacing="2">
                                    <Label Text="Epley" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="False">
                                                <Setter Property="TextColor" Value="#666666"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="w × (1 + r/30)" FontSize="10" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="True">
                                                <Setter Property="TextColor" Value="#CCDDFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="False">
                                                <Setter Property="TextColor" Value="#999999"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </StackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsBrzyckiSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetRmFormulaCommand}" CommandParameter="Brzycki"/>
                                </Border.GestureRecognizers>
                                <StackLayout Padding="12,10" Spacing="2">
                                    <Label Text="Brzycki" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="False">
                                                <Setter Property="TextColor" Value="#666666"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="w × 36/(37−r)" FontSize="10" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#CCDDFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="False">
                                                <Setter Property="TextColor" Value="#999999"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </StackLayout>

                    <!-- Height (for BMI in body weight tracker) -->
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">
                        <Label Text="Height (for BMI)"
                               FontSize="12" TextColor="#999999"
                               FontAttributes="Bold" CharacterSpacing="0.3"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Entry Grid.Column="0"
                                   Text="{Binding HeightCm}"
                                   Placeholder="e.g. 178"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F5F5F5"
                                   TextColor="#000000"
                                   FontSize="14"/>
                            <Label Grid.Column="1"
                                   Text="cm"
                                   FontSize="14" TextColor="#999999"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Button Text="Save Height"
                                Command="{Binding SaveHeightCommand}"
                                BackgroundColor="#F0F7FF" TextColor="#1F77F0"
                                FontAttributes="Bold" FontSize="13"
                                Padding="0,10" CornerRadius="8" BorderWidth="0"/>
                    </StackLayout>
                </StackLayout>

                <!-- ── Notifications ─────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="NOTIFICATIONS"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="8">
                        <Label Text="Rest Timer Background Alerts"
                               FontSize="15" FontAttributes="Bold" TextColor="#000000"/>
                        <Label Text="On some Android devices, battery optimisation blocks notifications when the screen is off. Tap below to disable it for this app so the rest timer alert always fires."
                               FontSize="12" TextColor="#999999" LineBreakMode="WordWrap"/>
                        <Button Text="Disable Battery Optimisation"
                                Command="{Binding RequestBatteryExemptionCommand}"
                                BackgroundColor="#F0F7FF" TextColor="#1F77F0"
                                FontAttributes="Bold" FontSize="13"
                                Padding="0,10" CornerRadius="8" BorderWidth="0"
                                Margin="0,4,0,0"/>
                    </StackLayout>
                </StackLayout>

                <!-- ── About ──────────────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="ABOUT"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="App Version"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="#000000" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   FontSize="13" TextColor="#999999"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </StackLayout>
                </StackLayout>

                <!-- ── Danger Zone ────────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="DANGER ZONE"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#FF6B6B" CharacterSpacing="1"/>
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="8">
                        <Label Text="Clear All Data"
                               FontSize="15" FontAttributes="Bold" TextColor="#FF6B6B"/>
                        <Label Text="Permanently delete all workouts, sets and history. This cannot be undone."
                               FontSize="12" TextColor="#999999" LineBreakMode="WordWrap"/>
                        <Button Text="Clear All Data"
                                Command="{Binding ClearAllDataCommand}"
                                BackgroundColor="#FF6B6B" TextColor="#FFFFFF"
                                FontAttributes="Bold" FontSize="14"
                                Padding="0,12" CornerRadius="8" BorderWidth="0"
                                Margin="0,4,0,0"/>
                    </StackLayout>
                </StackLayout>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
