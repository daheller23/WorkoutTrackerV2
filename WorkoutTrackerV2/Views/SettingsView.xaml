<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.SettingsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="#F4F5F7">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">
                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="#1F77F0"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Settings"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.5"/>
                    <Label Text="Customize your experience"
                           FontSize="14" TextColor="#737373"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <VerticalStackLayout Spacing="10">
                    <Label Text="PREFERENCES" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="Default Weight Unit" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                <Border BackgroundColor="#F4F5F7" StrokeThickness="0" Padding="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,*">
                                        <Border Grid.Column="0" StrokeThickness="0" Padding="0,10" Margin="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetWeightUnitCommand}" CommandParameter="lbs"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsLbsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                    <Setter Property="Shadow">
                                                        <Setter.Value>
                                                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsLbsSelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="lbs" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsLbsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#1A1A1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsLbsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#A3A3A3"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <Border Grid.Column="1" StrokeThickness="0" Padding="0,10" Margin="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetWeightUnitCommand}" CommandParameter="kg"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsKgSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                    <Setter Property="Shadow">
                                                        <Setter.Value>
                                                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsKgSelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="kg" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsKgSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#1A1A1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsKgSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#A3A3A3"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F4F5F7"/>

                            <Grid ColumnDefinitions="*,Auto" Padding="20,16">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Dark Mode" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                    <Label Text="Switch between light and dark theme" FontSize="12" TextColor="#A3A3A3"/>
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsDarkMode}" OnColor="#1F77F0" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F4F5F7"/>

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="1RM Formula" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                <Border BackgroundColor="#F4F5F7" StrokeThickness="0" Padding="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,*">
                                        <Border Grid.Column="0" StrokeThickness="0" Padding="0,8" Margin="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetRmFormulaCommand}" CommandParameter="Epley"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEpleySelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                    <Setter Property="Shadow">
                                                        <Setter.Value>
                                                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsEpleySelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="Epley" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#1A1A1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="False">
                                                            <Setter Property="TextColor" Value="#A3A3A3"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="w × (1 + r/30)" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#737373"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsEpleySelected}" Value="False">
                                                            <Setter Property="TextColor" Value="#C0C0C0"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Column="1" StrokeThickness="0" Padding="0,8" Margin="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SetRmFormulaCommand}" CommandParameter="Brzycki"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                    <Setter Property="Shadow">
                                                        <Setter.Value>
                                                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsBrzyckiSelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="Brzycki" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#1A1A1A"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="False">
                                                            <Setter Property="TextColor" Value="#A3A3A3"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="w × 36/(37−r)" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#737373"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsBrzyckiSelected}" Value="False">
                                                            <Setter Property="TextColor" Value="#C0C0C0"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F4F5F7"/>

                            <VerticalStackLayout Padding="20,16" Spacing="12">
                                <Label Text="Height (for BMI tracking)" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="#F4F5F7" StrokeThickness="0" HeightRequest="44">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding HeightCm}"
                                               Placeholder="e.g. 178" Keyboard="Numeric"
                                               BackgroundColor="Transparent" TextColor="#1A1A1A"
                                               FontSize="15" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="cm" FontSize="15" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                                    <Button Grid.Column="2" Text="Save"
                                            Command="{Binding SaveHeightCommand}"
                                            BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                                            FontAttributes="Bold" FontSize="13" WidthRequest="70"
                                            Padding="0" CornerRadius="10" BorderWidth="0"/>
                                </Grid>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="NOTIFICATIONS" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,16" Spacing="12">
                            <Label Text="Rest Timer Background Alerts" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                            <Label Text="Android battery optimization may block rest timer alerts when your screen is off. Disable it to ensure timers always sound."
                                   FontSize="13" TextColor="#737373" LineBreakMode="WordWrap"/>
                            <Button Text="Fix Timer Alerts"
                                    Command="{Binding RequestBatteryExemptionCommand}"
                                    BackgroundColor="#F0F7FF" TextColor="#1F77F0"
                                    FontAttributes="Bold" FontSize="14"
                                    Padding="0,12" CornerRadius="10" BorderWidth="0" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="ABOUT" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" Padding="20,16">
                            <Label Grid.Column="0" Text="App Version" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding AppVersion}" FontSize="15" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="DANGER ZONE" FontSize="12" FontAttributes="Bold" TextColor="#E53935" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,16" Spacing="12">
                            <Label Text="Clear All Data" FontSize="15" FontAttributes="Bold" TextColor="#E53935"/>
                            <Label Text="Permanently delete all workouts, sets, and history. This action cannot be undone."
                                   FontSize="13" TextColor="#737373" LineBreakMode="WordWrap"/>
                            <Button Text="Erase Everything"
                                    Command="{Binding ClearAllDataCommand}"
                                    BackgroundColor="#FFEBEE" TextColor="#E53935"
                                    FontAttributes="Bold" FontSize="14"
                                    Padding="0,12" CornerRadius="10" BorderWidth="0" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>