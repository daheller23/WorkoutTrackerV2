<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.ExercisePickerView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:ExercisePickerViewModel"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="0,16,0,16" Spacing="16">

                <VerticalStackLayout Padding="24,0" Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="← Back"
                                Command="{Binding CancelCommand}"
                                BackgroundColor="Transparent" TextColor="#1F77F0"
                                FontSize="15" FontAttributes="Bold" Padding="0" HeightRequest="30" VerticalOptions="Center"/>

                        <Button Grid.Column="2" Text="+ New"
                                Command="{Binding CreateExerciseCommand}"
                                BackgroundColor="#F0F7FF" TextColor="#1F77F0"
                                FontSize="13" FontAttributes="Bold"
                                Padding="16,0" HeightRequest="32" CornerRadius="16" BorderWidth="0" VerticalOptions="Center"/>
                    </Grid>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Select Exercise" FontSize="32" FontAttributes="Bold" TextColor="#1A1A1A" CharacterSpacing="0.3"/>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="Tap an exercise to add it" FontSize="14" TextColor="#737373" VerticalOptions="Center"/>
                            <Label Text="·" FontSize="14" TextColor="#D1D1D1" VerticalOptions="Center"/>
                            <Label Text="{Binding ExerciseCountLabel}" FontSize="14" TextColor="#1F77F0" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Padding="24,0">
                    <Border BackgroundColor="#F4F5F7" StrokeThickness="0" HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center"/>
                            <Entry Grid.Column="1"
                                   Text="{Binding SearchText}"
                                   Placeholder="Search by name or muscle group..."
                                   PlaceholderColor="#A3A3A3" TextColor="#1A1A1A"
                                   BackgroundColor="Transparent" FontSize="14" FontAttributes="Bold"
                                   VerticalOptions="Center" ReturnType="Search"/>
                            <Button Grid.Column="2" Text="✕"
                                    Command="{Binding ClearSearchCommand}"
                                    BackgroundColor="#E0E0E0" TextColor="#737373"
                                    FontSize="12" FontAttributes="Bold"
                                    WidthRequest="24" HeightRequest="24" CornerRadius="12" Padding="0"
                                    VerticalOptions="Center" IsVisible="{Binding HasSearchText}"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Padding="24,4,24,8" Spacing="8" BindableLayout.ItemsSource="{Binding FilterPills}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MuscleGroupPillViewModel">
                                <Border StrokeThickness="0" Padding="16,8" HeightRequest="36">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#F4F5F7"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=FilterByMuscleGroupCommand}" CommandParameter="{Binding Key}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#737373"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding SubLabel}" FontSize="11" FontAttributes="Bold" Opacity="0.8" VerticalOptions="Center" IsVisible="{Binding HasSubLabel}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#A3A3A3"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ExerciseSource}"
                        IsGrouped="{Binding IsGrouped}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="🔍" FontSize="56" HorizontalOptions="Center"/>
                    <Label Text="No exercises found" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                    <Label Text="Try a different search or create a custom movement." FontSize="14" TextColor="#A3A3A3" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Button Text="+ Create Exercise"
                            Command="{Binding CreateExerciseCommand}"
                            BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                            FontAttributes="Bold" FontSize="14"
                            Padding="24,14" CornerRadius="12" BorderWidth="0"
                            HorizontalOptions="Center" Margin="0,12,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#1F77F0" Offset="0,4" Radius="8" Opacity="0.25"/>
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:AlphaExerciseGroup">
                    <Label Text="{Binding Letter}"
                           FontSize="13" FontAttributes="Bold" TextColor="#A3A3A3"
                           CharacterSpacing="1"
                           BackgroundColor="Transparent"
                           Padding="24,20,24,8"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Margin="20,0,20,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="6,*,Auto,Auto" ColumnSpacing="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=SelectExerciseCommand}" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <BoxView Grid.Column="0" BackgroundColor="{Binding MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" Padding="16,16,8,16" RowSpacing="4" VerticalOptions="Center">
                                <Label Grid.Row="0" Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                    <Label Grid.Column="0" Text="{Binding MuscleGroupEmoji}" FontSize="12" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding MuscleGroup}" FontSize="12" FontAttributes="Bold" TextColor="{Binding MuscleGroupColor}" VerticalOptions="Center"/>

                                    <Border Grid.Column="2" BackgroundColor="#FFF8E1" StrokeThickness="0" Padding="6,2" VerticalOptions="Center" IsVisible="{Binding IsCustom}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label Text="⭐ Custom" FontSize="10" FontAttributes="Bold" TextColor="#FFB74D"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Button Grid.Column="2" Text="✕"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=DeleteExerciseCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#FFEAEA" TextColor="#FF6B6B"
                                    FontSize="14" FontAttributes="Bold" WidthRequest="32" HeightRequest="32"
                                    Padding="0" CornerRadius="8" BorderWidth="0"
                                    VerticalOptions="Center" Margin="0,0,12,0"/>

                            <Label Grid.Column="3" Text="+" FontSize="24" FontAttributes="Bold" TextColor="#1F77F0" VerticalOptions="Center" Padding="0,0,20,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>