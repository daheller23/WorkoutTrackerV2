<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.ExercisePickerView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:ExercisePickerViewModel"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <converters:MuscleGroupColorConverter x:Key="MuscleGroupColorConverter"/>
        <converters:MuscleGroupEmojiConverter x:Key="MuscleGroupEmojiConverter"/>
        <converters:MuscleGroupFilterColorConverter x:Key="MuscleGroupFilterColorConverter"/>
        <converters:MuscleGroupFilterTextColorConverter x:Key="MuscleGroupFilterTextColorConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,20" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="← Back"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1F77F0"
                        FontSize="14"
                        Padding="0"/>
                <Button Grid.Column="2"
                        Text="+ New"
                        Command="{Binding CreateExerciseCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1F77F0"
                        FontSize="13"
                        FontAttributes="Bold"
                        Padding="10,8"
                        CornerRadius="20"
                        BorderWidth="1"
                        BorderColor="#1F77F0"/>
            </Grid>
            <Label Text="Select Exercise"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.3"/>
            <StackLayout Orientation="Horizontal" Spacing="8">
                <Label Text="Tap an exercise to add it to your workout"
                       FontSize="13"
                       TextColor="#999999"
                       VerticalOptions="Center"/>
                <Label Text="{Binding ExerciseCountLabel}"
                       FontSize="13"
                       TextColor="#1F77F0"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </StackLayout>
        </StackLayout>

        <!-- Search Bar -->
        <StackLayout Grid.Row="1" Padding="20,12" BackgroundColor="#FFFFFF" Spacing="0">
            <Border BackgroundColor="#F5F5F5" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="16"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="Search by name or muscle group..."
                           PlaceholderColor="#C0C0C0"
                           TextColor="#000000"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           VerticalOptions="Center"
                           ReturnType="Search"/>
                    <Button Grid.Column="2"
                            Text="✕"
                            Command="{Binding ClearSearchCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#999999"
                            FontSize="14"
                            Padding="4"
                            BorderWidth="0"
                            IsVisible="{Binding HasSearchText}"/>
                </Grid>
            </Border>
        </StackLayout>

        <!-- Muscle Group Filter Pills -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="#FFFFFF">
            <StackLayout Orientation="Horizontal" Padding="16,8" Spacing="8">
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=All}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="All"/>
                    </Border.GestureRecognizers>
                    <Label Text="All" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=All}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Recent}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Recent"/>
                    </Border.GestureRecognizers>
                    <StackLayout Spacing="0">
                        <Label Text="🕐 Recent" FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Recent}"/>
                        <Label Text="last 30 days" FontSize="9"
                               TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Recent}"
                               Opacity="0.7"/>
                    </StackLayout>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Custom}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Custom"/>
                    </Border.GestureRecognizers>
                    <Label Text="⭐ Custom" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Custom}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Chest}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Chest"/>
                    </Border.GestureRecognizers>
                    <Label Text="🔵 Chest" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Chest}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Back}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Back"/>
                    </Border.GestureRecognizers>
                    <Label Text="🟢 Back" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Back}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Legs}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Legs"/>
                    </Border.GestureRecognizers>
                    <Label Text="🟠 Legs" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Legs}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Shoulders}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Shoulders"/>
                    </Border.GestureRecognizers>
                    <Label Text="🟣 Shoulders" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Shoulders}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Arms}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Arms"/>
                    </Border.GestureRecognizers>
                    <Label Text="🔴 Arms" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Arms}"/>
                </Border>
                <Border BackgroundColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterColorConverter}, ConverterParameter=Core}"
                        StrokeThickness="0" Padding="14,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterByMuscleGroupCommand}" CommandParameter="Core"/>
                    </Border.GestureRecognizers>
                    <Label Text="🩵 Core" FontSize="12" FontAttributes="Bold"
                           TextColor="{Binding SelectedMuscleGroup, Converter={StaticResource MuscleGroupFilterTextColorConverter}, ConverterParameter=Core}"/>
                </Border>
            </StackLayout>
        </ScrollView>

        <!-- Exercise List -->
        <Grid Grid.Row="3">

            <!-- Flat list — search or filtered -->
            <CollectionView ItemsSource="{Binding FilteredExercises}"
                            SelectionMode="None"
                            IsVisible="{Binding ShowGrouped, Converter={StaticResource InverseBoolConverter}}">
                <CollectionView.EmptyView>
                    <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🔍" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="No exercises found"
                               FontSize="16" FontAttributes="Bold" TextColor="#999999" HorizontalOptions="Center"/>
                        <Label Text="Try a different search or create a new exercise"
                               FontSize="12" TextColor="#D0D0D0" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="+ Create Exercise"
                                Command="{Binding CreateExerciseCommand}"
                                BackgroundColor="#1F77F0"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="13"
                                Padding="20,12"
                                CornerRadius="20"
                                BorderWidth="0"
                                HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Exercise">
                        <Grid ColumnDefinitions="6,*,Auto,Auto"
                              BackgroundColor="#FFFFFF"
                              Margin="20,0,20,8"
                              ColumnSpacing="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=SelectExerciseCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                            <BoxView Grid.Column="0"
                                     BackgroundColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"
                                     HorizontalOptions="Fill" VerticalOptions="Fill"/>
                            <StackLayout Grid.Column="1" Spacing="3" Padding="14,14,8,14" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#000000"/>
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="{Binding MuscleGroup, Converter={StaticResource MuscleGroupEmojiConverter}}"
                                           FontSize="11" VerticalOptions="Center"/>
                                    <Label Text="{Binding MuscleGroup}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"
                                           VerticalOptions="Center"/>
                                    <Label Text="⭐ Custom" FontSize="10" TextColor="#999999"
                                           VerticalOptions="Center" IsVisible="{Binding IsCustom}"/>
                                </StackLayout>
                            </StackLayout>
                            <Button Grid.Column="2" Text="🗑"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=DeleteExerciseCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent" TextColor="#FF6B6B"
                                    FontSize="16" Padding="8" BorderWidth="0"
                                    IsVisible="{Binding IsCustom}" VerticalOptions="Center"/>
                            <Label Grid.Column="3" Text="+" FontSize="22" FontAttributes="Bold"
                                   TextColor="#1F77F0" VerticalOptions="Center" Padding="0,0,16,0"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Grouped list — All with no search -->
            <CollectionView ItemsSource="{Binding GroupedExercises}"
                            SelectionMode="None"
                            IsVisible="{Binding ShowGrouped}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlphaExerciseGroup">
                        <StackLayout Spacing="0">
                            <!-- Section Header -->
                            <Label Text="{Binding Letter}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#999999"
                                   CharacterSpacing="1"
                                   BackgroundColor="#FAFAFA"
                                   Padding="24,8,24,4"/>
                            <!-- Exercises in group -->
                            <StackLayout BindableLayout.ItemsSource="{Binding .}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Exercise">
                                        <Grid ColumnDefinitions="6,*,Auto,Auto"
                                              BackgroundColor="#FFFFFF"
                                              Margin="20,0,20,8"
                                              ColumnSpacing="0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=SelectExerciseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>
                                            <BoxView Grid.Column="0"
                                                     BackgroundColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"
                                                     HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                            <StackLayout Grid.Column="1" Spacing="3" Padding="14,14,8,14" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#000000"/>
                                                <StackLayout Orientation="Horizontal" Spacing="4">
                                                    <Label Text="{Binding MuscleGroup, Converter={StaticResource MuscleGroupEmojiConverter}}"
                                                           FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding MuscleGroup}" FontSize="12" FontAttributes="Bold"
                                                           TextColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="⭐ Custom" FontSize="10" TextColor="#999999"
                                                           VerticalOptions="Center" IsVisible="{Binding IsCustom}"/>
                                                </StackLayout>
                                            </StackLayout>
                                            <Button Grid.Column="2" Text="🗑"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=DeleteExerciseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent" TextColor="#FF6B6B"
                                                    FontSize="16" Padding="8" BorderWidth="0"
                                                    IsVisible="{Binding IsCustom}" VerticalOptions="Center"/>
                                            <Label Grid.Column="3" Text="+" FontSize="22" FontAttributes="Bold"
                                                   TextColor="#1F77F0" VerticalOptions="Center" Padding="0,0,16,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>