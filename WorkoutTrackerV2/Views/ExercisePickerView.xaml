<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.ExercisePickerView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:ExercisePickerViewModel"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <!--
            MuscleGroupColorConverter and MuscleGroupEmojiConverter are no longer
            referenced here. The item template now binds to Exercise.MuscleGroupColor
            and Exercise.MuscleGroupEmoji directly — pre-computed properties that
            carry zero runtime cost inside the binding layer.
            InverseBoolConverter is retained for the ✕ clear-search button.
        -->
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="← Back"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1F77F0"
                        FontSize="14"
                        Padding="0"/>
                <Button Grid.Column="2"
                        Text="+ New"
                        Command="{Binding CreateExerciseCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1F77F0"
                        FontSize="13"
                        FontAttributes="Bold"
                        Padding="10,8"
                        CornerRadius="20"
                        BorderWidth="1"
                        BorderColor="#1F77F0"/>
            </Grid>
            <Label Text="Select Exercise"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.3"/>
            <StackLayout Orientation="Horizontal" Spacing="8">
                <Label Text="Tap an exercise to add it to your workout"
                       FontSize="13"
                       TextColor="#999999"
                       VerticalOptions="Center"/>
                <Label Text="{Binding ExerciseCountLabel}"
                       FontSize="13"
                       TextColor="#1F77F0"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </StackLayout>
        </StackLayout>

        <!-- ── Search Bar ─────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="1" Padding="20,12" BackgroundColor="#FFFFFF" Spacing="0">
            <Border BackgroundColor="#F5F5F5" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,0" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="16"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="Search by name or muscle group..."
                           PlaceholderColor="#C0C0C0"
                           TextColor="#000000"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           VerticalOptions="Center"
                           ReturnType="Search"/>
                    <Button Grid.Column="2"
                            Text="✕"
                            Command="{Binding ClearSearchCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#999999"
                            FontSize="14"
                            Padding="4"
                            BorderWidth="0"
                            IsVisible="{Binding HasSearchText}"/>
                </Grid>
            </Border>
        </StackLayout>

        <!-- ── Muscle Group Filter Pills ──────────────────────────────────────
             Each pill binds IsSelected (one bool) rather than running two value
             converters (MuscleGroupFilterColorConverter + MuscleGroupFilterTextColorConverter)
             for every pill on every filter tap. DataTriggers on IsSelected handle
             background and text colour with no converter invocations at all.      -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="#FFFFFF">
            <StackLayout Orientation="Horizontal"
                         Padding="16,8"
                         Spacing="8"
                         BindableLayout.ItemsSource="{Binding FilterPills}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MuscleGroupPillViewModel">
                        <Border StrokeThickness="0" Padding="14,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <!-- Background colour driven by IsSelected — no converter -->
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=FilterByMuscleGroupCommand}"
                                    CommandParameter="{Binding Key}"/>
                            </Border.GestureRecognizers>
                            <StackLayout Spacing="0">
                                <!-- Text colour driven by IsSelected — no converter -->
                                <Label Text="{Binding Label}" FontSize="12" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#FFFFFF"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="#666666"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding SubLabel}"
                                       FontSize="10"
                                       Opacity="0.7"
                                       IsVisible="{Binding HasSubLabel}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="#FFFFFF"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="TextColor" Value="#666666"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </StackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>

        <!-- ── Exercise List ──────────────────────────────────────────────────
             Single CollectionView:
               • IsGrouped toggles natively — no second CollectionView constructed.
               • GroupHeaderTemplate rendered only when IsGrouped = true.
               • ItemTemplate uses Grid throughout (FIX 7) — eliminates the two-pass
                 measure cost of the nested StackLayouts in the original.
               • BoxView and Label.TextColor bind to Exercise.MuscleGroupColor (FIX 6),
                 a pre-computed property — zero MuscleGroupColorConverter calls.
               • Emoji Label binds to Exercise.MuscleGroupEmoji (FIX 6) — zero
                 MuscleGroupEmojiConverter calls.                                    -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding ExerciseSource}"
                        IsGrouped="{Binding IsGrouped}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="🔍" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="No exercises found"
                           FontSize="16" FontAttributes="Bold" TextColor="#999999"
                           HorizontalOptions="Center"/>
                    <Label Text="Try a different search or create a new exercise"
                           FontSize="12" TextColor="#D0D0D0" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="+ Create Exercise"
                            Command="{Binding CreateExerciseCommand}"
                            BackgroundColor="#1F77F0"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="13"
                            Padding="20,12"
                            CornerRadius="20"
                            BorderWidth="0"
                            HorizontalOptions="Center"/>
                </StackLayout>
            </CollectionView.EmptyView>

            <!-- Group header — only instantiated when IsGrouped = true -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:AlphaExerciseGroup">
                    <Label Text="{Binding Letter}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"
                           BackgroundColor="#FAFAFA"
                           Padding="24,8,24,4"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <!--
                        FIX 7: Outer layout is already a Grid (unchanged).
                        FIX 7: Column 1 changed from nested StackLayout+StackLayout
                               to Grid+Grid — cuts layout from 2-pass to 1-pass per item.
                        FIX 6: MuscleGroupColor and MuscleGroupEmoji are pre-computed
                               properties — no converter invocations on render.
                    -->
                    <Grid ColumnDefinitions="6,*,Auto,Auto"
                          BackgroundColor="#FFFFFF"
                          Margin="20,0,20,8"
                          ColumnSpacing="0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=SelectExerciseCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                        <!-- FIX 6: Binds to pre-computed MuscleGroupColor — no converter -->
                        <BoxView Grid.Column="0"
                                 BackgroundColor="{Binding MuscleGroupColor}"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill"/>

                        <!-- FIX 7: Grid replaces outer StackLayout — single measure pass -->
                        <Grid Grid.Column="1"
                              RowDefinitions="Auto,Auto"
                              Padding="14,14,8,14"
                              RowSpacing="3"
                              VerticalOptions="Center">

                            <Label Grid.Row="0"
                                   Text="{Binding Name}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#000000"/>

                            <!-- FIX 7: Grid replaces inner horizontal StackLayout -->
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="4">

                                <!-- FIX 6: Binds to pre-computed MuscleGroupEmoji — no converter -->
                                <Label Grid.Column="0"
                                       Text="{Binding MuscleGroupEmoji}"
                                       FontSize="11"
                                       VerticalOptions="Center"/>

                                <!-- FIX 6: Binds to pre-computed MuscleGroupColor — no converter -->
                                <Label Grid.Column="1"
                                       Text="{Binding MuscleGroup}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding MuscleGroupColor}"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="2"
                                       Text="⭐ Custom"
                                       FontSize="10"
                                       TextColor="#999999"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsCustom}"/>
                            </Grid>
                        </Grid>

                        <Button Grid.Column="2"
                                Text="🗑"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExercisePickerViewModel}}, Path=DeleteExerciseCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Transparent"
                                TextColor="#FF6B6B"
                                FontSize="16"
                                Padding="8"
                                BorderWidth="0"
                                VerticalOptions="Center"/>

                        <Label Grid.Column="3"
                               Text="+"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               VerticalOptions="Center"
                               Padding="0,0,16,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
