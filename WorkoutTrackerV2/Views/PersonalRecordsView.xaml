<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.PersonalRecordsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:PersonalRecordsViewModel"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <converters:DaysToColorConverter x:Key="DaysToColorConverter"/>
        <converters:DaysToTextColorConverter x:Key="DaysToTextColorConverter"/>
        <converters:MuscleGroupColorConverter x:Key="MuscleGroupColorConverter"/>
        <converters:BoolToChevronConverter x:Key="BoolToChevronConverter"/>
    </ContentPage.Resources>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#1F77F0"
                    FontSize="14"
                    Padding="0"
                    HorizontalOptions="Start"/>
            <Label Text="🏆 Personal Records"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.5"/>
            <Label Text="Your best lifts of all time"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- Time Period Pills -->
                <StackLayout Spacing="10">
                    <Label Text="TIME PERIOD"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=0}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="0"/>
                            </Border.GestureRecognizers>
                            <Label Text="All" FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=0}"
                                   HorizontalOptions="Center" Padding="0,8"/>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=30}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="30"/>
                            </Border.GestureRecognizers>
                            <Label Text="30d" FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=30}"
                                   HorizontalOptions="Center" Padding="0,8"/>
                        </Border>
                        <Border Grid.Column="2"
                                BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=60}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="60"/>
                            </Border.GestureRecognizers>
                            <Label Text="60d" FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=60}"
                                   HorizontalOptions="Center" Padding="0,8"/>
                        </Border>
                        <Border Grid.Column="3"
                                BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=90}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="90"/>
                            </Border.GestureRecognizers>
                            <Label Text="90d" FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=90}"
                                   HorizontalOptions="Center" Padding="0,8"/>
                        </Border>
                        <Border Grid.Column="4"
                                BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=180}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="180"/>
                            </Border.GestureRecognizers>
                            <Label Text="180d" FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=180}"
                                   HorizontalOptions="Center" Padding="0,8"/>
                        </Border>
                        <Border Grid.Column="5"
                                BackgroundColor="{Binding SelectedDays, Converter={StaticResource DaysToColorConverter}, ConverterParameter=365}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimePeriodCommand}" CommandParameter="365"/>
                            </Border.GestureRecognizers>
                            <Label Text="1yr" FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding SelectedDays, Converter={StaticResource DaysToTextColorConverter}, ConverterParameter=365}"
                                   HorizontalOptions="Center" Padding="0,8"/>
                        </Border>
                    </Grid>
                </StackLayout>

                <!-- Records List -->
                <CollectionView ItemsSource="{Binding Records}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center">
                            <Label Text="🏆" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No personal records yet"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#999999"
                                   HorizontalOptions="Center"/>
                            <Label Text="Log workouts to start tracking your PRs"
                                   FontSize="12"
                                   TextColor="#D0D0D0"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PersonalRecord">
                            <StackLayout Margin="0,0,0,10">
                                <StackLayout BackgroundColor="#FFFFFF" Padding="0" Spacing="0">

                                    <!-- PR Card Header -->
                                    <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                                        <BoxView Grid.Column="0"
                                                 BackgroundColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Fill"/>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="0,14,0,14">
                                            <StackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding ExerciseName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#000000"/>
                                                <Label Text="{Binding MuscleGroup}"
                                                       FontSize="11"
                                                       TextColor="{Binding MuscleGroup, Converter={StaticResource MuscleGroupColorConverter}}"/>
                                            </StackLayout>
                                            <!-- Best Weight Badge -->
                                            <StackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,4,0">
                                                <Label Text="🏆" FontSize="16" HorizontalOptions="Center"/>
                                                <Label Text="{Binding BestWeight, StringFormat='{0:F0} lbs'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#FFD700"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="{Binding BestDate, StringFormat='{0:MMM d, yyyy}'}"
                                                       FontSize="10"
                                                       TextColor="#999999"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </Grid>
                                        <!-- Expand Button -->
                                        <Button Grid.Column="2"
                                                Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}, Path=ToggleExpandedCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#999999"
                                                FontSize="14"
                                                Padding="12,0"
                                                BorderWidth="0"
                                                VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- PR History (expandable) -->
                                    <StackLayout IsVisible="{Binding IsExpanded}" Padding="16,0,16,12" Spacing="0">
                                        <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="0,0,0,10"/>
                                        <Label Text="PR HISTORY"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#999999"
                                               CharacterSpacing="1"
                                               Margin="0,0,0,8"/>
                                        <StackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:PersonalRecordEntry">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}"
                                                               FontSize="12"
                                                               TextColor="#999999"
                                                               VerticalOptions="Center"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Weight, StringFormat='{0:F0} lbs'}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#1F77F0"
                                                               VerticalOptions="Center"/>
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Reps, StringFormat='× {0}'}"
                                                               FontSize="13"
                                                               TextColor="#999999"
                                                               VerticalOptions="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>
                                    </StackLayout>

                                </StackLayout>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>