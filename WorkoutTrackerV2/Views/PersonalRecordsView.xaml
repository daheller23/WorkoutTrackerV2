<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.PersonalRecordsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             x:DataType="vm:PersonalRecordsViewModel"
             BackgroundColor="#F4F5F7">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">

                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent" TextColor="#1F77F0"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Personal Records"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.5"/>
                    <Label Text="Your best lifts of all time"
                           FontSize="14" TextColor="#737373"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="TIME PERIOD" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                    <Border BackgroundColor="#F4F5F7" StrokeThickness="0" Padding="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <FlexLayout BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimePeriodPillViewModel">
                                    <Border StrokeThickness="0" Padding="0,10" Margin="2" FlexLayout.Grow="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}, Path=SetTimePeriodCommand}" CommandParameter="{Binding DaysString}"/>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                <Setter Property="Shadow">
                                                    <Setter.Value>
                                                        <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#1A1A1A"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#A3A3A3"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Records}" 
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        Margin="20,0">
            <CollectionView.Header>
                <Grid HeightRequest="24" BackgroundColor="Transparent"/>
            </CollectionView.Header>
            <CollectionView.Footer>
                <Grid HeightRequest="40" BackgroundColor="Transparent"/>
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="🏆" FontSize="56" HorizontalOptions="Center"/>
                    <Label Text="No personal records yet" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                    <Label Text="Keep logging workouts to start building your trophy case." 
                           FontSize="14" TextColor="#A3A3A3" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PersonalRecord">
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="6,*,Auto,Auto" ColumnSpacing="12">
                                <BoxView Grid.Column="0" BackgroundColor="{Binding MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,16,0,16">
                                    <Label Text="{Binding ExerciseName}" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                    <Label Text="{Binding MuscleGroup}" FontSize="12" FontAttributes="Bold" TextColor="{Binding MuscleGroupColor}"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="0" HorizontalOptions="End" VerticalOptions="Center" Padding="0,16,4,16">
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                        <Label Text="🏆" FontSize="14" VerticalOptions="Center"/>
                                        <Label FontSize="16" FontAttributes="Bold" TextColor="#FFB74D" VerticalOptions="Center">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0:F0} {1}">
                                                    <Binding Path="BestWeight"/>
                                                    <Binding Source="{RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}" Path="WeightUnitLabel"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding BestDate, StringFormat='{0:MMM d, yyyy}'}" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="3"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}, Path=ToggleExpandedCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" TextColor="#C0C0C0"
                                        FontSize="16" FontAttributes="Bold" Padding="12,0,16,0"
                                        BorderWidth="0" VerticalOptions="Center">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="▼"/>
                                            <Setter Property="TextColor" Value="#1F77F0"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="▶"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" BackgroundColor="#FAFAFA">
                                <BoxView HeightRequest="1" Color="#F4F5F7"/>
                                <VerticalStackLayout Padding="20,16,20,20" Spacing="12">
                                    <Label Text="PR HISTORY" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:PersonalRecordEntry">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                                    <Label Grid.Column="0" Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}" FontSize="13" FontAttributes="Bold" TextColor="#737373" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1" FontSize="14" FontAttributes="Bold" TextColor="#1F77F0" VerticalOptions="Center">
                                                        <Label.Text>
                                                            <MultiBinding StringFormat="{}{0:F0} {1}">
                                                                <Binding Path="Weight"/>
                                                                <Binding Source="{RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}" Path="WeightUnitLabel"/>
                                                            </MultiBinding>
                                                        </Label.Text>
                                                    </Label>
                                                    <Label Grid.Column="2" Text="{Binding Reps, StringFormat='× {0}'}" FontSize="14" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>