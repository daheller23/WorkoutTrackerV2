<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.PersonalRecordsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             x:DataType="vm:PersonalRecordsViewModel"
             BackgroundColor="#FAFAFA">

    <!--
        FIX 4: DaysToColorConverter and DaysToTextColorConverter removed —
                replaced with TimePeriodPillViewModel + DataTriggers on IsSelected.
        FIX 5: MuscleGroupColorConverter removed — XAML binds to
                PersonalRecord.MuscleGroupColor (pre-computed string).
        FIX 6: BoolToChevronConverter removed — DataTrigger on IsExpanded
                sets Button.Text directly.
        No converter resources needed on this page.
    -->

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent" TextColor="#1F77F0"
                    FontSize="14" Padding="0" HorizontalOptions="Start"/>
            <Label Text="Personal Records"
                   FontSize="32" FontAttributes="Bold"
                   TextColor="#1F77F0" CharacterSpacing="0.5"/>
            <Label Text="Your best lifts of all time"
                   FontSize="13" TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- ── Time Period Pills ──────────────────────────────────────
                     FIX 4: FlexLayout + BindableLayout over TimePeriodPills
                     replaces 6 hard-coded Borders running 2 converters each.
                     DataTriggers on IsSelected handle colour — zero converters.  -->
                <StackLayout Spacing="10">
                    <Label Text="TIME PERIOD"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <FlexLayout Direction="Row"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimePeriodPillViewModel">
                                <Border StrokeThickness="0" Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}, Path=SetTimePeriodCommand}"
                                            CommandParameter="{Binding DaysString}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="12" FontAttributes="Bold"
                                           HorizontalOptions="Center" Padding="10,8">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="#666666"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>

                <!-- ── Records List ───────────────────────────────────────── -->
                <CollectionView ItemsSource="{Binding Records}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="🏆" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No personal records yet"
                                   FontSize="16" FontAttributes="Bold" TextColor="#999999"
                                   HorizontalOptions="Center"/>
                            <Label Text="Log workouts to start tracking your PRs"
                                   FontSize="12" TextColor="#D0D0D0"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PersonalRecord">
                            <!--
                                FIX 7: Outer StackLayout wrapper removed — inner
                                StackLayout is the direct item root with Margin
                                moved onto it to preserve spacing.
                            -->
                            <StackLayout BackgroundColor="#FFFFFF"
                                         Padding="0" Spacing="0"
                                         Margin="0,0,0,10">

                                <!-- PR Card Header -->
                                <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="12">
                                    <!--
                                        FIX 5: Binds to MuscleGroupColor (pre-computed)
                                        instead of MuscleGroupColorConverter.
                                    -->
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{Binding MuscleGroupColor}"
                                             HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="*,Auto"
                                          Padding="0,14,0,14">
                                        <StackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding ExerciseName}"
                                                   FontSize="15" FontAttributes="Bold" TextColor="#000000"/>
                                            <!--
                                                FIX 5: TextColor binds to MuscleGroupColor.
                                            -->
                                            <Label Text="{Binding MuscleGroup}"
                                                   FontSize="11"
                                                   TextColor="{Binding MuscleGroupColor}"/>
                                        </StackLayout>
                                        <!-- Best Weight Badge -->
                                        <StackLayout Grid.Column="1" Spacing="2"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center"
                                                     Margin="0,0,4,0">
                                            <Label Text="🏆" FontSize="16" HorizontalOptions="Center"/>
                                            <Label FontSize="14" FontAttributes="Bold"
                                                   TextColor="#FFD700" HorizontalOptions="Center">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0:F0} {1}">
                                                        <Binding Path="BestWeight"/>
                                                        <Binding Source="{RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}" Path="WeightUnitLabel"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                            <Label Text="{Binding BestDate, StringFormat='{0:MMM d, yyyy}'}"
                                                   FontSize="10" TextColor="#999999"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                    </Grid>
                                    <!-- Expand / Collapse Button
                                         FIX 6: DataTrigger on IsExpanded sets Text
                                         directly — BoolToChevronConverter removed.  -->
                                    <Button Grid.Column="2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}, Path=ToggleExpandedCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" TextColor="#999999"
                                            FontSize="14" Padding="12,0"
                                            BorderWidth="0" VerticalOptions="Center">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Text" Value="▼"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>

                                <!-- PR History (expandable) -->
                                <StackLayout IsVisible="{Binding IsExpanded}"
                                             Padding="16,0,16,12" Spacing="0">
                                    <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="0,0,0,10"/>
                                    <Label Text="PR HISTORY"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="#999999" CharacterSpacing="1"
                                           Margin="0,0,0,8"/>
                                    <StackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:PersonalRecordEntry">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}"
                                                           FontSize="12" TextColor="#999999"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="#1F77F0" VerticalOptions="Center">
                                                        <Label.Text>
                                                            <MultiBinding StringFormat="{}{0:F0} {1}">
                                                                <Binding Path="Weight"/>
                                                                <Binding Source="{RelativeSource AncestorType={x:Type vm:PersonalRecordsViewModel}}" Path="WeightUnitLabel"/>
                                                            </MultiBinding>
                                                        </Label.Text>
                                                    </Label>
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Reps, StringFormat='× {0}'}"
                                                           FontSize="13" TextColor="#999999"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>
                                </StackLayout>

                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
