<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.HomeView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:HomeViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             BackgroundColor="#FAFAFA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <ContentPage.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <Grid BackgroundColor="#FFFFFF" Padding="24,16,24,24" ColumnDefinitions="*,Auto">
            <StackLayout Grid.Column="0" Spacing="4">
                <Label Text="💪 Workouts"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="#1F77F0"
                       CharacterSpacing="0.5"/>
                <Label Text="Track your progress"
                       FontSize="13"
                       TextColor="#999999"/>
            </StackLayout>
            <Button Grid.Column="1"
                    Text="⚙️"
                    Command="{Binding ViewSettingsCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#1F77F0"
                    FontSize="22"
                    Padding="0"
                    VerticalOptions="Start"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="16">

                <!-- Dynamic Motivational Card -->
                <StackLayout BackgroundColor="#1F77F0" Padding="20,24" Spacing="8">
                    <Label Text="{Binding MotivationalMessage}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           CharacterSpacing="0.3"/>
                    <Label Text="{Binding MotivationalSubMessage}"
                           FontSize="13"
                           TextColor="#FFFFFF"
                           Opacity="0.85"
                           LineBreakMode="WordWrap"/>
                    <Button Text="+ Start Workout"
                            Command="{Binding StartWorkoutCommand}"
                            BackgroundColor="#FFFFFF"
                            TextColor="#1F77F0"
                            FontAttributes="Bold"
                            FontSize="13"
                            Padding="0,10"
                            CornerRadius="8"
                            BorderWidth="0"
                            Margin="0,8,0,0"/>
                </StackLayout>

                <!-- Compact Stats Row -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                    <!-- Streak -->
                    <StackLayout BackgroundColor="#FFF8E1" Padding="14,16" Spacing="4">
                        <Label Text="🔥" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding CurrentStreak}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="#FF6F00"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding StreakSubtitle}"
                               FontSize="9"
                               TextColor="#FF9800"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>

                    <!-- Total Workouts -->
                    <StackLayout Grid.Column="1" BackgroundColor="#F0F7FF" Padding="14,16" Spacing="4">
                        <Label Text="🏋️" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalWorkouts}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               HorizontalOptions="Center"/>
                        <Label Text="total workouts"
                               FontSize="9"
                               TextColor="#1F77F0"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                    <!-- Avg Duration -->
                    <StackLayout Grid.Column="2" BackgroundColor="#F1F8F1" Padding="14,16" Spacing="4">
                        <Label Text="⏱" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding AverageDuration, StringFormat='{0:F0}'}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"
                               HorizontalOptions="Center"/>
                        <Label Text="avg minutes"
                               FontSize="9"
                               TextColor="#4CAF50"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                </Grid>

                <!-- Last Workout Card -->
                <StackLayout IsVisible="{Binding LastWorkoutSession, Converter={StaticResource IsNotNullConverter}}"
                    BackgroundColor="#FFFFFF"
                    Padding="16"
                    Spacing="10">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding ViewWorkoutCommand}"
                            CommandParameter="{Binding LastWorkoutSession}"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="LAST WORKOUT"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#999999"
                       CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="3">
                            <Label Text="{Binding LastWorkoutSession.DayName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#000000"/>
                            <Label Text="{Binding LastWorkoutSession.Date, StringFormat='{0:MMM d, yyyy}'}"
                               FontSize="12"
                               TextColor="#999999"/>
                        </StackLayout>
                        <StackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="{Binding LastWorkoutSession.Duration, StringFormat='{0:hh\\:mm}'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               HorizontalOptions="End"/>
                            <Label Text="{Binding LastWorkoutSession.TotalExercises, StringFormat='{0} exercises'}"
                               FontSize="11"
                               TextColor="#999999"
                               HorizontalOptions="End"/>
                        </StackLayout>
                    </Grid>
                    <BoxView HeightRequest="0.5" Color="#F0F0F0"/>
                    <Label Text="Tap to view details →"
                       FontSize="11"
                       TextColor="#1F77F0"
                       HorizontalOptions="End"/>
                </StackLayout>

                <!-- Most Trained Muscle Group -->
                <StackLayout IsVisible="{Binding MostTrainedMuscleGroup, Converter={StaticResource IsNotEmptyConverter}}"
                             BackgroundColor="#FFFFFF"
                             Padding="16"
                             Spacing="6">
                    <Label Text="THIS WEEK'S FOCUS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🏆"
                               FontSize="28"
                               VerticalOptions="Center"
                               Margin="0,0,12,0"/>
                        <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding MostTrainedMuscleGroup}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1F77F0"/>
                            <Label Text="most trained muscle group this week"
                                   FontSize="11"
                                   TextColor="#999999"/>
                        </StackLayout>
                    </Grid>
                </StackLayout>

                <!-- Recent Workouts Section -->
                <StackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="0">
                        <Label Grid.Column="0"
                               Text="📋"
                               FontSize="20"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Recent Activity"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#000000"
                               CharacterSpacing="0.3"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="2"
                                Text="View all →"
                                BackgroundColor="Transparent"
                                TextColor="#1F77F0"
                                FontAttributes="Bold"
                                FontSize="12"
                                Padding="0"
                                Command="{Binding ViewHistoryCommand}"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding RecentSessions}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center">
                                <Label Text="🏋️" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="No workouts yet"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                                <Label Text="Tap the Workout tab to log your first session"
                                       FontSize="12"
                                       TextColor="#D0D0D0"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkoutSession">
                                <StackLayout Padding="16,14"
                                             Margin="0,0,0,10"
                                             BackgroundColor="#FFFFFF"
                                             Spacing="0">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ViewWorkoutCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </StackLayout.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" RowSpacing="0">
                                        <Label Grid.Column="0"
                                               Text="🏋️"
                                               FontSize="28"
                                               VerticalOptions="Center"/>
                                        <StackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding DayName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F77F0"/>
                                            <StackLayout Spacing="3">
                                                <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}"
                                                       FontSize="12"
                                                       TextColor="#999999"/>
                                                <Label Text="{Binding Notes}"
                                                       FontSize="11"
                                                       TextColor="#D0D0D0"
                                                       LineBreakMode="TailTruncation"/>
                                            </StackLayout>
                                        </StackLayout>
                                        <StackLayout Grid.Column="2"
                                                     Spacing="6"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End">
                                            <StackLayout BackgroundColor="#F0F7FF" Padding="8,6" Spacing="2">
                                                <Label Text="{Binding TotalExercises}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F77F0"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="exercises"
                                                       FontSize="9"
                                                       TextColor="#1F77F0"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                            <StackLayout BackgroundColor="#FFF8E1" Padding="8,6" Spacing="2">
                                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm}'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#FF9800"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="duration"
                                                       FontSize="9"
                                                       TextColor="#FF9800"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,10,0,0"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <Label Text=" " Margin="0,20"/>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>