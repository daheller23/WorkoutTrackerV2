<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.HomeView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:HomeViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             xmlns:controls="clr-namespace:WorkoutTrackerV2.Controls"
             BackgroundColor="#FAFAFA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <ContentPage.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
        <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
    </ContentPage.Resources>

    <AbsoluteLayout>

        <!-- ── Main content ──────────────────────────────────────────────────── -->
        <Grid RowDefinitions="Auto,*" RowSpacing="0"
          AbsoluteLayout.LayoutFlags="All"
          AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- ── Header ───────────────────────────────────────────────────── -->
            <Grid BackgroundColor="#FFFFFF" Padding="24,16,24,24" ColumnDefinitions="*,Auto">
                <StackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Replify"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#1F77F0"
                       CharacterSpacing="0.5"/>
                    <Label Text="Track your progress"
                       FontSize="13"
                       TextColor="#999999"/>
                </StackLayout>
                <Button Grid.Column="1"
                    Text="&#x2699;&#xFE0F;"
                    Command="{Binding ViewSettingsCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#1F77F0"
                    FontSize="22"
                    Padding="8"
                    VerticalOptions="Start"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <StackLayout Padding="20,20" Spacing="16">

                    <!-- ── Primary CTA ───────────────────────────────────────────
                     Pulled out of the card so it's unmistakably the main
                     action on the page. Full-width, prominent, always first. -->
                    <Button Text="+ Start Workout"
                        Command="{Binding StartWorkoutCommand}"
                        BackgroundColor="#1F77F0"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="52"
                        CornerRadius="12"
                        BorderWidth="0"/>

                    <!-- ── Motivational Card ─────────────────────────────────────
                     Message and sub-message only. Button moved above.        -->
                    <StackLayout BackgroundColor="#F0F7FF" Padding="20,18" Spacing="6">
                        <Label Text="{Binding MotivationalMessage}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F77F0"
                           CharacterSpacing="0.3"/>
                        <Label Text="{Binding MotivationalSubMessage}"
                           FontSize="13"
                           TextColor="#64B5F6"/>
                    </StackLayout>

                    <!-- ── Quick Stats ───────────────────────────────────────────
                     Bordered tiles so they sit cleanly on the #FAFAFA page.  -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border BackgroundColor="#FFF8E1"
                            Stroke="#FFE0B2" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <StackLayout Padding="10,14" Spacing="4">
                                <Label Text="&#x1F525;" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="{Binding CurrentStreak}"
                                   FontSize="24" FontAttributes="Bold" TextColor="#FF6F00"
                                   HorizontalOptions="Center"/>
                                <Label Text="{Binding StreakSubtitle}"
                                   FontSize="10" TextColor="#FF9800" HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#F0F7FF"
                            Stroke="#BBDEFB" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <StackLayout Padding="10,14" Spacing="4">
                                <Label Text="&#x1F3CB;&#xFE0F;" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="{Binding TotalWorkouts}"
                                   FontSize="24" FontAttributes="Bold" TextColor="#1F77F0"
                                   HorizontalOptions="Center"/>
                                <Label Text="workouts" FontSize="10" TextColor="#1F77F0"
                                   HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#F1F8F1"
                            Stroke="#C8E6C9" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <StackLayout Padding="10,14" Spacing="4">
                                <Label Text="&#x23F1;" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="{Binding AverageDuration, StringFormat='{0:F0}'}"
                                   FontSize="24" FontAttributes="Bold" TextColor="#4CAF50"
                                   HorizontalOptions="Center"/>
                                <Label Text="avg min" FontSize="10" TextColor="#4CAF50"
                                   HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>
                    </Grid>

                    <!-- ── This Week ─────────────────────────────────────────────
                     Three numbers in one white card with dividers.           -->
                    <StackLayout Spacing="8">
                        <Label Text="THIS WEEK"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#BBBBBB" CharacterSpacing="1"/>
                        <Grid BackgroundColor="#FFFFFF" ColumnDefinitions="*,1,*,1,*">
                            <StackLayout Grid.Column="0" Padding="0,14" Spacing="3">
                                <Label Text="{Binding WorkoutsThisWeek}"
                                   FontSize="22" FontAttributes="Bold" TextColor="#1F77F0"
                                   HorizontalOptions="Center"/>
                                <Label Text="workouts" FontSize="10" TextColor="#999999"
                                   HorizontalOptions="Center"/>
                            </StackLayout>
                            <BoxView Grid.Column="1" BackgroundColor="#F0F0F0"
                                 WidthRequest="1" Margin="0,10"/>
                            <StackLayout Grid.Column="2" Padding="0,14" Spacing="3">
                                <Label Text="{Binding SetsThisWeek}"
                                   FontSize="22" FontAttributes="Bold" TextColor="#1F77F0"
                                   HorizontalOptions="Center"/>
                                <Label Text="sets" FontSize="10" TextColor="#999999"
                                   HorizontalOptions="Center"/>
                            </StackLayout>
                            <BoxView Grid.Column="3" BackgroundColor="#F0F0F0"
                                 WidthRequest="1" Margin="0,10"/>
                            <StackLayout Grid.Column="4" Padding="0,14" Spacing="3">
                                <Label Text="{Binding VolumeThisWeek, StringFormat='{0:F0}'}"
                                   FontSize="22" FontAttributes="Bold" TextColor="#1F77F0"
                                   HorizontalOptions="Center"/>
                                <Label Text="volume" FontSize="10" TextColor="#999999"
                                   HorizontalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </StackLayout>

                    <!-- ── Navigation ────────────────────────────────────────────
                     List-style rows with icon, full name, subtitle, chevron.
                     Pattern is immediately recognisable as "tap to go there". -->
                    <StackLayout Spacing="8">
                        <Label Text="EXPLORE"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#BBBBBB" CharacterSpacing="1"/>
                        <StackLayout BackgroundColor="#FFFFFF" Spacing="0">

                            <!-- History -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewHistoryCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#EEF4FF" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#x1F4C5;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Workout History"
                                       FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="{Binding TotalWorkouts, StringFormat='{0} sessions logged'}"
                                       FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="14,0"/>

                            <!-- Analytics -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewAnalyticsCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#EDFAEE" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#x1F4CA;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Analytics"
                                       FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="{Binding MostTrainedMuscleGroup,
                                             StringFormat='Top muscle group: {0}',
                                             FallbackValue='Track your progress over time'}"
                                       FontSize="12" TextColor="#999999"
                                       LineBreakMode="TailTruncation"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="14,0"/>

                            <!-- Personal Records -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewPersonalRecordsCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#FFF3E0" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#x1F3C6;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Personal Records"
                                       FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="{Binding CurrentStreak, StringFormat='Current streak: {0} days'}"
                                       FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="14,0"/>

                            <!-- Body Weight -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewBodyWeightCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#F3E5F5" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#x2696;&#xFE0F;" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Body Weight"
                                       FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="Log and track your weight over time"
                                       FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="14,0"/>

                            <!-- Plate Calculator -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewPlateCalculatorCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#EEF4FF" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🏋️" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Plate Calculator"
                                       FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="How to load the bar for any weight"
                                       FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="14,0"/>

                            <!-- 1RM Calculator -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewOneRepMaxCalculatorCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#FFF8E1" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🏆" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="1RM Calculator"
                                       FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="Estimate your one-rep max from any set"
                                       FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="0.5" Color="#F0F0F0" Margin="14,0"/>
                            
                            <!-- Weight Converter Calculator -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,13">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewWeightConverterCommand}"/>
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" BackgroundColor="#F3E5F5" StrokeThickness="0"
                                    WidthRequest="38" HeightRequest="38" Margin="0,0,14,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="⚖️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Weight Converter" FontSize="14" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="Lbs to Kg / Kg to Lbs" FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CCCCCC" VerticalOptions="Center"/>
                            </Grid>

                        </StackLayout>
                    </StackLayout>

                    <!-- ── Recent Sessions ───────────────────────────────────────
                     Replaces both the "Last Workout" card and the separate
                     "Recent Activity" list — same data, shown once, cleanly.
                     Most recent session is visually accented; others compact. -->
                    <StackLayout IsVisible="{Binding LastWorkoutSession, Converter={StaticResource IsNotNullConverter}}"
                             Spacing="8">
                        <Label Text="RECENT SESSIONS"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#BBBBBB" CharacterSpacing="1"/>

                        <!-- Most recent — full card with accent stripe and stats -->
                        <Grid BackgroundColor="#FFFFFF" ColumnDefinitions="4,*" ColumnSpacing="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                Command="{Binding ViewWorkoutCommand}"
                                CommandParameter="{Binding LastWorkoutSession}"/>
                            </Grid.GestureRecognizers>
                            <BoxView Grid.Column="0"
                                 BackgroundColor="{Binding MostTrainedMuscleGroupColor}"
                                 HorizontalOptions="Fill" VerticalOptions="Fill"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="14,14">
                                <StackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding LastWorkoutSession.DayName}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#111111"/>
                                    <Label Text="{Binding LastWorkoutSession.Date, StringFormat='{0:MMM d, yyyy}'}"
                                       FontSize="12" TextColor="#999999"/>
                                </StackLayout>
                                <StackLayout Grid.Column="1" Spacing="5"
                                         HorizontalOptions="End" VerticalOptions="Center">
                                    <StackLayout BackgroundColor="#F0F7FF" Padding="8,5" Spacing="1">
                                        <Label Text="{Binding LastWorkoutSession.TotalExercises}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#1F77F0"
                                           HorizontalOptions="Center"/>
                                        <Label Text="exercises" FontSize="9" TextColor="#1F77F0"
                                           HorizontalOptions="Center"/>
                                    </StackLayout>
                                    <StackLayout BackgroundColor="#FFF8E1" Padding="8,5" Spacing="1">
                                        <Label Text="{Binding LastWorkoutSession.Duration, StringFormat='{0:hh\\:mm}'}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#FF9800"
                                           HorizontalOptions="Center"/>
                                        <Label Text="duration" FontSize="9" TextColor="#FF9800"
                                           HorizontalOptions="Center"/>
                                    </StackLayout>
                                </StackLayout>
                            </Grid>
                        </Grid>

                        <!-- Older sessions — compact rows -->
                        <StackLayout IsVisible="{Binding RecentSessions.Count, Converter={StaticResource IsNotEmptyConverter}}"
                                 BindableLayout.ItemsSource="{Binding RecentSessions}"
                                 Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkoutSession">
                                    <Grid ColumnDefinitions="4,*" ColumnSpacing="0" BackgroundColor="#FFFFFF">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ViewWorkoutCommand}"
                                            CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                        <BoxView Grid.Column="0" BackgroundColor="#E8E8E8"
                                             HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="14,11">
                                            <StackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding DayName}"
                                                   FontSize="14" FontAttributes="Bold" TextColor="#333333"/>
                                                <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}"
                                                   FontSize="11" TextColor="#AAAAAA"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1" Spacing="2"
                                                     HorizontalOptions="End" VerticalOptions="Center">
                                                <Label Text="{Binding TotalExercises, StringFormat='{0} exercises'}"
                                                   FontSize="11" FontAttributes="Bold" TextColor="#1F77F0"
                                                   HorizontalOptions="End"/>
                                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm}'}"
                                                   FontSize="11" TextColor="#AAAAAA"
                                                   HorizontalOptions="End"/>
                                            </StackLayout>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                        <Button Text="View all history →"
                            Command="{Binding ViewHistoryCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#1F77F0"
                            FontSize="12"
                            Padding="0,2"
                            HorizontalOptions="End"
                            BorderWidth="0"/>
                    </StackLayout>

                    <Label Text=" " Margin="0,8"/>

                </StackLayout>
            </ScrollView>

        </Grid>

        <!-- ── PR Celebration Overlay ────────────────────────────────────────
         Sits above all content via AbsoluteLayout.
         Visibility and animation managed entirely from code-behind.      -->
        <Grid x:Name="PrOverlay"
          AbsoluteLayout.LayoutFlags="All"
          AbsoluteLayout.LayoutBounds="0,0,1,1"
          InputTransparent="True"
          IsVisible="False">

            <controls:ConfettiView x:Name="ConfettiCanvas"
                               InputTransparent="True"/>

            <Border x:Name="PrBanner"
                BackgroundColor="#FFFFFF"
                Stroke="#E8E8E8"
                StrokeThickness="1"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                Margin="20,80,20,0"
                InputTransparent="True"
                IsVisible="False"
                Opacity="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="6,Auto,*" ColumnSpacing="0">
                    <BoxView Grid.Column="0"
                         BackgroundColor="#FFD700"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill"/>
                    <Label Grid.Column="1"
                       Text="&#x1F3C6;"
                       FontSize="22"
                       VerticalOptions="Center"
                       Margin="14,16,10,16"/>
                    <StackLayout Grid.Column="2"
                             Spacing="2"
                             VerticalOptions="Center"
                             Padding="0,16,16,16">
                        <Label Text="NEW PERSONAL RECORD"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>
                        <Label x:Name="PrMessageLabel"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#1F77F0"
                           LineBreakMode="TailTruncation"/>
                    </StackLayout>
                </Grid>
            </Border>

        </Grid>

    </AbsoluteLayout>
</ContentPage>
