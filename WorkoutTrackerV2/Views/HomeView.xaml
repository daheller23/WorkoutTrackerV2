<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.HomeView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             Title="Fitness Dashboard"
             BackgroundColor="#FAFAFA">

    <ContentPage.BindingContext>
        <vm:HomeViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header with Gradient Effect -->
        <StackLayout BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="8">
            <Label Text="💪 Workouts" 
                   FontSize="36" 
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.5"/>
            <Label Text="Track your progress"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- Welcome Card with Motivational Message - Soft Blue -->
                <StackLayout Padding="20,24" 
                             BackgroundColor="#F0F7FF"
                             Spacing="12">
                    <Label Text="Ready for today's session?"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F77F0"
                           CharacterSpacing="0.3"/>
                    <Label Text="Keep the momentum going 💪"
                           FontSize="13"
                           TextColor="#64B5F6"/>
                </StackLayout>

                <!-- Streak Card - Prominent -->
                <StackLayout Padding="24,32" 
                             BackgroundColor="#FFF8E1"
                             Spacing="16">
                    <StackLayout Spacing="4">
                        <Label Text="🔥 Current Streak"
                               FontSize="13"
                               TextColor="#FF6F00"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"/>
                    </StackLayout>
                    <Label Text="{Binding CurrentStreak}"
                           FontSize="64"
                           FontAttributes="Bold"
                           TextColor="#FF6F00"
                           LineBreakMode="NoWrap"/>
                    <Label Text="days in a row"
                           FontSize="14"
                           TextColor="#FF9800"/>
                    <BoxView HeightRequest="2" WidthRequest="60" Color="#FF9800" HorizontalOptions="Start" Margin="0,8,0,0"/>
                </StackLayout>

                <!-- Total Workouts & Avg Duration Cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="0">
                    <!-- Total Workouts -->
                    <StackLayout Padding="20,24" 
                                 BackgroundColor="#FFFFFF"
                                 Spacing="12">
                        <Label Text="Total Workouts"
                               FontSize="12"
                               TextColor="#999999"
                               FontAttributes="Bold"
                               CharacterSpacing="0.3"/>
                        <Label Text="{Binding TotalWorkouts}"
                               FontSize="44"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"/>
                        <BoxView HeightRequest="2" WidthRequest="40" Color="#1F77F0" HorizontalOptions="Start"/>
                    </StackLayout>

                    <!-- Average Duration -->
                    <StackLayout Grid.Column="1"
                                 Padding="20,24" 
                                 BackgroundColor="#FFFFFF"
                                 Spacing="12">
                        <Label Text="Avg Duration"
                               FontSize="12"
                               TextColor="#999999"
                               FontAttributes="Bold"
                               CharacterSpacing="0.3"/>
                        <Label Text="{Binding AverageDuration, StringFormat='{0:F0}'}"
                               FontSize="44"
                               FontAttributes="Bold"
                               TextColor="#FF9800"/>
                        <Label Text="minutes"
                               FontSize="11"
                               TextColor="#FF9800"/>
                    </StackLayout>
                </Grid>

                <!-- Recent Workouts Section -->
                <StackLayout Spacing="16">
                    <!-- Section Header with Icon -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="0">
                        <Label Grid.Column="0"
                               Text="📋"
                               FontSize="20"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Recent Activity"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#000000"
                               CharacterSpacing="0.3"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="2"
                                Text="View all →"
                                BackgroundColor="Transparent"
                                TextColor="#1F77F0"
                                FontAttributes="Bold"
                                FontSize="12"
                                Padding="0"
                                Command="{Binding ViewHistoryCommand}"/>
                    </Grid>

                    <!-- Workouts List -->
                    <CollectionView ItemsSource="{Binding RecentSessions}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <StackLayout Padding="40,80" Spacing="16" HorizontalOptions="Center">
                                <Label Text="🏋️"
                                       FontSize="48"
                                       HorizontalOptions="Center"/>
                                <Label Text="No workouts yet"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                                <Label Text="Tap the Workout tab to log your first session"
                                       FontSize="12"
                                       TextColor="#D0D0D0"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="16,14" 
                                             Margin="0,0,0,10"
                                             BackgroundColor="#FFFFFF"
                                             Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" RowSpacing="0" Padding="0">
                                        <!-- Exercise Icon -->
                                        <Label Grid.Column="0"
                                               Text="🏋️"
                                               FontSize="28"
                                               VerticalOptions="Center"/>

                                        <!-- Workout Details -->
                                        <StackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding DayName}" 
                                                   FontSize="15" 
                                                   FontAttributes="Bold"
                                                   TextColor="#1F77F0"/>
                                            <StackLayout Spacing="3">
                                                <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}" 
                                                       FontSize="12"
                                                       TextColor="#999999"/>
                                                <Label Text="{Binding Notes}" 
                                                       FontSize="11"
                                                       TextColor="#D0D0D0"
                                                       LineBreakMode="TailTruncation"/>
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Stats Badges -->
                                        <StackLayout Grid.Column="2" 
                                                     Spacing="6"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End">
                                            <StackLayout BackgroundColor="#F0F7FF" Padding="8,6" Spacing="2">
                                                <Label Text="{Binding TotalExercises, StringFormat='{0}'}" 
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F77F0"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="exercises" 
                                                       FontSize="9"
                                                       TextColor="#1F77F0"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                            <StackLayout BackgroundColor="#FFF8E1" Padding="8,6" Spacing="2">
                                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm}'}" 
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#FF9800"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="duration" 
                                                       FontSize="9"
                                                       TextColor="#FF9800"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </StackLayout>
                                    </Grid>

                                    <!-- Subtle Divider -->
                                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,10,0,0"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <Label Text=" " Margin="0,20"/>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>