<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.HomeView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:HomeViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             xmlns:controls="clr-namespace:WorkoutTrackerV2.Controls"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark={StaticResource OffBlack}}">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <ContentPage.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
        <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*" RowSpacing="0">

            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" Padding="24,16,24,20" ColumnDefinitions="*,Auto">
                <Grid.Shadow>
                    <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="{AppThemeBinding Light=0.03, Dark=0.3}" />
                </Grid.Shadow>
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Overload"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"
                           CharacterSpacing="0.5"/>
                    <Label Text="Track your progress"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="&#x2699;&#xFE0F;"
                        Command="{Binding ViewSettingsCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                        FontSize="24"
                        Padding="8"
                        VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="20,24,20,40" Spacing="20">

                    <Button Text="+ Start Workout"
                            Command="{Binding StartWorkoutCommand}"
                            BackgroundColor="{AppThemeBinding Light=#1F77F0, Dark=#1F77F0}"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="56"
                            CornerRadius="14"
                            BorderWidth="0">
                        <Button.Shadow>
                            <Shadow Brush="#1F77F0" Offset="0,6" Radius="12" Opacity="0.25"/>
                        </Button.Shadow>
                    </Button>

                    <Border BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#142336}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="20,16" Spacing="4">
                            <Label Text="{Binding MotivationalMessage}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                                   CharacterSpacing="0.3"/>
                            <Label Text="{Binding MotivationalSubMessage}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#4A90E2, Dark=#7AAFF0}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#332400}" Stroke="{AppThemeBinding Light=#FFE0B2, Dark=#664800}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="8,16" Spacing="2">
                                <Label Text="&#x1F525;" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding CurrentStreak}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#FF6F00, Dark=#FF9800}" HorizontalOptions="Center"/>
                                <Label Text="{Binding StreakSubtitle}" FontSize="11" TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" Stroke="{AppThemeBinding Light=#BBDEFB, Dark=#1F497D}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="8,16" Spacing="2">
                                <Label Text="&#x1F3CB;&#xFE0F;" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding TotalWorkouts}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                <Label Text="workouts" FontSize="11" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F1F8F1, Dark=#0F2B14}" Stroke="{AppThemeBinding Light=#C8E6C9, Dark=#1F5926}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="8,16" Spacing="2">
                                <Label Text="&#x23F1;" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="{Binding AverageDuration, StringFormat='{0:F0}'}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}" HorizontalOptions="Center"/>
                                <Label Text="avg min" FontSize="11" TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="THIS WEEK" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark={StaticResource Gray400}}" CharacterSpacing="1" Margin="4,0,0,0"/>
                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="{AppThemeBinding Light=0.04, Dark=0.3}" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="*,1,*,1,*" Padding="0,4">
                                <VerticalStackLayout Grid.Column="0" Padding="0,16" Spacing="2">
                                    <Label Text="{Binding WorkoutsThisWeek}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                    <Label Text="workouts" FontSize="11" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark={StaticResource Gray600}}" WidthRequest="1" Margin="0,12"/>

                                <VerticalStackLayout Grid.Column="2" Padding="0,16" Spacing="2">
                                    <Label Text="{Binding SetsThisWeek}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                    <Label Text="sets" FontSize="11" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="3" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark={StaticResource Gray600}}" WidthRequest="1" Margin="0,12"/>

                                <VerticalStackLayout Grid.Column="4" Padding="0,16" Spacing="2">
                                    <Label Text="{Binding VolumeThisWeek, StringFormat='{0:F0}'}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                    <Label Text="volume" FontSize="11" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="EXPLORE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark={StaticResource Gray400}}" CharacterSpacing="1" Margin="4,0,0,0"/>

                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="{AppThemeBinding Light=0.04, Dark=0.3}" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="0">

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewHistoryCommand}"/>
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1A2B4A}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="&#x1F4C5;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Workout History" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                        <Label Text="{Binding TotalWorkouts, StringFormat='{0} sessions logged'}" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark={StaticResource Gray500}}" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark={StaticResource Gray600}}" Margin="72,0,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewAnalyticsCommand}"/>
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#EDFAEE, Dark=#19381D}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="&#x1F4CA;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Analytics" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                        <Label Text="{Binding MostTrainedMuscleGroup, StringFormat='Top muscle group: {0}', FallbackValue='Track your progress over time'}" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark={StaticResource Gray500}}" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark={StaticResource Gray600}}" Margin="72,0,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewPersonalRecordsCommand}"/>
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#3A2200}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="&#x1F3C6;" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Personal Records" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                        <Label Text="{Binding CurrentStreak, StringFormat='Current streak: {0} days'}" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark={StaticResource Gray500}}" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark={StaticResource Gray600}}" Margin="72,0,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewPlateCalculatorCommand}"/>
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1A2B4A}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="🏋️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Plate Calculator" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                        <Label Text="How to load the bar for any weight" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark={StaticResource Gray500}}" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark={StaticResource Gray600}}" Margin="72,0,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewOneRepMaxCalculatorCommand}"/>
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#332400}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="🏆" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="1RM Calculator" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                        <Label Text="Estimate your one-rep max from any set" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark={StaticResource Gray500}}" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark={StaticResource Gray600}}" Margin="72,0,0,0"/>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewWeightConverterCommand}"/>
                                    </Grid.GestureRecognizers>
                                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#321A38}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" Margin="0,0,16,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="⚖️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Weight Converter" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                        <Label Text="Lbs to Kg / Kg to Lbs" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark={StaticResource Gray500}}" VerticalOptions="Center"/>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding LastWorkoutSession, Converter={StaticResource IsNotNullConverter}}" Spacing="8">
                        <Label Text="RECENT SESSIONS" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark={StaticResource Gray400}}" CharacterSpacing="1" Margin="4,0,0,0"/>

                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="{AppThemeBinding Light=0.04, Dark=0.3}" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="5,*" ColumnSpacing="0">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewWorkoutCommand}" CommandParameter="{Binding LastWorkoutSession}"/>
                                    </Grid.GestureRecognizers>
                                    <BoxView Grid.Column="0" BackgroundColor="{Binding MostTrainedMuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="16,16">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding LastWorkoutSession.DayName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark={StaticResource White}}"/>
                                            <Label Text="{Binding LastWorkoutSession.Date, StringFormat='{0:MMM d, yyyy}'}" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark={StaticResource Gray300}}"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                            <Border BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Padding="10,6" Spacing="0">
                                                    <Label Text="{Binding LastWorkoutSession.TotalExercises}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                                    <Label Text="exercises" FontSize="10" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#332400}" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Padding="10,6" Spacing="0">
                                                    <Label Text="{Binding LastWorkoutSession.Duration, StringFormat='{0:hh\\:mm}'}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}" HorizontalOptions="Center"/>
                                                    <Label Text="duration" FontSize="10" TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>

                                <VerticalStackLayout IsVisible="{Binding RecentSessions.Count, Converter={StaticResource IsNotEmptyConverter}}"
                                                     BindableLayout.ItemsSource="{Binding RecentSessions}"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:WorkoutSession">
                                            <VerticalStackLayout>
                                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F4F4, Dark={StaticResource Gray600}}"/>
                                                <Grid ColumnDefinitions="5,*" ColumnSpacing="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ViewWorkoutCommand}" CommandParameter="{Binding .}"/>
                                                    </Grid.GestureRecognizers>
                                                    <BoxView Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark={StaticResource Gray600}}" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="16,12">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                                            <Label Text="{Binding DayName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark={StaticResource White}}"/>
                                                            <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark={StaticResource Gray300}}"/>
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End" VerticalOptions="Center">
                                                            <Label Text="{Binding TotalExercises, StringFormat='{0} exercises'}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="End"/>
                                                            <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm}'}" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark={StaticResource Gray300}}" HorizontalOptions="End"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="View all history →"
                                Command="{Binding ViewHistoryCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Center"
                                BorderWidth="0"
                                Margin="0,4,0,0"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid x:Name="PrOverlay"
              InputTransparent="True"
              IsVisible="False"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <controls:ConfettiView x:Name="ConfettiCanvas" InputTransparent="True"/>

            <Border x:Name="PrBanner"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray900}}"
                    StrokeThickness="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start"
                    Margin="20,60,20,0"
                    InputTransparent="True"
                    IsVisible="False"
                    Opacity="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="16" Opacity="{AppThemeBinding Light=0.15, Dark=0.5}" />
                </Border.Shadow>

                <Grid ColumnDefinitions="8,Auto,*" ColumnSpacing="0">
                    <BoxView Grid.Column="0" BackgroundColor="#FFD700" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <Label Grid.Column="1" Text="&#x1F3C6;" FontSize="28" VerticalOptions="Center" Margin="16,16,12,16"/>
                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" Padding="0,16,16,16">
                        <Label Text="NEW PERSONAL RECORD" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark={StaticResource Gray400}}" CharacterSpacing="1"/>
                        <Label x:Name="PrMessageLabel" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>