<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.MuscleGroupProgressView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             x:DataType="vm:MuscleGroupProgressViewModel"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>
        <converters:BoolToTrendConverter x:Key="BoolToTrendConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <Grid ColumnDefinitions="8,*">

                <BoxView Grid.Column="0" BackgroundColor="{Binding MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                <VerticalStackLayout Grid.Column="1" Padding="20,16,24,20" Spacing="24">

                    <Button Text="← Back"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent" TextColor="#1F77F0"
                            FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding MuscleGroup}"
                               FontSize="32" FontAttributes="Bold"
                               TextColor="{Binding MuscleGroupColor}" CharacterSpacing="0.5"/>
                        <Label Text="Strength progress over time"
                               FontSize="14" TextColor="#737373"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="TIME PERIOD" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                        <Border BackgroundColor="#F4F5F7" StrokeThickness="0" Padding="2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimePeriodPillViewModel">
                                        <Border StrokeThickness="0" Padding="0" FlexLayout.Grow="1" Margin="2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                                    <Setter Property="Shadow">
                                                        <Setter.Value>
                                                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer x:DataType="{x:Null}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MuscleGroupProgressViewModel}}, Path=SetTimePeriodCommand}"
                                                    CommandParameter="{Binding DaysString}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#1A1A1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="#A3A3A3"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="#F0F7FF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4">
                            <Label Text="📊" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalSets}" FontSize="20" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                            <Label Text="Sets" FontSize="11" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#E8F5E9" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4">
                            <Label Text="💪" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalReps}" FontSize="20" FontAttributes="Bold" TextColor="#388E3C" HorizontalOptions="Center"/>
                            <Label Text="Reps" FontSize="11" FontAttributes="Bold" TextColor="#388E3C" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="#FFF4E5" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="12,16" Spacing="4">
                            <Label Text="🏆" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding MaxWeight, StringFormat='{0:F0}'}" FontSize="20" FontAttributes="Bold" TextColor="#F57C00" HorizontalOptions="Center"/>
                            <Label Text="{Binding WeightUnitLabel, StringFormat='Max {0}'}" FontSize="11" FontAttributes="Bold" TextColor="#F57C00" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
                        <Label Text="TOP EXERCISE PROGRESS" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                        <Label Grid.Column="1" Text="{Binding TopExerciseName}" FontSize="12" FontAttributes="Bold" TextColor="#1F77F0"/>
                    </Grid>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20" Spacing="16">
                            <microcharts:ChartView Chart="{Binding CombinedChart}" HeightRequest="220"/>

                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding Exercises}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ExerciseProgress">
                                        <HorizontalStackLayout Spacing="6" Margin="0,4,16,8">
                                            <Border BackgroundColor="{Binding ChartColor}" WidthRequest="12" HeightRequest="12" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                            </Border>
                                            <Label Text="{Binding ExerciseName}" FontSize="12" FontAttributes="Bold" TextColor="#737373" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <BoxView HeightRequest="1" Color="#F4F5F7" Margin="0,8,0,0"/>
                            <Label Text="Chart visualizes max weight for top performing movements." FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasVolumeData}">
                    <Label Text="VOLUME DISTRIBUTION" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20" Spacing="24">

                            <Grid HeightRequest="220">
                                <microcharts:ChartView Chart="{Binding VolumeChart}" HeightRequest="220"/>
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                    <Label Text="{Binding TotalSets}" FontSize="36" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                                    <Label Text="Total Sets" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F4F5F7"/>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding VolumeDistribution}" Spacing="16">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VolumeDistributionItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">

                                            <BoxView Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" 
                                                     Color="{Binding ColorHex}" WidthRequest="10" HeightRequest="10" 
                                                     CornerRadius="5" VerticalOptions="Center"/>

                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="End"/>

                                            <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="4" VerticalOptions="End" HorizontalOptions="End">
                                                <Label Text="{Binding Sets, StringFormat='{0} sets'}" FontSize="13" FontAttributes="Bold" TextColor="#737373"/>
                                                <Label Text="•" FontSize="13" TextColor="#D1D1D1"/>
                                                <Label Text="{Binding DisplayPercentage}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                            </HorizontalStackLayout>

                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                                                         Progress="{Binding Percentage}" 
                                                         ProgressColor="{Binding ColorHex}" 
                                                         ScaleY="2" 
                                                         VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10">
                    <Label Text="EXERCISES" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <CollectionView ItemsSource="{Binding Exercises}" SelectionMode="None">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,40" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="📊" FontSize="56" HorizontalOptions="Center"/>
                                <Label Text="No data for this period" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
                                <Label Text="Try selecting a longer time period to view your progress." FontSize="14" TextColor="#A3A3A3" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                <Button Text="View All Time"
                                        Command="{Binding SetTimePeriodCommand}"
                                        CommandParameter="0"
                                        BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                                        FontAttributes="Bold" FontSize="15"
                                        Padding="24,14" CornerRadius="12" BorderWidth="0"
                                        HorizontalOptions="Center" Margin="0,12,0,0">
                                    <Button.Shadow>
                                        <Shadow Brush="#1F77F0" Offset="0,4" Radius="10" Opacity="0.2"/>
                                    </Button.Shadow>
                                </Button>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseProgress">
                                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer x:DataType="{x:Null}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MuscleGroupProgressViewModel}}, Path=SelectExerciseCommand}" 
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="6,Auto,*,Auto,Auto" ColumnSpacing="0">
                                        <BoxView Grid.Column="0" BackgroundColor="{Binding ChartColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                                        <Label Grid.Column="1" Text="{Binding IsTrending, Converter={StaticResource BoolToTrendConverter}}" FontSize="20" VerticalOptions="Center" Margin="16,0,12,0"/>

                                        <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" Padding="0,16,12,16">
                                            <Label Text="{Binding ExerciseName}" FontSize="15" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                            <Label Text="{Binding TotalReps, StringFormat='{0} total reps'}" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="3" Spacing="0" HorizontalOptions="End" VerticalOptions="Center" Padding="0,16,8,16">
                                            <Label Text="MAX" FontSize="10" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="End" CharacterSpacing="0.5"/>
                                            <Label Text="{Binding LatestMaxWeight, StringFormat='{0:F0}'}" FontSize="18" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="End"/>
                                            <Label x:DataType="{x:Null}"
                                                   Text="{Binding Source={RelativeSource AncestorType={x:Type vm:MuscleGroupProgressViewModel}}, Path=WeightUnitLabel}" 
                                                   FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="End"/>
                                            <Label Text="{Binding ImprovementLabel}" FontSize="11" FontAttributes="Bold" TextColor="{Binding ImprovementColor}" HorizontalOptions="End" IsVisible="{Binding HasImprovement}" Margin="0,2,0,0"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="4" Text="›" FontSize="24" TextColor="#D1D1D1" VerticalOptions="Center" Padding="8,0,16,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>