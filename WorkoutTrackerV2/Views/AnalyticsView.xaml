<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.AnalyticsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:controls="clr-namespace:WorkoutTrackerV2.Controls"
             x:DataType="vm:AnalyticsViewModel"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <!--
            FIX 8: DaysToColorConverter and DaysToTextColorConverter removed.
            Time period pills now use DataTriggers on IsSelected — zero converter
            invocations per tap instead of 2 × 6 = 12.
            BoolToTrendConverter and IsNotEmptyConverter retained — no alternative.
        -->
        <converters:BoolToTrendConverter x:Key="BoolToTrendConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackLayout Grid.Row="0" BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Label Text="📊 Analytics"
                   FontSize="32" FontAttributes="Bold"
                   TextColor="#1F77F0" CharacterSpacing="0.5"/>
            <Label Text="Track your progress over time"
                   FontSize="13" TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="24">

                <!-- ── Time Period Pills ──────────────────────────────────────
                     FIX 8: BindableLayout over TimePeriodPills replaces 6 hard-coded
                     Border elements each running 2 converters. DataTriggers on
                     IsSelected handle colour with zero converter overhead.
                     FIX: CommandParameter changed from string to int — SetTimePeriod
                     now accepts int directly so no TryParse needed in the ViewModel. -->
                <StackLayout Spacing="10">
                    <Label Text="TIME PERIOD"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <!-- BindableLayout requires a Layout panel as host — FlexLayout
                         distributes pills horizontally with equal spacing.           -->
                    <FlexLayout Direction="Row"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimePeriodPillViewModel">
                                <Border StrokeThickness="0" Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#EEEEEE"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AnalyticsViewModel}}, Path=SetTimePeriodCommand}"
                                            CommandParameter="{Binding DaysString}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Label}"
                                           FontSize="11" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           Padding="14,8">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="#666666"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>

                <!-- ── Summary Stats ─────────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Label Text="OVERVIEW"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12">
                        <StackLayout Grid.Row="0" Grid.Column="0" BackgroundColor="#1F77F0" Padding="16,16,16,12" Spacing="4">
                            <Label Text="VOLUME" FontSize="10" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                            <Label Text="{Binding TotalVolumeLifted, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                            <Label Text="{Binding WeightUnitLabel, StringFormat='total {0} lifted'}" FontSize="10" TextColor="#FFFFFF" Opacity="0.8"/>
                            <controls:SparklineView Data="{Binding VolumeSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#1F77F0" HeightRequest="44" Margin="0,4,0,0"/>
                        </StackLayout>
                        <StackLayout Grid.Row="0" Grid.Column="1" BackgroundColor="#4CAF50" Padding="16,16,16,12" Spacing="4">
                            <Label Text="AVG VOLUME" FontSize="10" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                            <Label Text="{Binding AverageVolume, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                            <Label Text="per workout" FontSize="10" TextColor="#FFFFFF" Opacity="0.8"/>
                            <controls:SparklineView Data="{Binding AvgVolumeSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#4CAF50" HeightRequest="44" Margin="0,4,0,0"/>
                        </StackLayout>
                        <StackLayout Grid.Row="1" Grid.Column="0" BackgroundColor="#FF9800" Padding="16,16,16,12" Spacing="4">
                            <Label Text="SETS" FontSize="10" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                            <Label Text="{Binding TotalSets}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                            <Label Text="completed" FontSize="10" TextColor="#FFFFFF" Opacity="0.8"/>
                            <controls:SparklineView Data="{Binding SetsSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#FF9800" HeightRequest="44" Margin="0,4,0,0"/>
                        </StackLayout>
                        <StackLayout Grid.Row="1" Grid.Column="1" BackgroundColor="#FF6B6B" Padding="16,16,16,12" Spacing="4">
                            <Label Text="DAYS" FontSize="10" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                            <Label Text="{Binding DailyStats.Count}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                            <Label Text="worked out" FontSize="10" TextColor="#FFFFFF" Opacity="0.8"/>
                            <controls:SparklineView Data="{Binding DaysSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#FF6B6B" HeightRequest="44" Margin="0,4,0,0"/>
                        </StackLayout>
                    </Grid>
                </StackLayout>

                <!-- ── Best Week ──────────────────────────────────────────────── -->
                <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="6">
                    <Label Text="BEST WEEK"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <Label Text="{Binding BestWeekLabel}"
                           FontSize="14" FontAttributes="Bold" TextColor="#1F77F0"/>
                    <StackLayout Orientation="Horizontal" Spacing="4">
                        <Label Text="{Binding BestWeekVolume, StringFormat='{0:F0}'}"
                               FontSize="12" TextColor="#999999"/>
                        <Label Text="{Binding WeightUnitLabel, StringFormat='total {0} volume'}"
                               FontSize="12" TextColor="#999999"/>
                    </StackLayout>
                    <Label Text="{Binding BestWeekMuscleGroups}"
                           FontSize="11" TextColor="#999999"
                           IsVisible="{Binding BestWeekMuscleGroups, Converter={StaticResource IsNotEmptyConverter}}"/>
                </StackLayout>

                <!-- ── Workout Heatmap ────────────────────────────────────────── -->
                <StackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                Text="←" Command="{Binding PreviousMonthCommand}"
                                BackgroundColor="Transparent" TextColor="#1F77F0"
                                FontSize="18" Padding="12,8" BorderWidth="0" MinimumWidthRequest="44"/>
                        <Label Grid.Column="1"
                               Text="{Binding HeatmapTitle}"
                               FontSize="12" FontAttributes="Bold" TextColor="#1F77F0"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Button Grid.Column="2"
                                Text="→" Command="{Binding NextMonthCommand}"
                                BackgroundColor="Transparent" TextColor="#1F77F0"
                                FontSize="18" Padding="12,8" BorderWidth="0" MinimumWidthRequest="44"/>
                    </Grid>
                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">
                        <controls:WorkoutHeatmapView
                            HeatmapData="{Binding HeatmapData}"
                            Month="{Binding HeatmapMonth}"
                            HeightRequest="240"/>
                        <StackLayout Orientation="Horizontal" HorizontalOptions="End" Spacing="6">
                            <Label Text="Less" FontSize="10" TextColor="#999999" VerticalOptions="Center"/>
                            <BoxView Color="#F0F0F0" WidthRequest="14" HeightRequest="14" CornerRadius="3"/>
                            <BoxView Color="#C8E6FF" WidthRequest="14" HeightRequest="14" CornerRadius="3"/>
                            <BoxView Color="#7EC0F8" WidthRequest="14" HeightRequest="14" CornerRadius="3"/>
                            <BoxView Color="#4499F4" WidthRequest="14" HeightRequest="14" CornerRadius="3"/>
                            <BoxView Color="#1F77F0" WidthRequest="14" HeightRequest="14" CornerRadius="3"/>
                            <Label Text="More" FontSize="10" TextColor="#999999" VerticalOptions="Center"/>
                        </StackLayout>
                    </StackLayout>
                </StackLayout>

                <!-- ── Top Exercises ──────────────────────────────────────────────
                     FIX 9: CollectionView replaced with BindableLayout — TopExercises
                     is always at most 5 items; CollectionView virtualization overhead
                     is wasted on a fixed micro-list inside a ScrollView.             -->
                <StackLayout Spacing="10">
                    <Label Text="TOP EXERCISES"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>

                    <StackLayout IsVisible="{Binding TopExercises.Count, Converter={StaticResource IsNotEmptyConverter}, ConverterParameter=Inverse}"
                                 Padding="20,40" Spacing="8" HorizontalOptions="Center">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="No exercise data yet" FontSize="13" TextColor="#999999" HorizontalOptions="Center"/>
                    </StackLayout>

                    <StackLayout BindableLayout.ItemsSource="{Binding TopExercises}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseProgress">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                      ColumnSpacing="16"
                                      Padding="16,14"
                                      BackgroundColor="#FFFFFF"
                                      Margin="0,0,0,2">
                                    <Label Grid.Column="0"
                                           Text="{Binding ExerciseName}"
                                           FontSize="13" FontAttributes="Bold" TextColor="#000000"
                                           VerticalOptions="Center"/>
                                    <StackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                        <Label Text="MAX" FontSize="9" TextColor="#999999" HorizontalOptions="Center" CharacterSpacing="0.5"/>
                                        <StackLayout Orientation="Horizontal" Spacing="4" HorizontalOptions="Center">
                                            <Label Text="{Binding MaxWeight, StringFormat='{0:F0}'}"
                                                   FontSize="13" FontAttributes="Bold" TextColor="#4CAF50" VerticalOptions="Center"/>
                                            <Label Text="{Binding IsTrending, Converter={StaticResource BoolToTrendConverter}}"
                                                   FontSize="10" VerticalOptions="Center"/>
                                        </StackLayout>
                                    </StackLayout>
                                    <StackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                        <Label Text="AVG" FontSize="9" TextColor="#999999" HorizontalOptions="Center" CharacterSpacing="0.5"/>
                                        <Label Text="{Binding AverageWeight, StringFormat='{0:F0}'}"
                                               FontSize="13" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center"/>
                                    </StackLayout>
                                    <StackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                                        <Label Text="REPS" FontSize="9" TextColor="#999999" HorizontalOptions="Center" CharacterSpacing="0.5"/>
                                        <Label Text="{Binding TotalReps}"
                                               FontSize="13" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>

                <!-- ── Strength Progress ──────────────────────────────────────────
                     FIX 9: CollectionView replaced with BindableLayout — same
                     reasoning as TopExercises above.                               -->
                <StackLayout Spacing="10">
                    <Label Text="STRENGTH PROGRESS"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>

                    <StackLayout IsVisible="{Binding MuscleGroupProgress.Count, Converter={StaticResource IsNotEmptyConverter}, ConverterParameter=Inverse}"
                                 Padding="20,40" Spacing="8" HorizontalOptions="Center">
                        <Label Text="📈" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="No progress data yet" FontSize="13" TextColor="#999999" HorizontalOptions="Center"/>
                    </StackLayout>

                    <StackLayout BindableLayout.ItemsSource="{Binding MuscleGroupProgress}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MuscleGroupProgress">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12"
                                      Padding="16,14"
                                      BackgroundColor="#FFFFFF"
                                      Margin="0,0,0,2">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AnalyticsViewModel}}, Path=SelectMuscleGroupProgressCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0"
                                           Text="{Binding IsTrending, Converter={StaticResource BoolToTrendConverter}}"
                                           FontSize="20" VerticalOptions="Center"/>
                                    <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding MuscleGroup}"
                                               FontSize="14" FontAttributes="Bold" TextColor="#000000"/>
                                        <StackLayout Orientation="Horizontal" Spacing="4">
                                            <Label FontSize="11" TextColor="#999999">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} exercises · Max {1:F0}">
                                                        <Binding Path="Exercises.Count"/>
                                                        <Binding Path="LatestMaxWeight"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:AnalyticsViewModel}}, Path=WeightUnitLabel}"
                                                   FontSize="11" TextColor="#999999"/>
                                        </StackLayout>
                                    </StackLayout>
                                    <Label Grid.Column="2"
                                           Text="→" FontSize="18" TextColor="#1F77F0" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </StackLayout>

                <!-- ── Personal Records ───────────────────────────────────────── -->
                <StackLayout BackgroundColor="#FFF8E1" Padding="16" Spacing="0">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewPersonalRecordsCommand}"/>
                    </StackLayout.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🏆" FontSize="24"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Personal Records" FontSize="15" FontAttributes="Bold" TextColor="#FF9800"/>
                            <Label Text="View your all time best lifts" FontSize="11" TextColor="#999999"/>
                        </StackLayout>
                        <Label Grid.Column="2" Text="→" FontSize="18" TextColor="#FF9800" VerticalOptions="Center"/>
                    </Grid>
                </StackLayout>

                <!-- ── Insights ────────────────────────────────────────────────── -->
                <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="8">
                    <Label Text="INSIGHT"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#999999" CharacterSpacing="1"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="{Binding InsightEmoji}"
                               FontSize="32" VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{Binding InsightMessage}"
                               FontSize="13" TextColor="#000000"
                               LineBreakMode="WordWrap" VerticalOptions="Center"/>
                    </Grid>
                </StackLayout>

                <Label Text=" " Margin="0,20"/>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
