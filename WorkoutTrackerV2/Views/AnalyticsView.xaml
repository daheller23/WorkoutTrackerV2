<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.AnalyticsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:controls="clr-namespace:WorkoutTrackerV2.Controls"
             x:DataType="vm:AnalyticsViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#1F1F1F}">

    <ContentPage.Resources>
        <converters:BoolToTrendConverter x:Key="BoolToTrendConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.15" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="24">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Analytics"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" CharacterSpacing="0.5"/>
                    <Label Text="Track your progress over time" FontSize="14" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="TIME PERIOD" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" Padding="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" BindableLayout.ItemsSource="{Binding TimePeriodPills}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimePeriodPillViewModel">

                                    <Grid FlexLayout.Grow="1" Margin="2">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AnalyticsViewModel}}, Path=SetTimePeriodCommand}" CommandParameter="{Binding DaysString}"/>
                                        </Grid.GestureRecognizers>

                                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="0" Padding="0" IsVisible="{Binding IsSelected}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                                            </Border.Shadow>
                                            <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                        </Border>

                                        <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="0" IsVisible="{Binding IsSelected, Converter={StaticResource InverseBoolConverter}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}"/>
                                        </Border>
                                    </Grid>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <VerticalStackLayout Spacing="10">
                    <Label Text="OVERVIEW" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#1F77F0" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="16,16,16,12" Spacing="2">
                                <Label Text="VOLUME" FontSize="11" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                                <Label Text="{Binding TotalVolumeLifted, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label Text="{Binding WeightUnitLabel, StringFormat='total {0} lifted'}" FontSize="11" TextColor="#FFFFFF" Opacity="0.8"/>
                                <controls:SparklineView Data="{Binding VolumeSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#1F77F0" HeightRequest="44" Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#388E3C" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="16,16,16,12" Spacing="2">
                                <Label Text="AVG VOLUME" FontSize="11" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                                <Label Text="{Binding AverageVolume, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label Text="per workout" FontSize="11" TextColor="#FFFFFF" Opacity="0.8"/>
                                <controls:SparklineView Data="{Binding AvgVolumeSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#388E3C" HeightRequest="44" Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F57C00" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="16,16,16,12" Spacing="2">
                                <Label Text="SETS" FontSize="11" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                                <Label Text="{Binding TotalSets}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label Text="completed" FontSize="11" TextColor="#FFFFFF" Opacity="0.8"/>
                                <controls:SparklineView Data="{Binding SetsSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#F57C00" HeightRequest="44" Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#E53935" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Padding="16,16,16,12" Spacing="2">
                                <Label Text="DAYS" FontSize="11" TextColor="#FFFFFF" FontAttributes="Bold" CharacterSpacing="1" Opacity="0.8"/>
                                <Label Text="{Binding DailyStats.Count}" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                <Label Text="worked out" FontSize="11" TextColor="#FFFFFF" Opacity="0.8"/>
                                <controls:SparklineView Data="{Binding DaysSparkline}" LineColor="#FFFFFF" BackgroundColorHex="#E53935" HeightRequest="44" Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" Padding="16" ColumnSpacing="16">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#0F243B}" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="⭐" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="BEST WEEK" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                            <Label Text="{Binding BestWeekLabel}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"/>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding BestWeekVolume, StringFormat='{0:F0}'}" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}" FontAttributes="Bold"/>
                                <Label Text="{Binding WeightUnitLabel, StringFormat='total {0} volume'}" FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding BestWeekMuscleGroups}" FontSize="12" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" IsVisible="{Binding BestWeekMuscleGroups, Converter={StaticResource IsNotEmptyConverter}}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" Padding="16" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="{Binding InsightEmoji}" FontSize="36" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="INSIGHT" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1"/>
                            <Label Text="{Binding InsightMessage}" FontSize="14" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="TOP EXERCISES" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopExercises}" Spacing="0">

                            <BindableLayout.EmptyView>
                                <VerticalStackLayout Padding="20,40" Spacing="12" HorizontalOptions="Center">
                                    <Label Text="📊" FontSize="48" HorizontalOptions="Center"/>
                                    <Label Text="No exercise data yet" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" HorizontalOptions="Center"/>
                                    <Label Text="Log more sets to see your top movements" FontSize="13" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </BindableLayout.EmptyView>

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ExerciseProgress">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" Padding="16">
                                            <Label Grid.Column="0" Text="{Binding ExerciseName}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" VerticalOptions="Center"/>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                                <Label Text="MAX" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                                    <Label Text="{Binding MaxWeight, StringFormat='{0:F0}'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#388E3C, Dark=#81C784}" VerticalOptions="Center"/>
                                                    <Label Text="{Binding IsTrending, Converter={StaticResource BoolToTrendConverter}}" FontSize="12" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                                <Label Text="AVG" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                <Label Text="{Binding AverageWeight, StringFormat='{0:F0}'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" WidthRequest="40">
                                                <Label Text="REPS" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                                <Label Text="{Binding TotalReps}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}" Margin="16,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="STRENGTH PROGRESS" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                        </Border.Shadow>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MuscleGroupProgress}" Spacing="0">

                            <BindableLayout.EmptyView>
                                <VerticalStackLayout Padding="20,40" Spacing="12" HorizontalOptions="Center">
                                    <Label Text="📈" FontSize="48" HorizontalOptions="Center"/>
                                    <Label Text="No progress data yet" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" HorizontalOptions="Center"/>
                                    <Label Text="Complete workouts to track strength trends" FontSize="13" TextColor="{AppThemeBinding Light=#A3A3A3, Dark=#999999}" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </BindableLayout.EmptyView>

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MuscleGroupProgress">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Padding="16">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AnalyticsViewModel}}, Path=SelectMuscleGroupProgressCommand}" CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>

                                            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F4F5F7, Dark=#121212}" StrokeThickness="0" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding IsTrending, Converter={StaticResource BoolToTrendConverter}}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding MuscleGroup}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                                <Label FontSize="13" TextColor="{AppThemeBinding Light=#737373, Dark=#CCCCCC}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} exercises · Max {1:F0} {2}">
                                                            <Binding Path="Exercises.Count"/>
                                                            <Binding Path="LatestMaxWeight"/>
                                                            <Binding Source="{RelativeSource AncestorType={x:Type vm:AnalyticsViewModel}}" Path="WeightUnitLabel"/>
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#D1D1D1, Dark=#666666}" VerticalOptions="Center"/>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F4F5F7, Dark=#333333}" Margin="16,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#332400}" StrokeThickness="0" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.15" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewPersonalRecordsCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#4A3400}" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" Margin="0,0,16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="🏆" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Personal Records" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"/>
                            <Label Text="View your all time best lifts" FontSize="13" TextColor="{AppThemeBinding Light=#D98A0D, Dark=#FFA726}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{AppThemeBinding Light=#FFB74D, Dark=#FFB74D}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>