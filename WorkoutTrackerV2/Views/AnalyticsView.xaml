<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.AnalyticsView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             Title="Analytics"
             BackgroundColor="#FAFAFA">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout Grid.Row="0" Padding="24,16,24,24" Spacing="4">
            <Label Text="Analytics" 
                   FontSize="32" 
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.5"/>
            <Label Text="Track your progress over time"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="24">

                <!-- Time Period Selection -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Time Period"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <Picker SelectedItem="{Binding SelectedDays}"
                            BackgroundColor="#F5F5F5"
                            TextColor="#000000">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>7</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>30</x:Int32>
                                <x:Int32>60</x:Int32>
                                <x:Int32>90</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </StackLayout>

                <!-- Summary Stats Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">

                    <!-- Total Volume Lifted -->
                    <StackLayout Grid.Row="0" Grid.Column="0" 
                                 Padding="20,24" 
                                 BackgroundColor="#FFFFFF"
                                 Spacing="12">
                        <Label Text="Total Volume"
                               FontSize="12"
                               TextColor="#999999"
                               FontAttributes="Bold"
                               CharacterSpacing="0.3"/>
                        <Label Text="{Binding TotalVolumeLifted, StringFormat='{0:F0}'}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"/>
                        <BoxView HeightRequest="2" WidthRequest="40" Color="#1F77F0" HorizontalOptions="Start"/>
                    </StackLayout>

                    <!-- Average Volume -->
                    <StackLayout Grid.Row="0" Grid.Column="1" 
                                 Padding="20,24" 
                                 BackgroundColor="#FFFFFF"
                                 Spacing="12">
                        <Label Text="Daily Average"
                               FontSize="12"
                               TextColor="#999999"
                               FontAttributes="Bold"
                               CharacterSpacing="0.3"/>
                        <Label Text="{Binding AverageVolume, StringFormat='{0:F0}'}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"/>
                        <Label Text="per workout"
                               FontSize="11"
                               TextColor="#999999"/>
                    </StackLayout>

                    <!-- Total Sets -->
                    <StackLayout Grid.Row="1" Grid.Column="0" 
                                 Padding="20,24" 
                                 BackgroundColor="#FFFFFF"
                                 Spacing="12">
                        <Label Text="Total Sets"
                               FontSize="12"
                               TextColor="#999999"
                               FontAttributes="Bold"
                               CharacterSpacing="0.3"/>
                        <Label Text="{Binding TotalSets}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="#FF9800"/>
                        <Label Text="completed"
                               FontSize="11"
                               TextColor="#999999"/>
                    </StackLayout>

                    <!-- Workout Days -->
                    <StackLayout Grid.Row="1" Grid.Column="1" 
                                 Padding="20,24" 
                                 BackgroundColor="#FFFFFF"
                                 Spacing="12">
                        <Label Text="Workout Days"
                               FontSize="12"
                               TextColor="#999999"
                               FontAttributes="Bold"
                               CharacterSpacing="0.3"/>
                        <Label Text="{Binding DailyStats.Count}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="#FF6B6B"/>
                        <Label Text="in period"
                               FontSize="11"
                               TextColor="#999999"/>
                    </StackLayout>

                </Grid>

                <!-- Top Exercises -->
                <StackLayout Spacing="16">
                    <!-- Section Header -->
                    <Label Text="Top Exercises"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#000000"
                           CharacterSpacing="0.3"/>

                    <CollectionView ItemsSource="{Binding TopExercises}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <StackLayout Padding="40,60" Spacing="12" HorizontalOptions="Center">
                                <Label Text="📊"
                                       FontSize="48"
                                       HorizontalOptions="Center"/>
                                <Label Text="No exercise data yet"
                                       FontSize="14"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="16"
                                             Margin="0,0,0,12"
                                             BackgroundColor="#FFFFFF"
                                             Spacing="12">
                                    <!-- Exercise Name -->
                                    <Label Text="{Binding ExerciseName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1F77F0"/>

                                    <!-- Stats Row -->
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="0">
                                        <!-- Max Weight -->
                                        <StackLayout Spacing="4" HorizontalOptions="Center">
                                            <Label Text="Max"
                                                   FontSize="10"
                                                   TextColor="#999999"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding MaxWeight, StringFormat='{0:F1}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#4CAF50"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Average Weight -->
                                        <StackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                                            <Label Text="Avg"
                                                   FontSize="10"
                                                   TextColor="#999999"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding AverageWeight, StringFormat='{0:F1}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#FF9800"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Total Reps -->
                                        <StackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                                            <Label Text="Reps"
                                                   FontSize="10"
                                                   TextColor="#999999"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding TotalReps}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F77F0"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                    </Grid>

                                    <!-- Divider -->
                                    <BoxView HeightRequest="1" Color="#F0F0F0"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Muscle Groups Filter -->
                <StackLayout Spacing="12" BackgroundColor="#FFFFFF" Padding="16">
                    <Label Text="Filter by Muscle Group"
                           FontSize="12"
                           TextColor="#999999"
                           FontAttributes="Bold"
                           CharacterSpacing="0.3"/>
                    <Picker ItemsSource="{Binding MuscleGroups}"
                            SelectedItem="{Binding SelectedMuscleGroup}"
                            BackgroundColor="#F5F5F5"
                            TextColor="#000000"
                            Title="Select muscle group"/>
                </StackLayout>

                <!-- Insights Card -->
                <StackLayout Padding="20,24" 
                             BackgroundColor="#F0F7FF"
                             Spacing="12">
                    <Label Text="💡 Insights"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#1F77F0"/>
                    <Label Text="Your consistency matters more than perfection. Every workout builds your strength and habits."
                           FontSize="12"
                           TextColor="#999999"
                           LineBreakMode="WordWrap"/>
                    <Label Text="Keep pushing! 💪"
                           FontSize="12"
                           TextColor="#4CAF50"
                           FontAttributes="Bold"/>
                </StackLayout>

                <Label Text=" " Margin="0,20"/>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>