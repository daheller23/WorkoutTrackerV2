<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.CreateExerciseView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:CreateExerciseViewModel"
             BackgroundColor="#F4F5F7">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">

                <Button Text="← Back"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent" TextColor="#1F77F0"
                        FontSize="15" FontAttributes="Bold" Padding="0" HorizontalOptions="Start" HeightRequest="30"/>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Create Exercise"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.3"/>
                    <Label Text="Add a custom exercise to your library"
                           FontSize="14" TextColor="#737373"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="16,16,16,20" Spacing="8">
                        <Label Text="EXERCISE NAME" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>

                        <Border BackgroundColor="#F4F5F7" StrokeThickness="0" HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding ExerciseName}"
                                   Placeholder="e.g. Incline Dumbbell Press"
                                   PlaceholderColor="#B0B0B0"
                                   TextColor="#1A1A1A"
                                   BackgroundColor="Transparent"
                                   FontSize="15" FontAttributes="Bold"
                                   Margin="12,0"/>
                        </Border>

                        <Label Text="{Binding NameError}"
                               FontSize="12" FontAttributes="Bold" TextColor="#FF6B6B"
                               IsVisible="{Binding HasNameError}" Margin="4,0,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="16,16,16,6" Spacing="16">
                        <Label Text="MUSCLE GROUP" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>

                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Stretch" BindableLayout.ItemsSource="{Binding MuscleGroupPills}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MuscleGroupPillViewModel">
                                    <Border StrokeThickness="0" Padding="0" Margin="0,0,0,10" WidthRequest="100" HeightRequest="44">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#1F77F0"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#F4F5F7"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreateExerciseViewModel}}, Path=SelectMuscleGroupCommand}" CommandParameter="{Binding Key}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="#FFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="#737373"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Label Text="{Binding MuscleGroupError}"
                               FontSize="12" FontAttributes="Bold" TextColor="#FF6B6B"
                               IsVisible="{Binding HasMuscleGroupError}" Margin="4,0,0,10"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" IsVisible="{Binding SubMuscleGroups.Count}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="16,16,16,20" Spacing="8">
                        <Label Text="SPECIFIC REGION" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>

                        <Border BackgroundColor="#F4F5F7" StrokeThickness="0" HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Picker ItemsSource="{Binding SubMuscleGroups}"
                                    SelectedItem="{Binding SelectedSubMuscleGroup}"
                                    Title="Select a specific region..."
                                    TitleColor="#B0B0B0"
                                    TextColor="#1A1A1A"
                                    BackgroundColor="Transparent"
                                    FontSize="15" FontAttributes="Bold"
                                    Margin="12,0" VerticalOptions="Center"/>
                        </Border>

                        <Label Text="Helps accurately track your volume distribution." FontSize="11" TextColor="#A3A3A3" Margin="4,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasValidInput}">
                    <Label Text="PREVIEW" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" Margin="4,0,0,0"/>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="6,*" ColumnSpacing="0">

                            <BoxView Grid.Column="0" BackgroundColor="{Binding PreviewMuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>

                            <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="4">
                                <Label Text="{Binding ExerciseName}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding PreviewMuscleGroupEmoji}" FontSize="13" VerticalOptions="Center"/>
                                    <Label Text="{Binding SelectedMuscleGroup}" FontSize="13" FontAttributes="Bold" TextColor="{Binding PreviewMuscleGroupColor}" VerticalOptions="Center"/>

                                    <Label Text="•" FontSize="13" TextColor="#D1D1D1" VerticalOptions="Center"/>
                                    <Label Text="{Binding SelectedSubMuscleGroup}" FontSize="13" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="💾 Save Exercise"
                        Command="{Binding SaveExerciseCommand}"
                        BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                        FontAttributes="Bold" FontSize="15"
                        Padding="0,16" CornerRadius="12" BorderWidth="0"
                        Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#1F77F0" Offset="0,4" Radius="10" Opacity="0.25"/>
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>