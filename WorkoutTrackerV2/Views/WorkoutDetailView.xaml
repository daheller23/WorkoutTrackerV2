<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutDetailView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:WorkoutDetailViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             BackgroundColor="#FAFAFA">

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1F77F0"
                        FontSize="14"
                        Padding="0"/>
                <Button Grid.Column="2"
                        Text="✏️ Edit"
                        Command="{Binding EditWorkoutCommand}"
                        BackgroundColor="#1F77F0"
                        TextColor="#FFFFFF"
                        FontSize="12"
                        FontAttributes="Bold"
                        Padding="14,8"
                        CornerRadius="20"
                        BorderWidth="0"/>
            </Grid>
            <Label Text="{Binding Session.DayName}"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1F77F0"
                   CharacterSpacing="0.3"/>
            <Label Text="{Binding Session.Date, StringFormat='{0:MMMM d, yyyy}'}"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- Stats Row -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackLayout BackgroundColor="#F0F7FF" Padding="16,20" Spacing="6">
                        <Label Text="⏱" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}"
                               FontSize="22" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                        <Label Text="duration" FontSize="10" TextColor="#1F77F0" HorizontalOptions="Center" CharacterSpacing="0.3"/>
                    </StackLayout>
                    <StackLayout Grid.Column="1" BackgroundColor="#FFF8E1" Padding="16,20" Spacing="6">
                        <Label Text="🏋️" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding Session.TotalExercises}"
                               FontSize="22" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center"/>
                        <Label Text="exercises" FontSize="10" TextColor="#FF9800" HorizontalOptions="Center" CharacterSpacing="0.3"/>
                    </StackLayout>
                    <StackLayout Grid.Column="2" BackgroundColor="#F1F8F1" Padding="16,20" Spacing="6">
                        <Label Text="💪" FontSize="20" HorizontalOptions="Center"/>
                        <Label Text="{Binding ExerciseGroups.Count}"
                               FontSize="22" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center"/>
                        <Label Text="exercises" FontSize="10" TextColor="#4CAF50" HorizontalOptions="Center" CharacterSpacing="0.3"/>
                    </StackLayout>
                </Grid>

                <!-- Notes -->
                <StackLayout BackgroundColor="#FFFFFF" Padding="20,16" Spacing="8">
                    <Label Text="📝  NOTES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>
                    <Label Text="{Binding Session.Notes}"
                           FontSize="14"
                           TextColor="#000000"
                           LineBreakMode="WordWrap"/>
                </StackLayout>

                <!-- Exercise Groups -->
                <StackLayout Spacing="12">
                    <Label Text="📋  EXERCISES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>

                    <CollectionView ItemsSource="{Binding ExerciseGroups}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No exercises found"
                                   FontSize="12"
                                   TextColor="#D0D0D0"
                                   HorizontalOptions="Center"
                                   Margin="20,40"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseGroup">
                                <StackLayout Margin="0,0,0,12">
                                    <StackLayout BackgroundColor="#FFFFFF" Padding="16" Spacing="12">

                                        <!-- Exercise Header -->
                                        <StackLayout Spacing="2">
                                            <Label Text="{Binding Exercise.Name}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#000000"/>
                                            <Label Text="{Binding Exercise.MuscleGroup}"
                                                   FontSize="11"
                                                   TextColor="#999999"/>
                                        </StackLayout>

                                        <BoxView HeightRequest="0.5" Color="#F0F0F0"/>

                                        <!-- Table Header -->
                                        <Grid ColumnDefinitions="30,*,*,80" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="Set" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Reps" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="Weight" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="3" Text="Unit" FontSize="11" TextColor="#999999" FontAttributes="Bold" HorizontalOptions="Center"/>
                                        </Grid>

                                        <!-- Sets Rows -->
                                        <StackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:WorkoutSet">
                                                    <Grid ColumnDefinitions="30,*,*,80" ColumnSpacing="8">

                                                        <!-- Set Number -->
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="#F0F7FF"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                VerticalOptions="Center"
                                                                StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding SetNumber}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1F77F0"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Reps -->
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Reps}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#1F77F0"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>

                                                        <!-- Weight -->
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Weight}"
                                                               FontSize="13"
                                                               TextColor="#000000"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>

                                                        <!-- Unit -->
                                                        <Label Grid.Column="3"
                                                               Text="{Binding WeightUnit}"
                                                               FontSize="13"
                                                               TextColor="#999999"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>

                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>

                                    </StackLayout>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <Label Text=" " Margin="0,20"/>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>