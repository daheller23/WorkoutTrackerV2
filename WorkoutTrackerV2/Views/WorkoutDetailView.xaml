<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutDetailView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:WorkoutDetailViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             BackgroundColor="#FAFAFA">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <StackLayout BackgroundColor="#FFFFFF" Padding="24,16,24,24" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="← Back"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1F77F0"
                        FontSize="14"
                        Padding="0"/>
                <Button Grid.Column="2"
                        Text="✏️ Edit"
                        Command="{Binding EditWorkoutCommand}"
                        BackgroundColor="#1F77F0"
                        TextColor="#FFFFFF"
                        FontSize="12"
                        FontAttributes="Bold"
                        Padding="14,8"
                        CornerRadius="20"
                        BorderWidth="0"/>
            </Grid>
            <Label Text="{Binding Session.DayName}"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#000000"
                   CharacterSpacing="0.3"/>
            <Label Text="{Binding Session.Date, StringFormat='{0:MMMM d, yyyy}'}"
                   FontSize="13"
                   TextColor="#999999"/>
        </StackLayout>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="20,24" Spacing="20">

                <!-- Stats Row -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <!-- Duration -->
                    <StackLayout BackgroundColor="#F0F7FF" Padding="16,20" Spacing="6">
                        <Label Text="⏱"
                               FontSize="20"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1F77F0"
                               HorizontalOptions="Center"/>
                        <Label Text="duration"
                               FontSize="10"
                               TextColor="#1F77F0"
                               HorizontalOptions="Center"
                               CharacterSpacing="0.3"/>
                    </StackLayout>

                    <!-- Total Exercises -->
                    <StackLayout Grid.Column="1" BackgroundColor="#FFF8E1" Padding="16,20" Spacing="6">
                        <Label Text="🏋️"
                               FontSize="20"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Session.TotalExercises}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#FF9800"
                               HorizontalOptions="Center"/>
                        <Label Text="exercises"
                               FontSize="10"
                               TextColor="#FF9800"
                               HorizontalOptions="Center"
                               CharacterSpacing="0.3"/>
                    </StackLayout>

                    <!-- Total Sets -->
                    <StackLayout Grid.Column="2" BackgroundColor="#F1F8F1" Padding="16,20" Spacing="6">
                        <Label Text="💪"
                               FontSize="20"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Sets.Count}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"
                               HorizontalOptions="Center"/>
                        <Label Text="sets"
                               FontSize="10"
                               TextColor="#4CAF50"
                               HorizontalOptions="Center"
                               CharacterSpacing="0.3"/>
                    </StackLayout>
                </Grid>

                <!-- Notes -->
                <StackLayout BackgroundColor="#FFFFFF" Padding="20,16" Spacing="8">
                    <Label Text="📝  NOTES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>
                    <Label Text="{Binding Session.Notes}"
                           FontSize="14"
                           TextColor="#000000"
                           LineBreakMode="WordWrap"/>
                </StackLayout>

                <!-- Sets List -->
                <StackLayout Spacing="12">
                    <Label Text="📋  SETS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#999999"
                           CharacterSpacing="1"/>

                    <CollectionView ItemsSource="{Binding Sets}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No sets found"
                                   FontSize="12"
                                   TextColor="#D0D0D0"
                                   HorizontalOptions="Center"
                                   Margin="20,40"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkoutSet">
                                <StackLayout Margin="0,0,0,10" BackgroundColor="#FFFFFF">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,14">

                                        <!-- Set Number Badge -->
                                        <StackLayout Grid.Column="0"
                                                     BackgroundColor="#F0F7FF"
                                                     WidthRequest="36"
                                                     HeightRequest="36"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                            <Label Text="{Binding SetNumber}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F77F0"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Exercise Name + Muscle Group -->
                                        <StackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Exercise.Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#000000"/>
                                            <Label Text="{Binding Exercise.MuscleGroup}"
                                                   FontSize="11"
                                                   TextColor="#999999"/>
                                        </StackLayout>

                                        <!-- Reps + Weight -->
                                        <StackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center" HorizontalOptions="End">
                                            <Label Text="{Binding Reps, StringFormat='{0} reps'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F77F0"
                                                   HorizontalOptions="End"/>
                                            <Label FontSize="11"
                                                   TextColor="#999999"
                                                   HorizontalOptions="End">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Weight"/>
                                                        <Binding Path="WeightUnit"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </StackLayout>

                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#F5F5F5"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <Label Text=" " Margin="0,20"/>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>