<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerV2.Views.WorkoutDetailView"
             xmlns:vm="clr-namespace:WorkoutTrackerV2.ViewModels"
             x:DataType="vm:WorkoutDetailViewModel"
             xmlns:models="clr-namespace:WorkoutTrackerV2.Models"
             xmlns:converters="clr-namespace:WorkoutTrackerV2.Converters"
             BackgroundColor="#F4F5F7">

    <ContentPage.Resources>
        <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
        <converters:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
    </ContentPage.Resources>

    <Shell.NavBarIsVisible>False</Shell.NavBarIsVisible>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" ZIndex="1">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.04" />
            </Border.Shadow>
            <VerticalStackLayout Padding="24,16,24,20" Spacing="20">

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="← Back"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent" TextColor="#1F77F0"
                            FontSize="15" FontAttributes="Bold" Padding="0" VerticalOptions="Center"/>

                    <Button Grid.Column="2" Text="Edit"
                            Command="{Binding EditWorkoutCommand}"
                            BackgroundColor="#F0F7FF" TextColor="#1F77F0"
                            FontSize="13" FontAttributes="Bold"
                            Padding="16,8" CornerRadius="10" BorderWidth="0" VerticalOptions="Center"/>

                    <Button Grid.Column="3" Text="Delete"
                            Command="{Binding DeleteWorkoutCommand}"
                            BackgroundColor="#FFEBEE" TextColor="#E53935"
                            FontSize="13" FontAttributes="Bold"
                            Padding="16,8" CornerRadius="10" BorderWidth="0" VerticalOptions="Center"/>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Session.DayName}"
                           FontSize="32" FontAttributes="Bold"
                           TextColor="#1A1A1A" CharacterSpacing="0.3"/>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding Session.Date, Converter={StaticResource RelativeDateConverter}}"
                               FontSize="14" TextColor="#1F77F0" FontAttributes="Bold"/>
                        <Label Text="•" FontSize="14" TextColor="#C0C0C0"/>
                        <Label Text="{Binding Session.Date, StringFormat='{0:MMMM d, yyyy}'}"
                               FontSize="14" TextColor="#A3A3A3"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,40" Spacing="24">

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="#F0F7FF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="8,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="⏱" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding Session.Duration, StringFormat='{0:hh\\:mm}'}" FontSize="16" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center"/>
                            <Label Text="Duration" FontSize="10" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#FFF4E5" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="8,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="🏋️" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding Session.TotalExercises}" FontSize="16" FontAttributes="Bold" TextColor="#F57C00" HorizontalOptions="Center"/>
                            <Label Text="Exercises" FontSize="10" FontAttributes="Bold" TextColor="#F57C00" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="#E8F5E9" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="8,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="📊" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalSets}" FontSize="16" FontAttributes="Bold" TextColor="#388E3C" HorizontalOptions="Center"/>
                            <Label Text="Sets" FontSize="10" FontAttributes="Bold" TextColor="#388E3C" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" BackgroundColor="#FFEBEE" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Padding="8,16" Spacing="4" HorizontalOptions="Center">
                            <Label Text="🔥" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalReps}" FontSize="16" FontAttributes="Bold" TextColor="#E53935" HorizontalOptions="Center"/>
                            <Label Text="Reps" FontSize="10" FontAttributes="Bold" TextColor="#E53935" HorizontalOptions="Center" Opacity="0.7"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="16">

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" Padding="20,16">
                            <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                <Label Text="TOTAL VOLUME" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                                <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                    <Label Text="{Binding TotalVolume, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                    <Label Text="{Binding WeightUnitLabel}" FontSize="14" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="End" Margin="0,0,0,6"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding VolumeComparison}" FontSize="13" FontAttributes="Bold" TextColor="{Binding VolumeComparisonColor}" IsVisible="{Binding HasVolumeComparison}" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,16" Spacing="12">
                            <Label Text="MUSCLES TRAINED" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding MuscleGroupChips}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MuscleGroupChipViewModel">
                                        <Border StrokeThickness="0" BackgroundColor="{Binding Color}" Padding="10,6" Margin="0,0,8,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Emoji}" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0" IsVisible="{Binding Session.Notes, Converter={StaticResource IsNotEmptyConverter}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Padding="20,16" Spacing="8">
                            <Label Text="NOTES" FontSize="11" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1"/>
                            <Label Text="{Binding Session.Notes}" FontSize="14" TextColor="#1A1A1A" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
                        <Label Grid.Column="0" Text="EXERCISES" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" CharacterSpacing="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="🏆 = Personal Record" FontSize="11" FontAttributes="Bold" TextColor="#C0C0C0" VerticalOptions="Center"/>
                    </Grid>

                    <CollectionView ItemsSource="{Binding ExerciseGroups}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No exercises found" FontSize="14" TextColor="#A3A3A3" HorizontalOptions="Center" Margin="20,40"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExerciseGroup">

                                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.04" />
                                    </Border.Shadow>

                                    <VerticalStackLayout Padding="0,0,0,16" Spacing="12">

                                        <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="16">
                                            <BoxView Grid.Column="0" BackgroundColor="{Binding Exercise.MuscleGroupColor}" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,16,0,0">
                                                <Label Text="{Binding Exercise.Name}" FontSize="16" FontAttributes="Bold" TextColor="#1A1A1A"/>
                                                <Label Text="{Binding Exercise.MuscleGroup}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Exercise.MuscleGroupColor}"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" BackgroundColor="#F0F7FF" StrokeThickness="0" VerticalOptions="Center" Padding="10,6" Margin="0,16,16,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SetCountLabel}" FontSize="12" FontAttributes="Bold" TextColor="#1F77F0"/>
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F4F5F7" Margin="16,4,16,0"/>

                                        <Grid ColumnDefinitions="36,*,Auto,60" ColumnSpacing="12" Margin="16,0">
                                            <Label Grid.Column="0" Text="Set" FontSize="11" TextColor="#A3A3A3" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Reps" FontSize="11" TextColor="#A3A3A3" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="Weight" FontSize="11" TextColor="#A3A3A3" FontAttributes="Bold" HorizontalOptions="Center"/>
                                            <Label Grid.Column="3" Text="Unit" FontSize="11" TextColor="#A3A3A3" FontAttributes="Bold" HorizontalOptions="Center"/>
                                        </Grid>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="6" Margin="16,0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:WorkoutSet">
                                                    <Grid ColumnDefinitions="36,*,Auto,60" ColumnSpacing="12">

                                                        <Border Grid.Column="0" BackgroundColor="#F0F7FF" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding SetNumber}" FontSize="12" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>

                                                        <Label Grid.Column="1" Text="{Binding Reps}" FontSize="14" FontAttributes="Bold" TextColor="#1F77F0" HorizontalOptions="Center" VerticalOptions="Center"/>

                                                        <HorizontalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Label Text="{Binding Weight}" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" VerticalOptions="Center"/>
                                                            <Label Text="🏆" FontSize="12" IsVisible="{Binding IsPR}" VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>

                                                        <Label Grid.Column="3" Text="{Binding WeightUnit}" FontSize="13" FontAttributes="Bold" TextColor="#A3A3A3" HorizontalOptions="Center" VerticalOptions="Center"/>

                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="*,Auto" Margin="16,8,16,0" Padding="0,12,0,0">
                                            <BoxView Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="1" Color="#F4F5F7" VerticalOptions="Start"/>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="16">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="Total Reps:" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                                                    <Label Text="{Binding TotalReps}" FontSize="12" FontAttributes="Bold" TextColor="#1F77F0" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="Max:" FontSize="12" FontAttributes="Bold" TextColor="#A3A3A3" VerticalOptions="Center"/>
                                                    <Label Text="{Binding MaxWeight, StringFormat='{0:F0}'}" FontSize="12" FontAttributes="Bold" TextColor="#388E3C" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Button Text="🔄 Do This Workout Again"
                        Command="{Binding DoWorkoutAgainCommand}"
                        BackgroundColor="#1F77F0" TextColor="#FFFFFF"
                        FontAttributes="Bold" FontSize="15"
                        Padding="0,16" CornerRadius="12" BorderWidth="0" Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#1F77F0" Offset="0,4" Radius="10" Opacity="0.25"/>
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>