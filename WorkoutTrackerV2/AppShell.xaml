<?xml version="1.0" encoding="UTF-8" ?>
<Shell
x:Class="WorkoutTrackerV2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:WorkoutTrackerV2.Views"
    Title="Workout Tracker"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource OffBlack}}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
    Shell.TitleColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource Gray950}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#1F77F0, Dark=#5B9CFF}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#999999, Dark={StaticResource Gray500}}">

    <TabBar>
        <ShellContent
            Title="🏠 Home"
            Route="Home"
            ContentTemplate="{DataTemplate views:HomeView}"/>
        <ShellContent
            Title="🏋️ Workout"
            Route="Workout"
            ContentTemplate="{DataTemplate views:AddWorkoutView}"/>
        <ShellContent
            Title="📋 History"
            Route="History"
            ContentTemplate="{DataTemplate views:WorkoutHistoryView}"/>
        <ShellContent
            Title="📊 Analytics"
            Route="Analytics"
            ContentTemplate="{DataTemplate views:AnalyticsView}"/>
    </TabBar>

</Shell>
