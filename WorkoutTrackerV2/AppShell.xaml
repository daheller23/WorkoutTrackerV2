<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkoutTrackerV2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:WorkoutTrackerV2.Views"
    Title="Workout Tracker"
    Shell.BackgroundColor="#FFFFFF"
    Shell.ForegroundColor="#1F77F0"
    Shell.TitleColor="#1F77F0"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#1F77F0"
    Shell.TabBarTitleColor="#1F77F0"
    Shell.TabBarUnselectedColor="#999999">

    <!--
        ContentTemplate uses DataTemplate for lazy instantiation — each tab page
        is constructed only on first visit, not at app startup. Do not change to
        direct Content= references or all four pages would be built at launch.

        Routes declared here (Home, Workout, History, Analytics) are registered
        by Shell automatically — they must NOT also be registered in AppShell.xaml.cs
        or a duplicate route conflict occurs.
    -->
    <TabBar>
        <ShellContent
            Title="🏠 Home"
            Route="Home"
            ContentTemplate="{DataTemplate views:HomeView}"/>
        <ShellContent
            Title="🏋️ Workout"
            Route="Workout"
            ContentTemplate="{DataTemplate views:AddWorkoutView}"/>
        <ShellContent
            Title="📋 History"
            Route="History"
            ContentTemplate="{DataTemplate views:WorkoutHistoryView}"/>
        <ShellContent
            Title="📊 Analytics"
            Route="Analytics"
            ContentTemplate="{DataTemplate views:AnalyticsView}"/>
    </TabBar>

</Shell>
